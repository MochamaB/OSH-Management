@{
    ViewData["Title"] = "Upload Media";
}

<!-- Page Header -->
<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Upload Media</p>
        <span class="fs-semibold text-muted">Upload new files and documents</span>
    </div>
    <div class="btn-list mt-md-0 mt-2">
        <a href="/Media/Index" class="btn btn-secondary btn-wave">
            <i class="ri-arrow-left-line me-2"></i>Back to Library
        </a>
    </div>
</div>

<!-- Content -->
<div class="row">
    <div class="col-xl-12">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title">
                    Upload Files
                </div>
            </div>
            <div class="card-body">
                <div class="text-center py-5">
                    <i class="ri-upload-cloud-2-line fs-1 text-primary"></i>
                    <h4 class="mt-3">Upload Feature Coming Soon</h4>
                    <p class="text-muted">File upload functionality will be implemented in the next step.</p>
                </div>
            </div>
        </div>
    </div>
</div>
