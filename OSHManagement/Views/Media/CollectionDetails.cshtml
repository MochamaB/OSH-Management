@model OSHManagement.Models.ViewModels.MediaCollectionViewModel
@{
    ViewData["Title"] = $"Collection: {Model.CollectionDisplayName}";
}

<!-- Page Header -->
<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
   <div>
        <p class="fw-semibold fs-18 mb-0"></p>
        <span class="fs-semibold text-muted"></span>
    </div>
    <div class="btn-list mt-md-0 mt-2">
        <a href="/Media/Categories" class="btn btn-secondary btn-wave">
            <i class="ri-arrow-left-line me-2"></i>Back to Categories
        </a>
        <a href="@Url.Action("EditCollection", new { id = Model.CollectionId })" class="btn btn-primary btn-wave">
            <i class="ri-edit-line me-2"></i>Edit Collection
        </a>
    </div>
</div>

<div class="row">
    <!-- Collection Info Card -->
    <div class="col-xl-8">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title">
                    <i class="@Model.ModuleIcon me-2"></i>Collection Information
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <td class="fw-semibold" width="200">Collection Name:</td>
                                <td>@Model.CollectionName</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">Display Name:</td>
                                <td>@Model.CollectionDisplayName</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">Module:</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(Model.ModuleName))
                                    {
                                        <span class="badge bg-@(Model.ModuleBadgeColor)-transparent">
                                            <i class="@Model.ModuleIcon me-1"></i>@Model.ModuleName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">Description:</td>
                                <td>@(Model.Description ?? "—")</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">Status:</td>
                                <td>
                                    <span class="badge bg-@(Model.StatusClass)-transparent">@Model.StatusText</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- File Restrictions Card -->
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title">
                    <i class="ri-settings-3-line me-2"></i>File Restrictions & Settings
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <td class="fw-semibold" width="200">Max File Size:</td>
                                <td>
                                    <span class="badge bg-info-transparent">@Model.MaxFileSizeMb MB</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">Allowed File Types:</td>
                                <td>
                                    @if (Model.FileTypeIcons.Any())
                                    {
                                        <div class="d-flex gap-2 flex-wrap align-items-center">
                                            @foreach (var icon in Model.FileTypeIcons)
                                            {
                                                <span class="avatar avatar-sm bg-light @icon.ColorClass" title="@icon.Extension.ToUpper()">
                                                    <i class="@icon.IconClass fs-16"></i>
                                                </span>
                                            }
                                            <span class="text-muted ms-2">(@Model.AllowedFileTypesDisplay)</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">All file types allowed</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">Retention Policy:</td>
                                <td>@Model.RetentionPolicyDisplay</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Access Control Card -->
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title">
                    <i class="ri-shield-check-line me-2"></i>Access Control
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <td class="fw-semibold" width="200">Public Access:</td>
                                <td>
                                    @if (Model.IsPublic)
                                    {
                                        <span class="badge bg-success-transparent">
                                            <i class="ri-check-line me-1"></i>Yes
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-transparent">
                                            <i class="ri-close-line me-1"></i>No
                                        </span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">Requires Authentication:</td>
                                <td>
                                    @if (Model.RequiresAuthentication)
                                    {
                                        <span class="badge bg-warning-transparent">
                                            <i class="ri-lock-line me-1"></i>Yes
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-transparent">
                                            <i class="ri-lock-unlock-line me-1"></i>No
                                        </span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">Allowed Roles:</td>
                                <td>
                                    @if (Model.AllowedRoles.Any())
                                    {
                                        <div class="d-flex gap-2 flex-wrap">
                                            @foreach (var role in Model.AllowedRoles)
                                            {
                                                <span class="badge bg-primary-transparent">@role</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">All roles allowed</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics & Audit Sidebar -->
    <div class="col-xl-4">
        <!-- Statistics Card -->
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title">
                    <i class="ri-bar-chart-line me-2"></i>Statistics
                </div>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
                    <div>
                        <p class="mb-0 text-muted">Total Files</p>
                        <h4 class="fw-semibold mb-0">@Model.FileCount</h4>
                    </div>
                    <div class="avatar avatar-md bg-primary-transparent">
                        <i class="ri-file-line fs-20"></i>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
                    <div>
                        <p class="mb-0 text-muted">Total Size</p>
                        <h5 class="fw-semibold mb-0">@Model.TotalSizeFormatted</h5>
                    </div>
                    <div class="avatar avatar-md bg-success-transparent">
                        <i class="ri-database-line fs-20"></i>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="mb-0 text-muted">Last Upload</p>
                        <span class="text-muted small">@Model.FormattedLastUpload</span>
                    </div>
                    <div class="avatar avatar-md bg-info-transparent">
                        <i class="ri-upload-cloud-line fs-20"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Audit Information Card -->
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title">
                    <i class="ri-time-line me-2"></i>Audit Information
                </div>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <p class="mb-1 text-muted small">Created At</p>
                    <p class="mb-0 fw-semibold">@Model.FormattedCreatedDate</p>
                    @if (!string.IsNullOrEmpty(Model.CreatedByName))
                    {
                        <p class="mb-0 text-muted small">by @Model.CreatedByName</p>
                    }
                </div>
                @if (Model.UpdatedAt.HasValue)
                {
                    <div class="mb-3">
                        <p class="mb-1 text-muted small">Last Updated</p>
                        <p class="mb-0 fw-semibold">@Model.FormattedUpdatedDate</p>
                    </div>
                }
            </div>
        </div>

        <!-- Quick Actions Card -->
       
    </div>
</div>

<!-- Delete Form -->
<form id="deleteForm" method="post" action="@Url.Action("DeleteCollection", new { id = Model.CollectionId })" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        function confirmDelete() {
            if (confirm('Are you sure you want to delete this collection?\n\nThis action cannot be undone.')) {
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}
