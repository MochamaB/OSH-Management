@{
    ViewData["Title"] = "Media Access Control";
}

<!-- Page Header -->
<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <div>
        <p class="fw-semibold fs-18 mb-0">Media Access Control</p>
        <span class="fs-semibold text-muted">Manage file access permissions and security</span>
