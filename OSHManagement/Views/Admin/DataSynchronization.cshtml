@{
    ViewData["Title"] = "Data Synchronization";
    ViewData["BreadcrumbItems"] = new List<(string Text, string? Url)>
    {
        ("Home", Url.Action("Index", "Dashboard")),
        ("Administration", null),
        ("Data Synchronization", null)
    };
}

<div class="row">
    <div class="col-12">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="ri-check-line me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="ri-error-warning-line me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card custom-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Legacy Database Synchronization</h5>
                <div>
                    <a href="/hangfire" target="_blank" class="btn btn-info btn-sm">
                        <i class="ri-dashboard-line me-1"></i> View Job Dashboard
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="alert alert-info" role="alert">
                    <h6 class="alert-heading"><i class="ri-information-line me-2"></i>Scheduled Sync</h6>
                    <p class="mb-0">Automatic synchronization runs daily at 2:00 AM to keep data up-to-date with the legacy system.</p>
                </div>

                <h6 class="mb-3">Current Statistics</h6>
                <div class="row mb-4">
                    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
                        <div class="card custom-card">
                            <div class="card-body">
                                <div class="d-flex align-items-top">
                                    <div class="me-3">
                                        <span class="avatar avatar-md avatar-rounded bg-primary-transparent">
                                            <i class="ri-building-line fs-18"></i>
                                        </span>
                                    </div>
                                    <div class="flex-fill">
                                        <div class="d-flex justify-content-between">
                                            <h6 class="mb-1">Stations</h6>
                                        </div>
                                        <div>
                                            <span class="fs-20 fw-semibold">@(ViewBag.Stats?["Stations"] ?? 0)</span>
                                            <span class="text-muted fs-12 ms-2">synced</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
                        <div class="card custom-card">
                            <div class="card-body">
                                <div class="d-flex align-items-top">
                                    <div class="me-3">
                                        <span class="avatar avatar-md avatar-rounded bg-success-transparent">
                                            <i class="ri-team-line fs-18"></i>
                                        </span>
                                    </div>
                                    <div class="flex-fill">
                                        <div class="d-flex justify-content-between">
                                            <h6 class="mb-1">Departments</h6>
                                        </div>
                                        <div>
                                            <span class="fs-20 fw-semibold">@(ViewBag.Stats?["Departments"] ?? 0)</span>
                                            <span class="text-muted fs-12 ms-2">synced</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
                        <div class="card custom-card">
                            <div class="card-body">
                                <div class="d-flex align-items-top">
                                    <div class="me-3">
                                        <span class="avatar avatar-md avatar-rounded bg-warning-transparent">
                                            <i class="ri-user-line fs-18"></i>
                                        </span>
                                    </div>
                                    <div class="flex-fill">
                                        <div class="d-flex justify-content-between">
                                            <h6 class="mb-1">Employees</h6>
                                        </div>
                                        <div>
                                            <span class="fs-20 fw-semibold">@(ViewBag.Stats?["Employees"] ?? 0)</span>
                                            <span class="text-muted fs-12 ms-2">synced</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
                        <div class="card custom-card">
                            <div class="card-body">
                                <div class="d-flex align-items-top">
                                    <div class="me-3">
                                        <span class="avatar avatar-md avatar-rounded bg-danger-transparent">
                                            <i class="ri-shield-user-line fs-18"></i>
                                        </span>
                                    </div>
                                    <div class="flex-fill">
                                        <div class="d-flex justify-content-between">
                                            <h6 class="mb-1">Roles</h6>
                                        </div>
                                        <div>
                                            <span class="fs-20 fw-semibold">@(ViewBag.Stats?["Roles"] ?? 0)</span>
                                            <span class="text-muted fs-12 ms-2">synced</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <h6 class="mb-3">Manual Synchronization</h6>
                <div class="row">
                    <div class="col-xl-6">
                        <div class="card custom-card border">
                            <div class="card-body">
                                <h6 class="card-title mb-3">Full Synchronization</h6>
                                <p class="text-muted mb-3">
                                    Synchronize all data from legacy database (Stations, Departments, Employees, and Roles).
                                    This process runs in the background and may take several minutes.
                                </p>
                                <form asp-action="TriggerFullSync" method="post" onsubmit="return confirm('Are you sure you want to trigger a full synchronization? This will update all records.');">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="ri-refresh-line me-1"></i> Run Full Sync
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-6">
                        <div class="card custom-card border">
                            <div class="card-body">
                                <h6 class="card-title mb-3">Selective Synchronization</h6>
                                <p class="text-muted mb-3">
                                    Sync specific data types individually. Useful for targeted updates or testing.
                                </p>
                                <div class="btn-group-vertical w-100" role="group">
                                    <form asp-action="TriggerEntitySync" method="post" class="mb-2">
                                        <input type="hidden" name="entityType" value="stations" />
                                        <button type="submit" class="btn btn-outline-primary w-100">
                                            <i class="ri-building-line me-1"></i> Sync Stations Only
                                        </button>
                                    </form>
                                    <form asp-action="TriggerEntitySync" method="post" class="mb-2">
                                        <input type="hidden" name="entityType" value="departments" />
                                        <button type="submit" class="btn btn-outline-success w-100">
                                            <i class="ri-team-line me-1"></i> Sync Departments Only
                                        </button>
                                    </form>
                                    <form asp-action="TriggerEntitySync" method="post" class="mb-2">
                                        <input type="hidden" name="entityType" value="employees" />
                                        <button type="submit" class="btn btn-outline-warning w-100">
                                            <i class="ri-user-line me-1"></i> Sync Employees Only
                                        </button>
                                    </form>
                                    <form asp-action="TriggerEntitySync" method="post">
                                        <input type="hidden" name="entityType" value="roles" />
                                        <button type="submit" class="btn btn-outline-danger w-100">
                                            <i class="ri-shield-user-line me-1"></i> Sync Roles Only
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-refresh statistics every 30 seconds
        setInterval(async function() {
            try {
                const response = await fetch('@Url.Action("GetSyncStatistics", "Admin")');
                const result = await response.json();
                if (result.success) {
                    // Update statistics display
                    console.log('Statistics updated', result.data);
                }
            } catch (error) {
                console.error('Error fetching statistics:', error);
            }
        }, 30000);
    </script>
}
