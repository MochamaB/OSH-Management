@{
    ViewData["Title"] = "Data Synchronization";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-xl-12">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="card-title">
                        <h4 class="fw-semibold">Data Synchronization</h4>
                        <p class="text-muted mb-0">Manage synchronization between legacy KTDALeave database and OSH Management system</p>
                    </div>
                </div>
                <div class="card-body">


                    <div class="row">
                        <!-- Connection Test -->
                        <div class="col-xl-6 col-lg-6 col-md-12">
                            <div class="card border border-info">
                                <div class="card-body">
                                    <h6 class="card-title text-info">
                                        <i class="ri-database-2-line me-2"></i>Connection Test
                                    </h6>
                                    <p class="card-text text-muted">Test connection to legacy KTDALeave database</p>
                                    <form asp-controller="Admin" asp-action="TestConnection" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-info">
                                            <i class="ri-wifi-line me-2"></i>Test Connection
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Hangfire Dashboard -->
                        <div class="col-xl-6 col-lg-6 col-md-12">
                            <div class="card border border-primary">
                                <div class="card-body">
                                    <h6 class="card-title text-primary">
                                        <i class="ri-dashboard-line me-2"></i>Job Monitoring
                                    </h6>
                                    <p class="card-text text-muted">Monitor background job status and history</p>
                                    <a href="/hangfire" target="_blank" class="btn btn-primary">
                                        <i class="ri-external-link-line me-2"></i>Open Hangfire Dashboard
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="row">
                        <!-- Full Synchronization -->
                        <div class="col-xl-4 col-lg-6 col-md-12">
                            <div class="card border border-success">
                                <div class="card-body">
                                    <h6 class="card-title text-success">
                                        <i class="ri-refresh-line me-2"></i>Full Synchronization
                                    </h6>
                                    <p class="card-text text-muted">Sync all data: Stations, Departments, Employees, and Roles</p>
                                    <form asp-controller="Admin" asp-action="TriggerFullSync" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-success" onclick="return confirm('Are you sure you want to trigger a full synchronization?')">
                                            <i class="ri-download-cloud-line me-2"></i>Start Full Sync
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Station Sync -->
                        <div class="col-xl-4 col-lg-6 col-md-12">
                            <div class="card border border-warning">
                                <div class="card-body">
                                    <h6 class="card-title text-warning">
                                        <i class="ri-building-line me-2"></i>Station Sync
                                    </h6>
                                    <p class="card-text text-muted">Synchronize station data only</p>
                                    <form asp-controller="Admin" asp-action="TriggerStationSync" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-warning">
                                            <i class="ri-download-line me-2"></i>Sync Stations
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Employee Sync -->
                        <div class="col-xl-4 col-lg-6 col-md-12">
                            <div class="card border border-secondary">
                                <div class="card-body">
                                    <h6 class="card-title text-secondary">
                                        <i class="ri-user-line me-2"></i>Employee Sync
                                    </h6>
                                    <p class="card-text text-muted">Synchronize employee data only</p>
                                    <form asp-controller="Admin" asp-action="TriggerEmployeeSync" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-secondary">
                                            <i class="ri-download-line me-2"></i>Sync Employees
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <!-- Scheduled Jobs Info -->
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="alert alert-info" role="alert">
                                <h6 class="alert-heading">
                                    <i class="ri-time-line me-2"></i>Scheduled Jobs Information
                                </h6>
                                <ul class="mb-0">
                                    <li><strong>Full Sync:</strong> Runs daily at 2:00 AM</li>
                                    <li><strong>Employee Sync:</strong> Runs every hour for real-time updates</li>
                                    <li><strong>Manual Triggers:</strong> Use the buttons above for immediate synchronization</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

