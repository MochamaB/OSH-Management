@model OSHManagement.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthenticationLayout";
}

<div class="text-center mb-4">
    <img src="~/assets/images/brand-logos/logo.gif" alt="KTDA Logo" class="mb-3" style="height: 60px;">
    <h4 class="mb-1 fw-semibold">Forgot Password?</h4>
    <p class="mb-4 text-muted fw-normal">Enter your payroll number and email to reset your password</p>
</div>

<form asp-action="ForgotPassword" asp-controller="Account" method="post" class="row gy-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    
    <div class="col-xl-12">
        <label asp-for="PayrollNumber" class="form-label text-default"></label>
        <input asp-for="PayrollNumber" class="form-control form-control-lg" placeholder="Enter payroll number">
        <span asp-validation-for="PayrollNumber" class="text-danger"></span>
    </div>
    
    <div class="col-xl-12">
        <label asp-for="Email" class="form-label text-default"></label>
        <input asp-for="Email" class="form-control form-control-lg" placeholder="Enter email address">
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    
    <div class="col-xl-12 d-grid mt-4">
        <button type="submit" class="btn btn-lg btn-primary">Send Reset Link</button>
    </div>
</form>

<div class="text-center mt-4">
    <p class="fs-12 text-muted mb-0">
        Remember your password? 
        <a class="text-primary" asp-action="Login">Back to Login</a>
    </p>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
