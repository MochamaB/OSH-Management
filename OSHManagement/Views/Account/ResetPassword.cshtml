@model OSHManagement.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthenticationLayout";
}

<div class="text-center mb-4">
    <img src="~/assets/images/brand-logos/logo.gif" alt="KTDA Logo" class="mb-3" style="height: 60px;">
    <h4 class="mb-1 fw-semibold">Reset Password</h4>
    <p class="mb-4 text-muted fw-normal">Enter your new password below</p>
</div>

<form asp-action="ResetPassword" method="post" class="row gy-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    
    <input asp-for="Token" type="hidden" />
    
    <div class="col-xl-12">
        <label asp-for="PayrollNumber" class="form-label text-default"></label>
        <input asp-for="PayrollNumber" class="form-control form-control-lg" placeholder="Enter payroll number" readonly>
        <span asp-validation-for="PayrollNumber" class="text-danger"></span>
    </div>
    
    <div class="col-xl-12">
        <label asp-for="Password" class="form-label text-default"></label>
        <div class="input-group">
            <input asp-for="Password" class="form-control form-control-lg" placeholder="Enter new password" id="password-input">
            <button class="btn btn-light" type="button" onclick="createpassword('password-input','password-addon')" id="password-addon">
                <i class="ri-eye-off-line align-middle"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    
    <div class="col-xl-12">
        <label asp-for="ConfirmPassword" class="form-label text-default"></label>
        <div class="input-group">
            <input asp-for="ConfirmPassword" class="form-control form-control-lg" placeholder="Confirm new password" id="confirm-password-input">
            <button class="btn btn-light" type="button" onclick="createpassword('confirm-password-input','confirm-password-addon')" id="confirm-password-addon">
                <i class="ri-eye-off-line align-middle"></i>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>
    
    <div class="col-xl-12 d-grid mt-4">
        <button type="submit" class="btn btn-lg btn-primary">Reset Password</button>
    </div>
</form>

<div class="text-center mt-4">
    <p class="fs-12 text-muted mb-0">
        Remember your password? 
        <a class="text-primary" asp-action="Login">Back to Login</a>
    </p>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function createpassword(inputId, buttonId) {
            var passwordInput = document.getElementById(inputId);
            var passwordButton = document.getElementById(buttonId);
            var icon = passwordButton.querySelector('i');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                icon.className = 'ri-eye-line align-middle';
            } else {
                passwordInput.type = 'password';
                icon.className = 'ri-eye-off-line align-middle';
            }
        }
    </script>
}
