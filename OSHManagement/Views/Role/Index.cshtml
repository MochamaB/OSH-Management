@using OSHManagement.Extensions
@model List<OSHManagement.Models.ViewModels.RoleViewModel>
@{
    ViewData["Title"] = "Roles Management";

    // Build stat cards
    var statConfig = new OSHManagement.Models.ViewModels.StatsRowConfig
    {
        Titles = new List<string> { "Total Roles", "Organization Level", "Station Level", "Department Level" },
        Values = new List<string> {
            Model.Count.ToString(),
            Model.Count(r => r.ScopeLevel == OSHManagement.Models.Authorization.ScopeLevel.Organization).ToString(),
            Model.Count(r => r.ScopeLevel == OSHManagement.Models.Authorization.ScopeLevel.Station).ToString(),
            Model.Count(r => r.ScopeLevel == OSHManagement.Models.Authorization.ScopeLevel.Department).ToString()
        },
        Icons = new List<string> {
            "ri-shield-user-line",
            "ri-global-line",
            "ri-building-line",
            "ri-team-line"
        },
        ColorThemes = new List<string> { "primary", "success", "info", "warning" },
        CardType = OSHManagement.Models.ViewModels.CardType.LeftBorderCard
    };
    var statCards = statConfig.BuildStatsRow();

    // Build DataTable configuration
    var tableConfig = new OSHManagement.Models.ViewModels.TableConfig
    {
        TableId = "rolesTable",
        ActionUrl = "/Role/Index",
        Columns = new List<string> {
            "Role Name",
            "Scope Level",
            "Permissions",
            "Employees",
            "Status",
            "Actions"
        },
        SearchPlaceholder = "Search roles...",
        CreateButtonText = "Create Role",
        CreateButtonUrl = "/Role/Create",
        Filters = new List<OSHManagement.Models.ViewModels.FilterConfig>
        {
            new OSHManagement.Models.ViewModels.FilterConfig
            {
                Label = "Scope Level",
                ParameterName = "scopeLevel",
                Type = OSHManagement.Models.ViewModels.FilterType.Select,
                Options = new List<OSHManagement.Models.ViewModels.FilterOptionConfig>
                {
                    new OSHManagement.Models.ViewModels.FilterOptionConfig { Text = "All Scopes", Value = "" },
                    new OSHManagement.Models.ViewModels.FilterOptionConfig { Text = "Organization", Value = "1" },
                    new OSHManagement.Models.ViewModels.FilterOptionConfig { Text = "Station", Value = "2" },
                    new OSHManagement.Models.ViewModels.FilterOptionConfig { Text = "Department", Value = "3" },
                    new OSHManagement.Models.ViewModels.FilterOptionConfig { Text = "Team", Value = "4" },
                    new OSHManagement.Models.ViewModels.FilterOptionConfig { Text = "Self", Value = "5" }
                }
            },
            new OSHManagement.Models.ViewModels.FilterConfig
            {
                Label = "Status",
                ParameterName = "status",
                Type = OSHManagement.Models.ViewModels.FilterType.Select,
                Options = new List<OSHManagement.Models.ViewModels.FilterOptionConfig>
                {
                    new OSHManagement.Models.ViewModels.FilterOptionConfig { Text = "All Status", Value = "" },
                    new OSHManagement.Models.ViewModels.FilterOptionConfig { Text = "Active", Value = "active" },
                    new OSHManagement.Models.ViewModels.FilterOptionConfig { Text = "Inactive", Value = "inactive" }
                }
            }
        }
    };

    // Build table with row data
    var table = tableConfig.BuildTable(
        tableContent: @<text>
            @foreach (var role in Model)
            {
                var scopeClass = role.ScopeLevel switch
                {
                    OSHManagement.Models.Authorization.ScopeLevel.Organization => "primary",
                    OSHManagement.Models.Authorization.ScopeLevel.Station => "success",
                    OSHManagement.Models.Authorization.ScopeLevel.Department => "info",
                    OSHManagement.Models.Authorization.ScopeLevel.Team => "warning",
                    _ => "secondary"
                };

                var scopeIcon = role.ScopeLevel switch
                {
                    OSHManagement.Models.Authorization.ScopeLevel.Organization => "ri-global-line",
                    OSHManagement.Models.Authorization.ScopeLevel.Station => "ri-building-line",
                    OSHManagement.Models.Authorization.ScopeLevel.Department => "ri-team-line",
                    OSHManagement.Models.Authorization.ScopeLevel.Team => "ri-group-line",
                    _ => "ri-user-line"
                };

                <tr>
                    <td>
                        <div class="d-flex align-items-center">
                            <div class="avatar avatar-sm bg-@scopeClass-transparent me-2">
                                <i class="@scopeIcon fs-16"></i>
                            </div>
                            <div>
                                <div class="fw-semibold">@role.RoleName</div>
                                @if (!string.IsNullOrEmpty(role.Description))
                                {
                                    <div class="text-muted fs-12">@role.Description</div>
                                }
                                @if (role.IsSystemRole)
                                {
                                    <span class="badge bg-secondary-transparent mt-1">
                                        <i class="ri-lock-line"></i> System Role
                                    </span>
                                }
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="badge bg-@scopeClass-transparent">
                            <i class="@scopeIcon me-1"></i>@role.ScopeLevel.ToString()
                        </span>
                    </td>
                    <td>
                        <span class="badge bg-primary-transparent">
                            <i class="ri-checkbox-multiple-line me-1"></i>@role.PermissionsCount
                        </span>
                    </td>
                    <td>
                        <span class="badge bg-info-transparent">
                            <i class="ri-user-line me-1"></i>@role.EmployeesCount
                        </span>
                    </td>
                    <td>
                        @if (role.IsActive)
                        {
                            <span class="badge bg-success-transparent">
                                <i class="ri-checkbox-circle-line me-1"></i>Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-transparent">
                                <i class="ri-close-circle-line me-1"></i>Inactive
                            </span>
                        }
                    </td>
                    <td>
                        @{
                            var rowActions = new OSHManagement.Models.ViewModels.RowActionConfig
                            {
                                EditUrl = $"/Role/Edit/{{id}}",
                                ViewUrl = $"/Role/Details/{{id}}",
                                DeleteUrl = $"/Role/Delete/{{id}}",
                                DeleteItemName = role.RoleName,
                                ShowView = true,
                                ShowEdit = true,
                                ShowDelete = !role.IsSystemRole
                            };
                            var actions = OSHManagement.Extensions.DataTableExtensions.BuildRowActions(role.RoleId, "/Role", rowActions);
                        }
                        <partial name="~/Views/Shared/Components/_ActionButtons.cshtml" model="actions" />
                    </td>
                </tr>
            }
        </text>,
        currentUrl: Context.Request.Path + Context.Request.QueryString
    );
}

<!-- Stat Cards Row -->
<div class="row">
    @foreach (var card in statCards)
    {
        <partial name="~/Views/Shared/Components/StatisticCards/_LeftBorderCard.cshtml" model="card" />
    }
</div>

<!-- Main Content -->
<div class="row mt-3">
    <div class="col-xl-12">
        <partial name="~/Views/Shared/Components/_DataTable.cshtml" model="table" />
    </div>
</div>
