@using OSHManagement.Extensions
@using OSHManagement.Models.Authorization
@model OSHManagement.Models.ViewModels.EditRoleViewModel

@{
    ViewData["Title"] = "Edit Role";

    // Configure Vertical Tabs
    var tabsConfig = new OSHManagement.Models.ViewModels.TabsConfig
    {
        TabsId = "editRoleTabs",
        Type = OSHManagement.Models.ViewModels.TabsType.VerticalStyle1,
        NavColumnClass = "col-md-3",
        ContentColumnClass = "col-md-9",
        WrapInCard = true,
        CardTitle = $"Edit Role: {Model.RoleName}",
        CardSubtitle = $"Scope: {Model.ScopeLevel} | Created: {Model.CreatedAt.ToString("MMM dd, yyyy")}",

        Tabs = new List<OSHManagement.Models.ViewModels.TabConfig>
        {
            // ========== TAB 1: Role Details ==========
            new OSHManagement.Models.ViewModels.TabConfig
            {
                TabId = "roleDetails",
                Title = "Role Details",
                Icon = "ri-shield-user-line",
                IsActive = true,
                Content = @<text>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="RoleName" class="form-label"></label>
                            <input asp-for="RoleName" class="form-control" required />
                            <span asp-validation-for="RoleName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ScopeLevel" class="form-label"></label>
                            <select asp-for="ScopeLevel" class="form-select" required>
                                <option value="">-- Select Scope Level --</option>
                                <option value="@((int)ScopeLevel.Organization)">Organization - Full access to all stations and departments</option>
                                <option value="@((int)ScopeLevel.Station)">Station - Access to assigned station only</option>
                                <option value="@((int)ScopeLevel.Department)">Department - Access to assigned department only</option>
                                <option value="@((int)ScopeLevel.Team)">Team - Access to assigned team members only</option>
                                <option value="@((int)ScopeLevel.Self)">Self - Access to own data only</option>
                            </select>
                            <span asp-validation-for="ScopeLevel" class="text-danger"></span>
                            <div class="form-text">Determines the organizational level at which this role operates</div>
                        </div>
                        <div class="col-12 mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" maxlength="200"
                                      placeholder="Enter a brief description of this role's purpose and responsibilities"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                            <div class="form-text">Optional: Describe this role's purpose (max 200 characters)</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-check">
                                <input asp-for="IsSystemRole" class="form-check-input" type="checkbox" />
                                <label asp-for="IsSystemRole" class="form-check-label"></label>
                                <div class="form-text">System roles are built-in roles that cannot be deleted (can still be modified)</div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="IsActive" class="form-check-label"></label>
                                <div class="form-text">Inactive roles cannot be assigned to employees</div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-check">
                                <input asp-for="AllowCrossDepartmentAccess" class="form-check-input" type="checkbox" />
                                <label asp-for="AllowCrossDepartmentAccess" class="form-check-label"></label>
                                <div class="form-text">Users with this role can view and manage data across multiple departments within their station</div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-check">
                                <input asp-for="AllowCrossStationAccess" class="form-check-input" type="checkbox" />
                                <label asp-for="AllowCrossStationAccess" class="form-check-label"></label>
                                <div class="form-text">Users with this role can view and manage data across multiple stations (typically for regional or organization-level roles)</div>
                            </div>
                        </div>
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <div class="col-12 mt-3">
                                <div class="alert alert-info">
                                    <i class="ri-information-line me-2"></i>
                                    <strong>Last Updated:</strong> @Model.UpdatedAt.Value.ToString("MMM dd, yyyy hh:mm tt")
                                </div>
                            </div>
                        }
                    </div>
                </text>
            },

            // ========== TAB 2: Permissions ==========
            new OSHManagement.Models.ViewModels.TabConfig
            {
                TabId = "permissions",
                Title = "Permissions",
                Icon = "ri-lock-password-line",
                Content = @<text>
                    <div id="permissionsTab">
                        <partial name="_PermissionCheckboxAccordion" model="ViewBag.PermissionsByModule" />
                    </div>
                </text>
            },

            // ========== TAB 3: Employees ==========
            new OSHManagement.Models.ViewModels.TabConfig
            {
                TabId = "employees",
                Title = "Employees",
                Icon = "ri-team-line",
                Content = @<text>
                    <div id="employeesTab">
                        <partial name="_EmployeeCheckboxAccordion" model="ViewBag.EmployeesByStation" />
                    </div>
                </text>
            }
        }
    };

    // Build the tabs
    var tabs = tabsConfig.BuildTabs();
}

<!-- Render Tabs in Form -->
<form asp-action="Edit" method="post" id="editRoleForm">
    @Html.AntiForgeryToken()
    <input asp-for="RoleId" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />

    <!-- Render the tabs -->
    <partial name="~/Views/Shared/Components/Tabs/VerticalTabs.cshtml" model="tabs" />

    <!-- Submit button outside tabs (always visible) -->
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="ri-save-line me-1"></i>Save Changes
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="ri-close-line me-1"></i>Cancel
        </a>
    </div>
</form>

@section Scripts {
    <script src="~/assets/libs/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/assets/libs/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
