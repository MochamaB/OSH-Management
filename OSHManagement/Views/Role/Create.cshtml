@using OSHManagement.Extensions
@using OSHManagement.Models.Authorization
@model OSHManagement.Models.ViewModels.CreateRoleViewModel

@{
    ViewData["Title"] = "Create Role";

    // Configure Form Wizard with 3 Steps
    var wizardConfig = new OSHManagement.Models.ViewModels.FormWizardConfig
    {
        WizardId = "createRoleWizard",
        ActionUrl = "/Role/Create",
        Method = "POST",
        Type = OSHManagement.Models.ViewModels.WizardType.Vertical,
        WrapInCard = true,
        CardTitle = "Create New Role",
        CardSubtitle = "Define role details and assign permissions using the multi-step wizard",
        CancelUrl = "/Role/Index",
        CancelButtonText = "Cancel",
        PreviousButtonText = "Previous",
        NextButtonText = "Next",
        SubmitButtonText = "Create Role",
        ValidateOnStepChange = true,
        Steps = new List<OSHManagement.Models.ViewModels.WizardStepConfig>
        {
            // Step 1: Role Details
            new OSHManagement.Models.ViewModels.WizardStepConfig
            {
                StepId = "roleDetails",
                Title = "Role Details",
                Icon = "ri-shield-user-line",
                Description = "Basic information about the role",
                FieldsPerRow = 1,
                FieldColumnClass = "col-12",
                Fields = new List<OSHManagement.Models.ViewModels.FormFieldConfig>
                {
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "RoleName",
                        PropertyName = "RoleName",
                        Label = "Role Name",
                        Type = OSHManagement.Models.ViewModels.FieldType.Text,
                        Placeholder = "Enter role name (e.g., Station Manager, Safety Officer)",
                        Required = true,
                        ValidationMessage = "Role name is required",
                        MaxLength = 100,
                        Value = Model?.RoleName
                    },
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "Description",
                        PropertyName = "Description",
                        Label = "Description",
                        Type = OSHManagement.Models.ViewModels.FieldType.Textarea,
                        Placeholder = "Enter a brief description of this role's purpose and responsibilities",
                        Rows = 3,
                        MaxLength = 500,
                        Value = Model?.Description
                    },
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "ScopeLevel",
                        PropertyName = "ScopeLevel",
                        Label = "Scope Level",
                        Type = OSHManagement.Models.ViewModels.FieldType.Select,
                        Required = true,
                        ValidationMessage = "Scope level is required",
                        HelpText = "Determines the organizational level at which this role operates",
                        Options = new List<OSHManagement.Models.ViewModels.FormSelectOption>
                        {
                            new OSHManagement.Models.ViewModels.FormSelectOption { Value = "", Text = "-- Select Scope Level --" },
                            new OSHManagement.Models.ViewModels.FormSelectOption
                            {
                                Value = ((int)ScopeLevel.Organization).ToString(),
                                Text = "Organization - Full access to all stations and departments"
                            },
                            new OSHManagement.Models.ViewModels.FormSelectOption
                            {
                                Value = ((int)ScopeLevel.Station).ToString(),
                                Text = "Station - Access to assigned station only"
                            },
                            new OSHManagement.Models.ViewModels.FormSelectOption
                            {
                                Value = ((int)ScopeLevel.Department).ToString(),
                                Text = "Department - Access to assigned department only"
                            },
                            new OSHManagement.Models.ViewModels.FormSelectOption
                            {
                                Value = ((int)ScopeLevel.Team).ToString(),
                                Text = "Team - Access to assigned team members only"
                            },
                            new OSHManagement.Models.ViewModels.FormSelectOption
                            {
                                Value = ((int)ScopeLevel.Self).ToString(),
                                Text = "Self - Access to own data only"
                            }
                        },
                        Value = Model?.ScopeLevel.ToString()
                    },
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "IsSystemRole",
                        PropertyName = "IsSystemRole",
                        Label = "System Role",
                        Type = OSHManagement.Models.ViewModels.FieldType.Checkbox,
                        HelpText = "System roles are built-in roles that cannot be deleted (can still be modified)",
                        Value = Model?.IsSystemRole.ToString().ToLower()
                    },
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "AllowCrossDepartmentAccess",
                        PropertyName = "AllowCrossDepartmentAccess",
                        Label = "Allow Cross-Department Access",
                        Type = OSHManagement.Models.ViewModels.FieldType.Checkbox,
                        HelpText = "Users with this role can view and manage data across multiple departments within their station",
                        Value = Model?.AllowCrossDepartmentAccess.ToString().ToLower()
                    },
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "AllowCrossStationAccess",
                        PropertyName = "AllowCrossStationAccess",
                        Label = "Allow Cross-Station Access",
                        Type = OSHManagement.Models.ViewModels.FieldType.Checkbox,
                        HelpText = "Users with this role can view and manage data across multiple stations (typically for regional or organization-level roles)",
                        Value = Model?.AllowCrossStationAccess.ToString().ToLower()
                    }
                }
            },
            // Step 2: Permissions
            new OSHManagement.Models.ViewModels.WizardStepConfig
            {
                StepId = "permissions",
                Title = "Assign Permissions",
                Icon = "ri-lock-password-line",
                Description = "Select permissions for this role",
                FieldsPerRow = 1,
                FieldColumnClass = "col-12",
                Fields = new List<OSHManagement.Models.ViewModels.FormFieldConfig>()
                // Empty fields - will be populated with accordion via JavaScript
            },
            // Step 3: Assign Employees
            new OSHManagement.Models.ViewModels.WizardStepConfig
            {
                StepId = "employees",
                Title = "Assign Employees",
                Icon = "ri-team-line",
                Description = "Select initial employees for this role (optional)",
                FieldsPerRow = 1,
                FieldColumnClass = "col-12",
                Fields = new List<OSHManagement.Models.ViewModels.FormFieldConfig>()
                // Empty fields - will be populated with accordion via JavaScript
            }
        }
    };

    // Build the wizard
    var wizard = wizardConfig.BuildWizard();
}

<!-- Render Wizard -->
<div class="row">
    <div class="col-xl-12">
        <partial name="~/Views/Shared/Components/Wizards/VerticalFormWizard.cshtml" model="wizard" />
    </div>
</div>

<!-- Hidden container for permission accordion (will be moved to Step 2 via JavaScript) -->
<div id="permissionAccordionContainer" style="display: none;">
    <partial name="_PermissionCheckboxAccordion" model="ViewBag.PermissionsByModule" />
</div>

<!-- Hidden container for employee accordion (will be moved to Step 3 via JavaScript) -->
<div id="employeeAccordionContainer" style="display: none;">
    <partial name="_EmployeeCheckboxAccordion" model="ViewBag.EmployeesByStation" />
</div>

@section Scripts {
    <script src="~/assets/libs/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/assets/libs/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/wizard.js"></script>

    <script>
        $(document).ready(function() {
            // Function to inject permission accordion into Step 2
            function injectPermissionAccordion() {
                var permissionsStepBody = $('#step-2 .wizard-step-body .row');

                if (permissionsStepBody.length > 0 && permissionsStepBody.find('.accordion').length === 0) {
                    // Get the pre-rendered accordion content from hidden container
                    var accordionContent = $('#permissionAccordionContainer').html();

                    // Clear placeholder and inject accordion
                    permissionsStepBody.html('<div class="col-12">' + accordionContent + '</div>');

                    // Re-initialize event handlers after injecting
                    initializePermissionHandlers();
                }
            }

            // Initialize permission checkbox handlers
            function initializePermissionHandlers() {
                // Update badge counts when checkboxes change
                function updatePermissionCounts() {
                    $('.permission-count').each(function() {
                        var module = $(this).data('module');
                        var totalCount = $('.permission-checkbox[data-module="' + module + '"]').length;
                        var selectedCount = $('.permission-checkbox[data-module="' + module + '"]:checked').length;

                        $(this).find('.selected-count').text(selectedCount);

                        // Update badge color based on selection
                        if (selectedCount === 0) {
                            $(this).removeClass('bg-primary bg-warning').addClass('bg-light text-dark');
                        } else if (selectedCount === totalCount) {
                            $(this).removeClass('bg-light bg-warning text-dark').addClass('bg-primary text-white');
                        } else {
                            $(this).removeClass('bg-light bg-primary text-dark text-white').addClass('bg-warning text-dark');
                        }
                    });
                }

                // Select all permissions
                $('#selectAllPermissions').off('click').on('click', function() {
                    $('.permission-checkbox').prop('checked', true);
                    updatePermissionCounts();
                });

                // Deselect all permissions
                $('#deselectAllPermissions').off('click').on('click', function() {
                    $('.permission-checkbox').prop('checked', false);
                    updatePermissionCounts();
                });

                // Select all in module
                $('.select-module-all').off('click').on('click', function() {
                    var module = $(this).data('module');
                    $('.permission-checkbox[data-module="' + module + '"]').prop('checked', true);
                    updatePermissionCounts();
                });

                // Update counts on checkbox change
                $('.permission-checkbox').off('change').on('change', function() {
                    updatePermissionCounts();
                });

                // Initial count update
                updatePermissionCounts();
            }

            // Inject on page load
            injectPermissionAccordion();

            // Function to inject employee accordion into Step 3
            function injectEmployeeAccordion() {
                var employeesStepBody = $('#step-3 .wizard-step-body .row');

                if (employeesStepBody.length > 0 && employeesStepBody.find('.accordion').length === 0) {
                    // Get the pre-rendered accordion content from hidden container
                    var accordionContent = $('#employeeAccordionContainer').html();

                    // Clear placeholder and inject accordion
                    employeesStepBody.html('<div class="col-12">' + accordionContent + '</div>');

                    // Re-initialize event handlers after injecting
                    initializeEmployeeHandlers();
                }
            }

            // Initialize employee checkbox handlers
            function initializeEmployeeHandlers() {
                // Update badge counts when checkboxes change
                function updateEmployeeCounts() {
                    $('.employee-count').each(function() {
                        var station = $(this).data('station');
                        var totalCount = $('.employee-checkbox[data-station="' + station + '"]').length;
                        var selectedCount = $('.employee-checkbox[data-station="' + station + '"]:checked').length;

                        $(this).find('.selected-count').text(selectedCount);

                        // Update badge color based on selection
                        if (selectedCount === 0) {
                            $(this).removeClass('bg-primary bg-warning').addClass('bg-light text-dark');
                        } else if (selectedCount === totalCount) {
                            $(this).removeClass('bg-light bg-warning text-dark').addClass('bg-primary text-white');
                        } else {
                            $(this).removeClass('bg-light bg-primary text-dark text-white').addClass('bg-warning text-dark');
                        }
                    });
                }

                // Select all employees
                $('#selectAllEmployees').off('click').on('click', function() {
                    $('.employee-checkbox').prop('checked', true);
                    updateEmployeeCounts();
                });

                // Deselect all employees
                $('#deselectAllEmployees').off('click').on('click', function() {
                    $('.employee-checkbox').prop('checked', false);
                    updateEmployeeCounts();
                });

                // Select all in station
                $('.select-station-all').off('click').on('click', function() {
                    var station = $(this).data('station');
                    $('.employee-checkbox[data-station="' + station + '"]').prop('checked', true);
                    updateEmployeeCounts();
                });

                // Update counts on checkbox change
                $('.employee-checkbox').off('change').on('change', function() {
                    updateEmployeeCounts();
                });

                // Search functionality
                $('#employeeSearch').off('keyup').on('keyup', function() {
                    var searchTerm = $(this).val().toLowerCase();

                    $('.employee-checkbox-wrapper').each(function() {
                        var name = $(this).data('employee-name');
                        var payroll = $(this).data('employee-payroll');

                        if (name.includes(searchTerm) || payroll.includes(searchTerm)) {
                            $(this).removeClass('hidden');
                        } else {
                            $(this).addClass('hidden');
                        }
                    });
                });

                // Initial count update
                updateEmployeeCounts();
            }

            // Also inject when navigating to Step 2 or Step 3
            $(document).on('click', '.wizard-nav-link-vertical, .wizard-next, .wizard-prev', function() {
                setTimeout(function() {
                    var activeStep = $('.wizard-step.active');
                    if (activeStep.attr('id') === 'step-2') {
                        injectPermissionAccordion();
                    } else if (activeStep.attr('id') === 'step-3') {
                        injectEmployeeAccordion();
                    }
                }, 200);
            });

            // Validate Step 2 - at least one permission should be selected
            $(document).on('click', '.wizard-next', function(e) {
                var activeStep = $('.wizard-step.active');
                if (activeStep.attr('id') === 'step-2') {
                    var selectedPermissions = $('.permission-checkbox:checked').length;

                    if (selectedPermissions === 0) {
                        e.preventDefault();
                        e.stopPropagation();

                        // Show warning
                        if ($('#permissionWarning').length === 0) {
                            var warningHtml = `
                                <div id="permissionWarning" class="alert alert-warning alert-dismissible fade show mt-3" role="alert">
                                    <i class="ri-alert-line me-2"></i>
                                    <strong>Warning:</strong> Please select at least one permission for this role.
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            `;
                            $('#step-2 .wizard-step-body').prepend(warningHtml);
                        }

                        return false;
                    } else {
                        // Remove warning if exists
                        $('#permissionWarning').remove();
                    }
                }
            });
        });
    </script>
}
