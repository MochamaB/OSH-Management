@*
    Edit Team Members by Role - Partial View
    Specialized for editing existing teams with AJAX save/remove
    Different from Create - this loads existing members and saves immediately
*@

<div id="editTeamMembersByRoleContainer">
    <!-- Role Requirements Summary -->
    <div class="card border mb-3" id="rolesSummaryCard">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0">
                    <i class="ri-user-star-line me-2"></i>Team Members by Role
                </h6>
                <span class="badge bg-light text-dark" id="editTotalMembersCount">
                    <i class="ri-team-line me-1"></i><span id="editTotalMembersNumber">0</span> member(s)
                </span>
            </div>

            <!-- Overall Progress Bar -->
            <div class="mb-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <small class="text-muted">Composition Status</small>
                    <small class="text-muted">
                        <span id="editRequiredRolesFilled">0</span>/<span id="editTotalRequiredRoles">0</span> required roles filled
                    </small>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar bg-success" id="editOverallProgressBar" role="progressbar" style="width: 0%"></div>
                </div>
            </div>

            <!-- Loading State -->
            <div id="editRolesLoadingState" class="text-center py-3">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Loading roles...</span>
                </div>
                <p class="text-muted mb-0 mt-2 fs-12">Loading team members...</p>
            </div>

            <!-- No Roles Defined -->
            <div id="editNoRolesDefined" class="alert alert-warning border-0 mb-0" style="display: none;">
                <i class="ri-alert-line me-2"></i>
                No role definitions found for this team type.
            </div>
        </div>
    </div>

    <!-- Roles Accordion -->
    <div class="accordion accordion-primary" id="editRolesAccordion" style="display: none;">
        <!-- Roles will be dynamically populated here -->
    </div>
</div>

<style>
    .edit-member-card {
        padding: 0.75rem;
        border: 1px solid var(--bs-border-color);
        border-radius: 0.375rem;
        background-color: var(--bs-body-bg);
        margin-bottom: 0.5rem;
        transition: all 0.2s ease;
    }

    .edit-member-card:hover {
        border-color: var(--bs-primary);
        box-shadow: 0 0 0 0.2rem rgba(var(--bs-primary-rgb), 0.1);
    }

    .edit-member-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.875rem;
    }

    .edit-member-card .remove-member-btn,
    .edit-member-card .change-member-btn {
        opacity: 0;
        transition: opacity 0.2s;
    }

    .edit-member-card:hover .remove-member-btn,
    .edit-member-card:hover .change-member-btn {
        opacity: 1;
    }

    .edit-empty-role-state {
        padding: 2rem;
        text-align: center;
        color: var(--bs-secondary);
        border: 2px dashed var(--bs-border-color);
        border-radius: 0.375rem;
        background-color: var(--bs-light);
    }
</style>
