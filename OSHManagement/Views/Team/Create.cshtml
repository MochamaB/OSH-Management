@using OSHManagement.Extensions
@using OSHManagement.Models.Enums
@model OSHManagement.Models.ViewModels.CreateTeamViewModel

@{
    ViewData["Title"] = "Create Team";

    // Configure Form Wizard with 4 Steps
    var wizardConfig = new OSHManagement.Models.ViewModels.FormWizardConfig
    {
        WizardId = "createTeamWizard",
        ActionUrl = "/Team/Create",
        Method = "POST",
        Type = OSHManagement.Models.ViewModels.WizardType.Vertical,
        WrapInCard = true,
        CardTitle = "Create New Team",
        CardSubtitle = "Set up a new team for OSH management using the multi-step wizard",
        CancelUrl = "/Team/Index",
        CancelButtonText = "Cancel",
        PreviousButtonText = "Previous",
        NextButtonText = "Next",
        SubmitButtonText = "Create Team",
        ValidateOnStepChange = true,
        Steps = new List<OSHManagement.Models.ViewModels.WizardStepConfig>
        {
            // Step 1: Basic Team Information
            new OSHManagement.Models.ViewModels.WizardStepConfig
            {
                StepId = "basicInfo",
                Title = "Basic Information",
                Icon = "ri-information-line",
                Description = "Essential team details",
                FieldsPerRow = 2,
                FieldColumnClass = "col-md-6",
                Fields = new List<OSHManagement.Models.ViewModels.FormFieldConfig>
                {
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "StationId",
                        PropertyName = "StationId",
                        Label = "Station",
                        Type = OSHManagement.Models.ViewModels.FieldType.Select,
                        Required = true,
                        ValidationMessage = "Station is required",
                        HelpText = "Select the station where this team operates",
                        Options = ViewBag.Stations != null
                            ? (new List<OSHManagement.Models.ViewModels.FormSelectOption>
                            {
                                new OSHManagement.Models.ViewModels.FormSelectOption { Value = "", Text = "-- Select Station --" }
                            }).Concat(((IEnumerable<dynamic>)ViewBag.Stations).Select(s =>
                                new OSHManagement.Models.ViewModels.FormSelectOption { Value = s.StationId.ToString(), Text = s.StationName }
                            )).ToList()
                            : new List<OSHManagement.Models.ViewModels.FormSelectOption>(),
                        Value = Model?.StationId.ToString() ?? ""
                    },
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "TeamTypeDefinitionId",
                        PropertyName = "TeamTypeDefinitionId",
                        Label = "Team Type",
                        Type = OSHManagement.Models.ViewModels.FieldType.Select,
                        Required = true,
                        ValidationMessage = "Team type is required",
                        HelpText = "Select the type of team to create",
                        Options = ViewBag.TeamTypes != null
                            ? (new List<OSHManagement.Models.ViewModels.FormSelectOption>
                            {
                                new OSHManagement.Models.ViewModels.FormSelectOption { Value = "", Text = "-- Select Team Type --" }
                            }).Concat(((IEnumerable<dynamic>)ViewBag.TeamTypes).Select(t =>
                                new OSHManagement.Models.ViewModels.FormSelectOption { Value = t.TeamTypeDefinitionId.ToString(), Text = t.TypeName }
                            )).ToList()
                            : new List<OSHManagement.Models.ViewModels.FormSelectOption>(),
                        Value = Model?.TeamTypeDefinitionId.ToString() ?? ""
                    },
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "TeamName",
                        PropertyName = "TeamName",
                        Label = "Team Name",
                        Type = OSHManagement.Models.ViewModels.FieldType.Text,
                        Placeholder = "Enter team name",
                        Required = true,
                        ValidationMessage = "Team name is required",
                        MaxLength = 100,
                        Value = Model?.TeamName
                    },
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "FormationDate",
                        PropertyName = "FormationDate",
                        Label = "Formation Date",
                        Type = OSHManagement.Models.ViewModels.FieldType.Date,
                        Required = true,
                        ValidationMessage = "Formation date is required",
                        Value = Model?.FormationDate.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd")
                    },
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "TeamStatus",
                        PropertyName = "TeamStatus",
                        Label = "Team Status",
                        Type = OSHManagement.Models.ViewModels.FieldType.Select,
                        Required = true,
                        ValidationMessage = "Team status is required",
                        HelpText = "Current status of the team",
                        Options = new List<OSHManagement.Models.ViewModels.FormSelectOption>
                        {
                            new OSHManagement.Models.ViewModels.FormSelectOption { Value = "", Text = "-- Select Status --" },
                            new OSHManagement.Models.ViewModels.FormSelectOption { Value = "Active", Text = "Active" },
                            new OSHManagement.Models.ViewModels.FormSelectOption { Value = "Inactive", Text = "Inactive" },
                            new OSHManagement.Models.ViewModels.FormSelectOption { Value = "Forming", Text = "Forming" }
                        },
                        Value = Model?.TeamStatus ?? "Forming"
                    },
                    
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "TeamDescription",
                        PropertyName = "TeamDescription",
                        Label = "Description",
                        Type = OSHManagement.Models.ViewModels.FieldType.Textarea,
                        Placeholder = "Enter team description (optional)",
                        Rows = 3,
                        MaxLength = 500,
                        CustomCssClass = "col-12",
                        Value = Model?.TeamDescription
                    }
                }
            },
            // Step 2: Team Members
            new OSHManagement.Models.ViewModels.WizardStepConfig
            {
                StepId = "members",
                Title = "Team Members",
                Icon = "ri-team-line",
                Description = "Assign members to team roles",
                FieldsPerRow = 1,
                FieldColumnClass = "col-12",
                Fields = new List<OSHManagement.Models.ViewModels.FormFieldConfig>()
                // Custom content will be injected via JavaScript
            },
            // Step 3: Review & Submit
            new OSHManagement.Models.ViewModels.WizardStepConfig
            {
                StepId = "review",
                Title = "Review & Submit",
                Icon = "ri-checkbox-circle-line",
                Description = "Review team details before submission (Coming Soon)",
                FieldsPerRow = 1,
                FieldColumnClass = "col-12",
                Fields = new List<OSHManagement.Models.ViewModels.FormFieldConfig>()
                // To be implemented in next phase
            }
        }
    };

    // Build the wizard
    var wizard = wizardConfig.BuildWizard();
}

<!-- Render Wizard -->
<div class="row">
    <div class="col-xl-12">
        <partial name="~/Views/Shared/Components/Wizards/VerticalFormWizard.cshtml" model="wizard" />
    </div>
</div>

<!-- Hidden container for members step content -->
<div id="membersStepContent" style="display: none;">
    <partial name="~/Views/Team/_TeamMembersByRole.cshtml" />
</div>

<!-- Hidden container for review step content -->
<div id="reviewStepContent" style="display: none;">
    <partial name="~/Views/Team/_TeamReviewSummary.cshtml" />
</div>

<!-- Member Assignment Modal -->
<partial name="~/Views/Team/_AssignMemberToRoleModal.cshtml" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form-wizard.js"></script>

    <script>
        // ========== GLOBAL VARIABLES ==========
        let teamRoleDefinitions = []; // Role definitions for selected team type
        let assignedMembers = []; // Members assigned to roles (in-memory before submit)
        let availableEmployees = []; // Employees at selected station
        let selectedStationId = null;
        let selectedTeamTypeId = null;
        let sectionsData = @Html.Raw(Json.Serialize(ViewBag.Sections ?? new List<object>()));
        let educationLevels = @Html.Raw(Json.Serialize(ViewBag.EducationLevels ?? new List<object>()));

        $(document).ready(function() {
            console.log('Team Create Wizard - Role-Based Member Management');

            // Initialize education levels dropdown in modal
            populateEducationLevels();

            // Inject custom content into members step
            injectMembersStepContent();

            // Inject custom content into review step
            injectReviewStepContent();

            // Auto-fill team name based on Station and Team Type
            function autoFillTeamName() {
                var stationId = $('#createTeamWizard_basicInfo_StationId').val();
                var teamTypeId = $('#createTeamWizard_basicInfo_TeamTypeDefinitionId').val();
                var teamNameField = $('#createTeamWizard_basicInfo_TeamName');

                // Only auto-fill if both fields are selected and team name is empty or was auto-generated
                if (stationId && teamTypeId && (!teamNameField.val() || teamNameField.data('auto-filled'))) {
                    // Get station name from the selected option text
                    var stationName = $('#createTeamWizard_basicInfo_StationId option:selected').text();

                    // Get team type name from the selected option text
                    var teamTypeName = $('#createTeamWizard_basicInfo_TeamTypeDefinitionId option:selected').text();

                    // Format: "Station - Team Type" (e.g., "Boito - OSH Committee")
                    var autoGeneratedName = stationName + ' - ' + teamTypeName;

                    teamNameField.val(autoGeneratedName);
                    teamNameField.data('auto-filled', true); // Mark as auto-filled

                    console.log('Auto-filled team name:', autoGeneratedName);
                }
            }

            // Listen for changes in Station dropdown
            $(document).on('change', '#createTeamWizard_basicInfo_StationId', function() {
                selectedStationId = $(this).val();
                autoFillTeamName();
                // Load employees for this station
                if (selectedStationId) {
                    loadEmployeesForStation(selectedStationId);
                }
            });

            // Listen for changes in Team Type dropdown
            $(document).on('change', '#createTeamWizard_basicInfo_TeamTypeDefinitionId', function() {
                selectedTeamTypeId = $(this).val();
                autoFillTeamName();
                // Load role definitions for this team type
                if (selectedTeamTypeId) {
                    loadRoleDefinitions(selectedTeamTypeId);
                }
            });

            // When user manually edits the team name, remove auto-fill flag
            $(document).on('input', '#createTeamWizard_basicInfo_TeamName', function() {
                $(this).data('auto-filled', false);
            });

            // Handle wizard navigation
            $(document).on('click', '.wizard-nav-link-vertical, .wizard-next, .wizard-prev', function(e) {
                // Get current step before navigation
                var currentActiveStep = $('.wizard-step.active');
                var currentStepId = currentActiveStep.attr('data-step-id');

                // If leaving members step, validate required roles
                if (currentStepId === 'members' && $(this).hasClass('wizard-next')) {
                    if (!validateMembersStep()) {
                        e.preventDefault();
                        e.stopImmediatePropagation();
                        return false;
                    }
                }

                setTimeout(function() {
                    var activeStep = $('.wizard-step.active');

                    if (activeStep.length > 0) {
                        var stepId = activeStep.attr('data-step-id');
                        console.log('Active step:', stepId);

                        if (stepId === 'members') {
                            console.log('→ Step 2: Team Members');
                            // Initialize member management if team type is selected
                            if (selectedTeamTypeId) {
                                loadRoleDefinitions(selectedTeamTypeId);
                            } else {
                                showNoTeamTypeMessage();
                            }
                        } else if (stepId === 'review') {
                            console.log('→ Step 3: Review & Submit');
                            populateReviewSummary();
                        }
                    }
                }, 100);
            });

            // Before form submission, validate and add assigned members to hidden inputs
            $('form').on('submit', function(e) {
                // Validate members step if team type is selected
                if (selectedTeamTypeId && teamRoleDefinitions.length > 0) {
                    if (!validateMembersStep()) {
                        e.preventDefault();

                        // Navigate to members step to show errors
                        $('.wizard-nav-link-vertical[data-step-id="members"]').click();

                        return false;
                    }
                }

                prepareFormSubmission();
            });
        });

        // ========== ROLE MANAGEMENT ==========
        function loadRoleDefinitions(teamTypeId) {
            $('#rolesLoadingState').show();
            $('#noTeamTypeSelected').hide();
            $('#noRolesDefined').hide();
            $('#rolesAccordion').hide();

            $.ajax({
                url: '/Team/GetAvailableRoles',
                type: 'GET',
                data: { teamTypeDefinitionId: teamTypeId },
                success: function(data) {
                    teamRoleDefinitions = data;
                    $('#rolesLoadingState').hide();

                    if (data && data.length > 0) {
                        renderRoleAccordions();
                        updateOverallProgress();
                        $('#rolesAccordion').show();
                    } else {
                        $('#noRolesDefined').show();
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Failed to load role definitions:', error);
                    $('#rolesLoadingState').hide();
                    $('#noRolesDefined').show();
                }
            });
        }

        function renderRoleAccordions() {
            const accordion = $('#rolesAccordion');
            accordion.empty();

            teamRoleDefinitions.forEach((role, index) => {
                const roleMembers = assignedMembers.filter(m => m.roleId === role.teamRoleDefinitionId);
                const currentCount = roleMembers.length;
                const minCount = role.minOccurrences || 0;
                const maxCount = role.maxOccurrences || '∞';

                // Determine status
                let statusClass = '';
                let statusBadge = '';
                if (role.maxOccurrences && currentCount > role.maxOccurrences) {
                    statusClass = 'role-overfilled';
                    statusBadge = '<span class="badge bg-danger">Overfilled</span>';
                } else if (role.minOccurrences && currentCount >= role.minOccurrences) {
                    statusClass = 'role-complete';
                    statusBadge = '<span class="badge bg-success">Complete</span>';
                } else if (role.minOccurrences && currentCount < role.minOccurrences) {
                    statusClass = 'role-incomplete';
                    statusBadge = '<span class="badge bg-warning">Required</span>';
                }

                const accordionId = `roleAccordion_${role.teamRoleDefinitionId}`;
                const collapseId = `roleCollapse_${role.teamRoleDefinitionId}`;
                const isFirst = index === 0;

                let html = `
                    <div class="accordion-item role-accordion-item ${statusClass}" id="${accordionId}">
                        <h2 class="accordion-header">
                            <button class="accordion-button ${isFirst ? '' : 'collapsed'}" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#${collapseId}"
                                    aria-expanded="${isFirst ? 'true' : 'false'}" aria-controls="${collapseId}">
                                <div class="d-flex justify-content-between align-items-center w-100 me-3">
                                    <div class="flex-fill">
                                        <div class="fw-semibold">${role.roleName}</div>
                                        ${role.description ? `<small class="text-muted">${role.description}</small>` : ''}
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-primary role-badge-count">
                                            ${currentCount} / ${maxCount}
                                        </span>
                                        ${statusBadge}
                                        ${role.requiresVotingRights ? '<i class="ri-checkbox-circle-line text-success ms-2" title="Voting rights required"></i>' : ''}
                                    </div>
                                </div>
                            </button>
                        </h2>
                        <div id="${collapseId}" class="accordion-collapse collapse ${isFirst ? 'show' : ''}"
                             data-bs-parent="#rolesAccordion">
                            <div class="accordion-body">
                                <!-- Role Info -->
                                <div class="mb-3 p-2 bg-light rounded">
                                    <div class="row g-2 fs-12">
                                        <div class="col-auto">
                                            <span class="text-muted">Min:</span> <strong>${minCount}</strong>
                                        </div>
                                        <div class="col-auto">
                                            <span class="text-muted">Max:</span> <strong>${maxCount}</strong>
                                        </div>
                                        ${role.requiredQualifications ? `
                                        <div class="col-12">
                                            <span class="text-muted">Qualifications:</span> ${role.requiredQualifications}
                                        </div>` : ''}
                                    </div>
                                </div>

                                <!-- Add Member Button -->
                                <div class="mb-3">
                                    <button type="button" class="btn btn-sm btn-primary"
                                            onclick="openAssignMemberModal(${role.teamRoleDefinitionId})"
                                            ${role.maxOccurrences && currentCount >= role.maxOccurrences ? 'disabled' : ''}>
                                        <i class="ri-user-add-line me-1"></i>Add Member to ${role.roleName}
                                    </button>
                                </div>

                                <!-- Assigned Members List -->
                                <div id="roleMembers_${role.teamRoleDefinitionId}">
                                    ${renderRoleMembers(role.teamRoleDefinitionId)}
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                accordion.append(html);
            });
        }

        function renderRoleMembers(roleId) {
            const roleMembers = assignedMembers.filter(m => m.roleId === roleId);

            if (roleMembers.length === 0) {
                return `
                    <div class="empty-role-state">
                        <i class="ri-user-add-line fs-2 d-block mb-2"></i>
                        <p class="mb-0">No members assigned to this role yet</p>
                    </div>
                `;
            }

            let html = '';
            roleMembers.forEach(member => {
                const initials = getInitials(member.employeeName);
                const avatarColor = getAvatarColor(member.employeePayroll);

                html += `
                    <div class="member-card" data-member-payroll="${member.employeePayroll}">
                        <div class="d-flex align-items-center">
                            <div class="member-avatar" style="background: ${avatarColor};">
                                ${initials}
                            </div>
                            <div class="flex-fill ms-3">
                                <div class="fw-semibold">${member.employeeName}</div>
                                <div class="fs-12 text-muted">
                                    <i class="ri-user-line me-1"></i>${member.employeePayroll}
                                    ${member.designation ? ` • ${member.designation}` : ''}
                                </div>
                                ${member.isVoting ? '<span class="badge bg-success-transparent role-info-badge mt-1"><i class="ri-checkbox-circle-line me-1"></i>Voting</span>' : ''}
                                ${member.sectionName ? `<span class="badge bg-info-transparent role-info-badge mt-1"><i class="ri-building-line me-1"></i>${member.sectionName}</span>` : ''}
                            </div>
                            <button type="button" class="btn btn-sm btn-danger remove-member-btn"
                                    onclick="removeMemberFromRole('${member.employeePayroll}', ${member.roleId})">
                                <i class="ri-close-line"></i>
                            </button>
                        </div>
                    </div>
                `;
            });

            return html;
        }

        // ========== EMPLOYEE MANAGEMENT ==========
        function loadEmployeesForStation(stationId) {
            $.ajax({
                url: '/Team/GetEmployeesByStation',
                type: 'GET',
                data: { stationId: stationId },
                success: function(html) {
                    // This returns HTML from partial view
                    // We need to parse it or use a JSON endpoint
                    console.log('Employees loaded for station:', stationId);
                },
                error: function(xhr, status, error) {
                    console.error('Failed to load employees:', error);
                }
            });

            // Alternative: Use SearchEmployees endpoint
            $.ajax({
                url: '/Team/SearchEmployees',
                type: 'GET',
                data: { stationId: stationId, searchTerm: '', teamId: 0 },
                success: function(data) {
                    availableEmployees = data;
                    console.log(`Loaded ${data.length} employees for station ${stationId}`);
                },
                error: function(xhr, status, error) {
                    console.error('Failed to load employees:', error);
                }
            });
        }

        // ========== MODAL MANAGEMENT ==========
        function openAssignMemberModal(roleId) {
            const role = teamRoleDefinitions.find(r => r.teamRoleDefinitionId === roleId);
            if (!role) return;

            // Set modal title and info
            $('#modalRoleName').text(role.roleName);
            $('#selectedRoleId').val(roleId);

            // Set role info
            $('#roleDescription').text(role.description || role.roleName);
            let requirements = [];
            if (role.requiresVotingRights) requirements.push('Voting rights required');
            if (role.requiredQualifications) requirements.push(role.requiredQualifications);
            if (role.minOccurrences) requirements.push(`Min: ${role.minOccurrences} member(s)`);
            if (role.maxOccurrences) requirements.push(`Max: ${role.maxOccurrences} member(s)`);
            $('#roleRequirements').html(requirements.join(' • '));

            // Set current count
            const currentCount = assignedMembers.filter(m => m.roleId === roleId).length;
            $('#currentRoleCount').text(currentCount);
            $('#maxRoleCount').text(role.maxOccurrences || '∞');

            // Auto-check voting if required
            $('#memberIsVoting').prop('checked', role.requiresVotingRights);

            // Set default appointment date
            $('#memberAppointmentDate').val(new Date().toISOString().split('T')[0]);

            // Populate sections for selected station
            populateSections();

            // Load and display employees
            displayEmployeesInModal();

            // Show modal
            const modal = new bootstrap.Modal(document.getElementById('assignMemberModal'));
            modal.show();
        }

        function displayEmployeesInModal() {
            const container = $('#employeeListContent');
            $('#employeesLoadingState').show();
            $('#noEmployeesFound').hide();
            container.empty();

            if (!availableEmployees || availableEmployees.length === 0) {
                $('#employeesLoadingState').hide();
                $('#noEmployeesFound').show();
                return;
            }

            // Filter out already assigned employees
            const assignedPayrolls = assignedMembers.map(m => m.employeePayroll);
            const availableForSelection = availableEmployees.filter(e => !assignedPayrolls.includes(e.payrollNo));

            if (availableForSelection.length === 0) {
                $('#employeesLoadingState').hide();
                container.html('<div class="text-center text-muted py-3">All employees from this station have been assigned</div>');
                return;
            }

            // Group by department
            const grouped = {};
            availableForSelection.forEach(emp => {
                const dept = emp.departmentName || 'No Department';
                if (!grouped[dept]) grouped[dept] = [];
                grouped[dept].push(emp);
            });

            let html = '';
            Object.keys(grouped).sort().forEach(dept => {
                html += `<div class="department-group-header"><i class="ri-building-2-line me-1"></i>${dept}</div>`;

                grouped[dept].forEach(emp => {
                    const initials = getInitials(emp.fullName);
                    const avatarColor = getAvatarColor(emp.payrollNo);

                    html += `
                        <div class="employee-item" onclick="selectEmployee('${emp.payrollNo}', '${emp.fullName}', '${emp.designation || ''}')">
                            <div class="d-flex align-items-center">
                                <div class="employee-avatar-sm" style="background: ${avatarColor};">
                                    ${initials}
                                </div>
                                <div class="flex-fill ms-2">
                                    <div class="fw-medium">${emp.fullName}</div>
                                    <small class="text-muted">${emp.payrollNo}${emp.designation ? ' • ' + emp.designation : ''}</small>
                                </div>
                            </div>
                        </div>
                    `;
                });
            });

            container.html(html);
            $('#employeesLoadingState').hide();

            // Setup search
            $('#employeeSearchInput').off('keyup').on('keyup', function() {
                const searchTerm = $(this).val().toLowerCase();
                $('.employee-item').each(function() {
                    const text = $(this).text().toLowerCase();
                    $(this).toggle(text.includes(searchTerm));
                });
            });
        }

        function selectEmployee(payrollNo, fullName, designation) {
            $('.employee-item').removeClass('selected');
            $(event.currentTarget).addClass('selected');

            $('#selectedEmployeePayrollNo').val(payrollNo);
            $('#selectedEmployeeName').text(fullName);
            $('#selectedEmployeePayroll').text(payrollNo);
            $('#selectedEmployeePreview').show();
            $('#additionalDetailsSection').show();
            $('#assignMemberButton').prop('disabled', false);

            // Store for later use
            window.selectedEmployeeData = { payrollNo, fullName, designation };
        }

        function clearEmployeeSelection() {
            $('.employee-item').removeClass('selected');
            $('#selectedEmployeePayrollNo').val('');
            $('#selectedEmployeePreview').hide();
            $('#additionalDetailsSection').hide();
            $('#assignMemberButton').prop('disabled', true);
            window.selectedEmployeeData = null;
        }

        function assignMemberToRole() {
            const roleId = parseInt($('#selectedRoleId').val());
            const payrollNo = $('#selectedEmployeePayrollNo').val();

            if (!roleId || !payrollNo || !window.selectedEmployeeData) {
                alert('Please select an employee');
                return;
            }

            const role = teamRoleDefinitions.find(r => r.teamRoleDefinitionId === roleId);
            const currentCount = assignedMembers.filter(m => m.roleId === roleId).length;

            // Validate max occurrences
            if (role.maxOccurrences && currentCount >= role.maxOccurrences) {
                alert(`This role can only have ${role.maxOccurrences} member(s)`);
                return;
            }

            // Get section name if selected
            const sectionId = $('#memberSectionId').val();
            const sectionName = sectionId ? $('#memberSectionId option:selected').text() : null;

            // Create member object
            const member = {
                roleId: roleId,
                roleName: role.roleName,
                employeePayroll: payrollNo,
                employeeName: window.selectedEmployeeData.fullName,
                designation: window.selectedEmployeeData.designation,
                appointmentDate: $('#memberAppointmentDate').val(),
                sectionId: sectionId || null,
                sectionName: sectionName,
                isVoting: $('#memberIsVoting').is(':checked'),
                educationLevel: $('#memberEducationLevel').val() || null,
                relevantExperience: $('#memberRelevantExperience').val() || null
            };

            // Add to assigned members
            assignedMembers.push(member);

            console.log('Member assigned:', member);

            // Refresh UI
            renderRoleAccordions();
            updateOverallProgress();

            // Close modal
            bootstrap.Modal.getInstance(document.getElementById('assignMemberModal')).hide();

            // Reset modal
            clearEmployeeSelection();
            $('#employeeSearchInput').val('');

            // Show success message
            if (typeof toastr !== 'undefined') {
                toastr.success(`${member.employeeName} assigned to ${role.roleName}`);
            }
        }

        function removeMemberFromRole(payrollNo, roleId) {
            const memberIndex = assignedMembers.findIndex(m => m.employeePayroll === payrollNo && m.roleId === roleId);
            if (memberIndex > -1) {
                const member = assignedMembers[memberIndex];
                assignedMembers.splice(memberIndex, 1);

                // Refresh UI
                renderRoleAccordions();
                updateOverallProgress();

                if (typeof toastr !== 'undefined') {
                    toastr.info(`${member.employeeName} removed from ${member.roleName}`);
                }
            }
        }

        // ========== UI HELPERS ==========
        function updateOverallProgress() {
            const totalMembers = assignedMembers.length;
            $('#totalMembersNumber').text(totalMembers);

            // Count required roles filled
            let requiredRolesFilled = 0;
            let totalRequiredRoles = 0;

            teamRoleDefinitions.forEach(role => {
                if (role.minOccurrences && role.minOccurrences > 0) {
                    totalRequiredRoles++;
                    const currentCount = assignedMembers.filter(m => m.roleId === role.teamRoleDefinitionId).length;
                    if (currentCount >= role.minOccurrences) {
                        requiredRolesFilled++;
                    }
                }
            });

            $('#requiredRolesFilled').text(requiredRolesFilled);
            $('#totalRequiredRoles').text(totalRequiredRoles);

            const progress = totalRequiredRoles > 0 ? (requiredRolesFilled / totalRequiredRoles) * 100 : 0;
            $('#overallProgressBar').css('width', progress + '%');
        }

        function populateSections() {
            const select = $('#memberSectionId');
            select.empty().append('<option value="">-- No Section --</option>');

            // Filter sections by selected station
            if (selectedStationId && sectionsData) {
                const stationSections = sectionsData.filter(s => s.stationId == selectedStationId);
                stationSections.forEach(section => {
                    select.append(`<option value="${section.sectionId}">${section.sectionName}</option>`);
                });
            }
        }

        function populateEducationLevels() {
            const select = $('#memberEducationLevel');
            select.empty().append('<option value="">-- Select --</option>');

            if (educationLevels && educationLevels.length > 0) {
                educationLevels.forEach(level => {
                    select.append(`<option value="${level}">${level}</option>`);
                });
            }
        }

        function showNoTeamTypeMessage() {
            $('#rolesLoadingState').hide();
            $('#noTeamTypeSelected').show();
            $('#noRolesDefined').hide();
            $('#rolesAccordion').hide();
        }

        function getInitials(name) {
            if (!name) return '?';
            const parts = name.split(' ');
            if (parts.length >= 2) {
                return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
            }
            return name.substring(0, 2).toUpperCase();
        }

        function getAvatarColor(payrollNo) {
            const colors = [
                'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
                'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)',
                'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)',
                'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)',
                'linear-gradient(135deg, #fa709a 0%, #fee140 100%)',
                'linear-gradient(135deg, #30cfd0 0%, #330867 100%)',
                'linear-gradient(135deg, #a8edea 0%, #fed6e3 100%)',
                'linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%)'
            ];
            const hash = payrollNo.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
            return colors[hash % colors.length];
        }

        // ========== REVIEW STEP ==========
        function injectReviewStepContent() {
            const reviewStep = $('[data-step-id="review"]');
            if (reviewStep.length > 0) {
                const stepBody = reviewStep.find('.wizard-step-body .row');

                if (stepBody.find('#teamReviewSummaryContainer').length === 0) {
                    const content = $('#reviewStepContent').html();
                    stepBody.html('<div class="col-12">' + content + '</div>');
                    console.log('Review step content injected successfully');
                }
            }
        }

        function populateReviewSummary() {
            // Populate basic information
            const teamName = $('#createTeamWizard_basicInfo_TeamName').val() || '-';
            const teamTypeText = $('#createTeamWizard_basicInfo_TeamTypeDefinitionId option:selected').text() || '-';
            const stationText = $('#createTeamWizard_basicInfo_StationId option:selected').text() || '-';
            const formationDate = $('#createTeamWizard_basicInfo_FormationDate').val() || '-';
            const teamStatus = $('#createTeamWizard_basicInfo_TeamStatus').val() || 'Forming';
            const teamDescription = $('#createTeamWizard_basicInfo_TeamDescription').val();

            $('#review_teamName').text(teamName);
            $('#review_teamType').text(teamTypeText);
            $('#review_station').text(stationText);
            $('#review_formationDate').text(formatDate(formationDate));

            // Style status badge
            const statusClass = teamStatus === 'Active' ? 'bg-success' :
                               teamStatus === 'Inactive' ? 'bg-secondary' : 'bg-warning';
            $('#review_teamStatus').attr('class', 'badge ' + statusClass).text(teamStatus);

            // Show/hide description
            if (teamDescription && teamDescription.trim()) {
                $('#review_teamDescription').text(teamDescription);
                $('#review_descriptionContainer').show();
            } else {
                $('#review_descriptionContainer').hide();
            }

            // Populate team members
            populateReviewMembers();
        }

        function populateReviewMembers() {
            const totalMembers = assignedMembers.length;
            $('#review_totalMembersCount').text(totalMembers + ' member' + (totalMembers !== 1 ? 's' : ''));

            const container = $('#review_membersByRole');
            container.empty();

            if (totalMembers === 0) {
                $('#review_noMembers').show();
                $('#review_compositionStatus').hide();
                return;
            }

            $('#review_noMembers').hide();

            // Group members by role
            const membersByRole = {};
            assignedMembers.forEach(member => {
                if (!membersByRole[member.roleId]) {
                    membersByRole[member.roleId] = {
                        roleName: member.roleName,
                        members: []
                    };
                }
                membersByRole[member.roleId].members.push(member);
            });

            // Render each role section
            Object.keys(membersByRole).forEach(roleId => {
                const roleData = membersByRole[roleId];
                const role = teamRoleDefinitions.find(r => r.teamRoleDefinitionId == roleId);

                let roleHtml = `
                    <div class="role-section-review">
                        <div class="role-header-review">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>${roleData.roleName}</strong>
                                    <span class="badge bg-primary-transparent composition-badge ms-2">
                                        ${roleData.members.length} member${roleData.members.length !== 1 ? 's' : ''}
                                    </span>
                                </div>
                `;

                // Add compliance badge
                if (role) {
                    const currentCount = roleData.members.length;
                    let complianceBadge = '';

                    if (role.minOccurrences && currentCount < role.minOccurrences) {
                        complianceBadge = `<span class="badge bg-warning-transparent composition-badge">Below minimum</span>`;
                    } else if (role.maxOccurrences && currentCount > role.maxOccurrences) {
                        complianceBadge = `<span class="badge bg-danger-transparent composition-badge">Over maximum</span>`;
                    } else if (role.minOccurrences && currentCount >= role.minOccurrences) {
                        complianceBadge = `<span class="badge bg-success-transparent composition-badge"><i class="ri-checkbox-circle-line me-1"></i>Complete</span>`;
                    }

                    roleHtml += `<div>${complianceBadge}</div>`;
                }

                roleHtml += `
                            </div>
                        </div>
                        <div class="row g-2">
                `;

                // Render members in this role
                roleData.members.forEach(member => {
                    const initials = getInitials(member.employeeName);
                    const avatarColor = getAvatarColor(member.employeePayroll);

                    roleHtml += `
                        <div class="col-md-6">
                            <div class="member-review-card">
                                <div class="d-flex align-items-center">
                                    <div class="member-review-avatar" style="background: ${avatarColor};">
                                        ${initials}
                                    </div>
                                    <div class="flex-fill ms-2">
                                        <div class="fw-medium fs-14">${member.employeeName}</div>
                                        <small class="text-muted">
                                            ${member.employeePayroll}
                                            ${member.designation ? ' • ' + member.designation : ''}
                                        </small>
                                        <div class="mt-1">
                                            ${member.isVoting ? '<span class="badge bg-success-transparent composition-badge"><i class="ri-checkbox-circle-line me-1"></i>Voting</span>' : ''}
                                            ${member.sectionName ? '<span class="badge bg-info-transparent composition-badge ms-1"><i class="ri-building-line me-1"></i>' + member.sectionName + '</span>' : ''}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                });

                roleHtml += `
                        </div>
                    </div>
                `;

                container.append(roleHtml);
            });

            // Show composition status
            showCompositionStatus();
        }

        function showCompositionStatus() {
            const container = $('#review_compositionStatus');
            container.empty();

            const errors = [];
            const warnings = [];
            let allValid = true;

            // Check each role
            teamRoleDefinitions.forEach(role => {
                const currentCount = assignedMembers.filter(m => m.roleId === role.teamRoleDefinitionId).length;

                if (role.minOccurrences && currentCount < role.minOccurrences) {
                    errors.push(`${role.roleName}: Requires ${role.minOccurrences}, has ${currentCount}`);
                    allValid = false;
                }

                if (role.maxOccurrences && currentCount > role.maxOccurrences) {
                    errors.push(`${role.roleName}: Exceeds maximum of ${role.maxOccurrences}`);
                    allValid = false;
                }
            });

            if (errors.length > 0) {
                let html = `
                    <div class="alert alert-warning border-0 mb-0">
                        <h6 class="alert-heading mb-2">
                            <i class="ri-alert-line me-2"></i>Team Composition Issues
                        </h6>
                        <ul class="mb-0 ps-3">
                `;
                errors.forEach(error => {
                    html += `<li>${error}</li>`;
                });
                html += `</ul></div>`;
                container.html(html).show();
            } else if (allValid && assignedMembers.length > 0) {
                container.html(`
                    <div class="alert alert-success border-0 mb-0">
                        <i class="ri-checkbox-circle-line me-2"></i>
                        <strong>Team composition is valid!</strong> All role requirements are met.
                    </div>
                `).show();
            }
        }

        function goToStep(stepNumber) {
            $('.wizard-nav-link-vertical[data-step="' + stepNumber + '"]').click();
        }

        function formatDate(dateString) {
            if (!dateString) return '-';
            const date = new Date(dateString);
            const options = { year: 'numeric', month: 'long', day: 'numeric' };
            return date.toLocaleDateString('en-US', options);
        }

        function prepareFormSubmission() {
            // Remove any existing hidden inputs for members
            $('input[name^="SelectedMemberPayrolls"]').remove();
            $('input[name^="Members["]').remove();

            // Add SelectedMemberPayrolls
            assignedMembers.forEach((member, index) => {
                $('<input>').attr({
                    type: 'hidden',
                    name: 'SelectedMemberPayrolls[' + index + ']',
                    value: member.employeePayroll
                }).appendTo('form');

                // Add full member details
                $('<input>').attr({
                    type: 'hidden',
                    name: 'Members[' + index + '].EmployeePayroll',
                    value: member.employeePayroll
                }).appendTo('form');

                $('<input>').attr({
                    type: 'hidden',
                    name: 'Members[' + index + '].TeamRoleDefinitionId',
                    value: member.roleId
                }).appendTo('form');

                if (member.sectionId) {
                    $('<input>').attr({
                        type: 'hidden',
                        name: 'Members[' + index + '].SectionId',
                        value: member.sectionId
                    }).appendTo('form');
                }

                $('<input>').attr({
                    type: 'hidden',
                    name: 'Members[' + index + '].AppointmentDate',
                    value: member.appointmentDate || new Date().toISOString().split('T')[0]
                }).appendTo('form');

                $('<input>').attr({
                    type: 'hidden',
                    name: 'Members[' + index + '].IsVotingMember',
                    value: member.isVoting
                }).appendTo('form');

                if (member.educationLevel) {
                    $('<input>').attr({
                        type: 'hidden',
                        name: 'Members[' + index + '].EducationLevel',
                        value: member.educationLevel
                    }).appendTo('form');
                }

                if (member.relevantExperience) {
                    $('<input>').attr({
                        type: 'hidden',
                        name: 'Members[' + index + '].RelevantExperience',
                        value: member.relevantExperience
                    }).appendTo('form');
                }
            });

            console.log('Form prepared with', assignedMembers.length, 'members');
        }

        // ========== INJECT CUSTOM CONTENT INTO WIZARD STEP ==========
        function injectMembersStepContent() {
            // Find the members step body
            const membersStep = $('[data-step-id="members"]');
            if (membersStep.length > 0) {
                const stepBody = membersStep.find('.wizard-step-body .row');

                // Check if content already injected
                if (stepBody.find('#teamMembersByRoleContainer').length === 0) {
                    // Get the content from hidden container
                    const content = $('#membersStepContent').html();

                    // Inject into step body
                    stepBody.html('<div class="col-12">' + content + '</div>');

                    console.log('Members step content injected successfully');
                }
            }
        }

        // ========== MEMBERS STEP VALIDATION ==========
        function validateMembersStep() {
            // Clear previous validation messages
            $('#memberValidationMessages').empty().hide();

            const errors = [];
            const warnings = [];

            // Check each role for minimum requirements
            teamRoleDefinitions.forEach(role => {
                const currentCount = assignedMembers.filter(m => m.roleId === role.teamRoleDefinitionId).length;

                // Check minimum occurrences
                if (role.minOccurrences && currentCount < role.minOccurrences) {
                    errors.push({
                        roleId: role.teamRoleDefinitionId,
                        roleName: role.roleName,
                        message: `Role "${role.roleName}" requires minimum ${role.minOccurrences} member(s), currently has ${currentCount}`
                    });
                }

                // Check maximum occurrences
                if (role.maxOccurrences && currentCount > role.maxOccurrences) {
                    errors.push({
                        roleId: role.teamRoleDefinitionId,
                        roleName: role.roleName,
                        message: `Role "${role.roleName}" exceeds maximum ${role.maxOccurrences} member(s), currently has ${currentCount}`
                    });
                }
            });

            // Display validation messages
            if (errors.length > 0) {
                displayValidationMessages(errors, warnings);

                // Scroll to validation messages
                $('#memberValidationMessages')[0].scrollIntoView({ behavior: 'smooth', block: 'start' });

                // Show error toast
                if (typeof toastr !== 'undefined') {
                    toastr.error('Please fill all required roles before proceeding', 'Validation Error');
                }

                return false;
            }

            return true;
        }

        function displayValidationMessages(errors, warnings) {
            const container = $('#memberValidationMessages');
            container.empty();

            // Display errors
            if (errors.length > 0) {
                let errorHtml = `
                    <div class="alert alert-danger border-0 alert-dismissible fade show" role="alert">
                        <h6 class="alert-heading mb-2">
                            <i class="ri-error-warning-line me-2"></i>Required Roles Not Filled
                        </h6>
                        <ul class="mb-0 ps-3">
                `;

                errors.forEach(error => {
                    errorHtml += `<li>${error.message}</li>`;
                });

                errorHtml += `
                        </ul>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;

                container.append(errorHtml);
            }

            // Display warnings
            if (warnings.length > 0) {
                let warningHtml = `
                    <div class="alert alert-warning border-0 alert-dismissible fade show" role="alert">
                        <h6 class="alert-heading mb-2">
                            <i class="ri-alert-line me-2"></i>Recommendations
                        </h6>
                        <ul class="mb-0 ps-3">
                `;

                warnings.forEach(warning => {
                    warningHtml += `<li>${warning.message}</li>`;
                });

                warningHtml += `
                        </ul>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;

                container.append(warningHtml);
            }

            container.show();
        }
    </script>
}
