@model OSHManagement.Models.ViewModels.CompositionStatusViewModel

@{
    var statusIcon = Model.IsValid ? "ri-checkbox-circle-line" : "ri-alert-line";
    var statusClass = Model.IsValid ? "success" : "warning";
    var statusText = Model.IsValid ? "Valid Composition" : "Composition Issues";
}

<div class="card border-@statusClass mb-3">
    <div class="card-header bg-@statusClass-transparent">
        <h6 class="mb-0">
            <i class="@statusIcon me-2"></i>@statusText
        </h6>
    </div>
    <div class="card-body">
        <!-- Summary Stats -->
        <div class="row mb-3">
            <div class="col-md-3">
                <div class="text-center p-2 bg-light rounded">
                    <div class="fs-20 fw-semibold text-primary">@Model.TotalMembers</div>
                    <small class="text-muted">Total Members</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-center p-2 bg-light rounded">
                    <div class="fs-20 fw-semibold text-success">@Model.RequiredMembers</div>
                    <small class="text-muted">Required</small>
                </div>
            </div>
            @if (Model.MaxMembers.HasValue)
            {
                <div class="col-md-3">
                    <div class="text-center p-2 bg-light rounded">
                        <div class="fs-20 fw-semibold text-danger">@Model.MaxMembers</div>
                        <small class="text-muted">Maximum</small>
                    </div>
                </div>
            }
            @if (Model.HasSectionRepresentation)
            {
                <div class="col-md-3">
                    <div class="text-center p-2 bg-light rounded">
                        <div class="fs-20 fw-semibold text-info">@Model.SectionsRepresented</div>
                        <small class="text-muted">Sections</small>
                    </div>
                </div>
            }
        </div>

        <!-- Role Distribution -->
        @if (Model.RoleCounts.Any())
        {
            <div class="mb-3">
                <h6 class="mb-2">Role Distribution</h6>
                <div class="row g-2">
                    @foreach (var role in Model.RoleCounts.OrderByDescending(r => r.Value))
                    {
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded">
                                <span class="text-muted">@role.Key</span>
                                <span class="badge bg-primary">@role.Value</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Errors -->
        @if (Model.Errors.Any())
        {
            <div class="alert alert-danger mb-2" role="alert">
                <h6 class="alert-heading">
                    <i class="ri-error-warning-line me-2"></i>Composition Errors
                </h6>
                <ul class="mb-0 ps-3">
                    @foreach (var error in Model.Errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <!-- Warnings -->
        @if (Model.Warnings.Any())
        {
            <div class="alert alert-warning mb-0" role="alert">
                <h6 class="alert-heading">
                    <i class="ri-alert-line me-2"></i>Composition Warnings
                </h6>
                <ul class="mb-0 ps-3">
                    @foreach (var warning in Model.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        }

        <!-- Success Message -->
        @if (Model.IsValid)
        {
            <div class="alert alert-success mb-0" role="alert">
                <i class="ri-checkbox-circle-line me-2"></i>
                Team composition meets all requirements and is ready for operation.
            </div>
        }
    </div>
</div>

<style>
    .fs-20 {
        font-size: 1.25rem;
    }
</style>
