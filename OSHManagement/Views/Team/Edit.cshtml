@using OSHManagement.Extensions
@model OSHManagement.Models.ViewModels.EditTeamViewModel
@{
    ViewData["Title"] = $"Edit Team - {Model.TeamName}";

    // Get station name from ViewBag.Stations
    var stations = ViewBag.Stations as IEnumerable<dynamic>;
    var currentStation = stations?.FirstOrDefault(s => s.StationId == Model.StationId);
    var stationName = currentStation?.StationName ?? "Unknown Station";

    // Get team type name
    var teamTypes = ViewBag.TeamTypes as IEnumerable<dynamic>;
    var currentTeamType = teamTypes?.FirstOrDefault(t => t.TeamTypeDefinitionId == Model.TeamTypeDefinitionId);
    var teamTypeName = currentTeamType?.TypeName ?? Model.TeamType ?? "Unknown Type";

    // Configure Vertical Tabs
    var tabsConfig = new OSHManagement.Models.ViewModels.TabsConfig
    {
        TabsId = "editTeamTabs",
        Type = OSHManagement.Models.ViewModels.TabsType.VerticalStyle1,
        NavColumnClass = "col-md-3",
        ContentColumnClass = "col-md-9",
        WrapInCard = true,
        CardTitle = "",
        CardSubtitle = $"{teamTypeName} | {stationName}",

        Tabs = new List<OSHManagement.Models.ViewModels.TabConfig>
        {
            // ========== TAB 1: Basic Information ==========
            new OSHManagement.Models.ViewModels.TabConfig
            {
                TabId = "basicInfo",
                Title = "Basic Information",
                Icon = "ri-information-line",
                IsActive = true,
                Content = @<text>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TeamName" class="form-label"></label>
                            <input asp-for="TeamName" class="form-control" required />
                            <span asp-validation-for="TeamName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Team Type</label>
                            <input type="text" class="form-control" value="@teamTypeName" readonly />
                            <div class="form-text">Team type cannot be changed after creation</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="StationId" class="form-label"></label>
                            <select asp-for="StationId" class="form-select" disabled>
                                @if (ViewBag.Stations != null)
                                {
                                    foreach (var station in (IEnumerable<dynamic>)ViewBag.Stations)
                                    {
                                        <option value="@station.StationId" selected="@(station.StationId == Model.StationId)">
                                            @station.StationName
                                        </option>
                                    }
                                }
                            </select>
                            <div class="form-text">Station cannot be changed after creation</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="TeamStatus" class="form-label"></label>
                            <select asp-for="TeamStatus" class="form-select">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                                <option value="Suspended">Suspended</option>
                            </select>
                            <span asp-validation-for="TeamStatus" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="FormationDate" class="form-label"></label>
                            <input asp-for="FormationDate" type="date" class="form-control" />
                            <span asp-validation-for="FormationDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Created At</label>
                            <input type="text" class="form-control" value="@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")" readonly />
                        </div>
                        <div class="col-12 mb-3">
                            <label asp-for="TeamDescription" class="form-label"></label>
                            <textarea asp-for="TeamDescription" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="TeamDescription" class="text-danger"></span>
                        </div>

                        <!-- Save Button -->
                        <div class="col-12 mt-3">
                            <div class="d-flex justify-content-between">
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="ri-arrow-left-line me-1"></i>Back to List
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="ri-save-line me-1"></i>Save Changes
                                </button>
                            </div>
                        </div>
                    </div>
                </text>
            },

            // ========== TAB 2: Team Configuration ==========
            new OSHManagement.Models.ViewModels.TabConfig
            {
                TabId = "configuration",
                Title = "Configuration",
                Icon = "ri-settings-3-line",
                Content = @<text>
                    <div class="text-center py-5">
                        <img src="~/assets/images/vectors/configurations.png"
                             alt="Team Configuration"
                             class="img-fluid mb-4"
                             style="max-width: 400px; opacity: 0.8;" />

                        <h5 class="mb-3">Team Configuration</h5>
                        <p class="text-muted mb-4" style="max-width: 600px; margin: 0 auto;">
                            Team-specific configuration settings will be managed here. Each team can have its own
                            unique configuration (inspection frequencies, meeting schedules, response times, etc.)
                            that will be created and attached separately.
                        </p>

                        <div class="alert alert-info border-0 d-inline-block text-start" style="max-width: 600px;">
                            <div class="d-flex align-items-start">
                                <i class="ri-lightbulb-line fs-4 me-3 text-warning"></i>
                                <div>
                                    <h6 class="alert-heading mb-2">Implementation Note</h6>
                                    <p class="mb-2 small">
                                        Configuration management will be implemented as a separate feature that allows:
                                    </p>
                                    <ul class="mb-0 small">
                                        <li>Creating type-specific configs for individual teams</li>
                                        <li>Different teams of the same type having different settings</li>
                                        <li>Viewing and updating existing configurations</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </text>
            },

            // ========== TAB 3: Team Members ==========
            new OSHManagement.Models.ViewModels.TabConfig
            {
                TabId = "members",
                Title = "Team Members",
                Icon = "ri-team-line",
                Content = @<text>
                    <div id="editTeamMembersContainer">
                        <partial name="~/Views/Team/_EditTeamMembersByRole.cshtml" />
                    </div>
                </text>
            },

            // ========== TAB 4: Type-Specific Settings ==========
            new OSHManagement.Models.ViewModels.TabConfig
            {
                TabId = "typeSettings",
                Title = "Type Settings",
                Icon = "ri-settings-4-line",
                Content = @<text>
                    <div class="alert alert-info border-0">
                        <div class="d-flex align-items-start">
                            <i class="ri-information-line fs-4 me-3"></i>
                            <div>
                                <h6 class="alert-heading">Type-Specific Settings</h6>
                                <p class="mb-2">
                                    Extended configuration for @teamTypeName teams will be available here:
                                </p>
                                @if (teamTypeName.Contains("OSH") || teamTypeName.Contains("Committee"))
                                {
                                    <ul class="mb-0">
                                        <li>Training dates and status</li>
                                        <li>Inspection frequency and schedules</li>
                                        <li>Meeting schedules</li>
                                        <li>Next inspection date</li>
                                    </ul>
                                }
                                else if (teamTypeName.Contains("Investigation"))
                                {
                                    <ul class="mb-0">
                                        <li>Investigation scope</li>
                                        <li>Team expertise areas</li>
                                        <li>Response time requirements</li>
                                        <li>Escalation thresholds</li>
                                    </ul>
                                }
                                else if (teamTypeName.Contains("Risk") || teamTypeName.Contains("Assessment"))
                                {
                                    <ul class="mb-0">
                                        <li>Assessment frequency</li>
                                        <li>Team qualifications</li>
                                        <li>Next assessment date</li>
                                        <li>Assessment methodologies</li>
                                    </ul>
                                }
                            </div>
                        </div>
                    </div>
                </text>
            },

            // ========== TAB 5: Activity Log ==========
            new OSHManagement.Models.ViewModels.TabConfig
            {
                TabId = "activityLog",
                Title = "Activity Log",
                Icon = "ri-history-line",
                Content = @<text>
                    <div class="alert alert-info border-0">
                        <div class="d-flex align-items-start">
                            <i class="ri-information-line fs-4 me-3"></i>
                            <div>
                                <h6 class="alert-heading">Team Activity Log</h6>
                                <p class="mb-0">
                                    Team activity history and audit trail will be displayed here. This will include:
                                </p>
                                <ul class="mb-0 mt-2">
                                    <li>Team creation and modification history</li>
                                    <li>Member additions and removals</li>
                                    <li>Configuration changes</li>
                                    <li>Status changes</li>
                                    <li>Related activities (meetings, inspections, etc.)</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </text>
            }
        }
    };

    // Build tabs
    var tabs = tabsConfig.BuildTabs();
}

<!-- Render form with tabs -->
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="TeamId" />
    <input type="hidden" asp-for="TeamTypeDefinitionId" />
    <input type="hidden" asp-for="CreatedAt" />

    <partial name="~/Views/Shared/Components/Tabs/VerticalTabs.cshtml" model="tabs" />
</form>

<!-- Member Assignment Modal -->
<partial name="~/Views/Team/_AssignMemberToRoleModal.cshtml" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // ========== GLOBAL VARIABLES FOR TEAM EDIT ==========
        let teamId = @Model.TeamId;
        let teamRoleDefinitions = [];
        let assignedMembers = []; // Current team members
        let availableEmployees = [];
        let selectedStationId = @Model.StationId;
        let selectedTeamTypeId = @(Model.TeamTypeDefinitionId ?? 0);
        let sectionsData = @Html.Raw(Json.Serialize(ViewBag.Sections ?? new List<object>()));
        let educationLevels = @Html.Raw(Json.Serialize(ViewBag.EducationLevels ?? new List<object>()));
        let existingMembers = @Html.Raw(Json.Serialize(ViewBag.CurrentMembers ?? new List<object>()));

        $(document).ready(function() {
            console.log('Team Edit - With Member Management');
            console.log('Team ID:', teamId);
            console.log('Team Type ID:', selectedTeamTypeId);
            console.log('Station ID:', selectedStationId);
            console.log('Existing Members:', existingMembers);

            // Initialize education levels dropdown
            populateEducationLevels();

            // Load employees for the station
            if (selectedStationId) {
                loadEmployeesForStation(selectedStationId);
            }

            // Load role definitions for the team type
            if (selectedTeamTypeId) {
                loadRoleDefinitions(selectedTeamTypeId);
            }

            // Listen for tab changes to initialize members tab
            $(document).on('click', '[data-bs-toggle="tab"]', function(e) {
                const targetId = $(this).attr('data-bs-target');

                if (targetId === '#members-tab-pane' || targetId && targetId.includes('members')) {
                    setTimeout(function() {
                        if (selectedTeamTypeId && teamRoleDefinitions.length === 0) {
                            loadRoleDefinitions(selectedTeamTypeId);
                        }
                    }, 100);
                }
            });

            // Form validation
            $('form').on('submit', function(e) {
                if (!$(this).valid()) {
                    e.preventDefault();

                    if (typeof toastr !== 'undefined') {
                        toastr.error('Please correct the errors before saving.', 'Validation Error');
                    }

                    return false;
                }

                // Note: Member changes are saved via AJAX, not form submission
                // Only basic team info is saved via form
            });
        });

        // ========== LOAD ROLE DEFINITIONS ==========
        function loadRoleDefinitions(teamTypeId) {
            $('#editRolesLoadingState').show();
            $('#editNoRolesDefined').hide();
            $('#editRolesAccordion').hide();

            $.ajax({
                url: '/Team/GetAvailableRoles',
                type: 'GET',
                data: { teamTypeDefinitionId: teamTypeId },
                success: function(data) {
                    teamRoleDefinitions = data;
                    $('#editRolesLoadingState').hide();

                    if (data && data.length > 0) {
                        // Load existing members into assignedMembers array
                        loadExistingMembers();

                        renderRoleAccordions();
                        updateOverallProgress();
                        $('#editRolesAccordion').show();
                    } else {
                        $('#editNoRolesDefined').show();
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Failed to load role definitions:', error);
                    $('#editRolesLoadingState').hide();
                    $('#editNoRolesDefined').show();
                }
            });
        }

        // ========== LOAD EXISTING MEMBERS ==========
        function loadExistingMembers() {
            assignedMembers = [];

            if (existingMembers && existingMembers.length > 0) {
                existingMembers.forEach(member => {
                    assignedMembers.push({
                        memberId: member.MemberId,
                        roleId: member.TeamRoleDefinitionId,
                        roleName: member.RoleName,
                        employeePayroll: member.EmployeePayroll,
                        employeeName: member.EmployeeName,
                        designation: member.Designation,
                        appointmentDate: member.AppointmentDate,
                        sectionId: member.SectionId,
                        sectionName: member.SectionName,
                        isVoting: member.IsVotingMember,
                        educationLevel: member.EducationLevel,
                        relevantExperience: member.RelevantExperience
                    });
                });

                console.log('Loaded', assignedMembers.length, 'existing members');
            }
        }

        // ========== REUSE FUNCTIONS FROM CREATE ==========
        // Copy all the functions from Create.cshtml here for member management

        function renderRoleAccordions() {
            const accordion = $('#editRolesAccordion');
            accordion.empty();

            teamRoleDefinitions.forEach((role, index) => {
                const roleMembers = assignedMembers.filter(m => m.roleId === role.teamRoleDefinitionId);
                const currentCount = roleMembers.length;
                const minCount = role.minOccurrences || 0;
                const maxCount = role.maxOccurrences || '∞';

                let statusClass = '';
                let statusBadge = '';
                if (role.maxOccurrences && currentCount > role.maxOccurrences) {
                    statusClass = 'role-overfilled';
                    statusBadge = '<span class="badge bg-danger">Overfilled</span>';
                } else if (role.minOccurrences && currentCount >= role.minOccurrences) {
                    statusClass = 'role-complete';
                    statusBadge = '<span class="badge bg-success">Complete</span>';
                } else if (role.minOccurrences && currentCount < role.minOccurrences) {
                    statusClass = 'role-incomplete';
                    statusBadge = '<span class="badge bg-warning">Required</span>';
                }

                const accordionId = `editRoleAccordion_${role.teamRoleDefinitionId}`;
                const collapseId = `editRoleCollapse_${role.teamRoleDefinitionId}`;
                const isFirst = index === 0;

                // Check if this is a max=1 role with member assigned (for "Change Member" button)
                const isMaxOneRole = role.maxOccurrences === 1;
                const hasMaxOneMember = isMaxOneRole && currentCount === 1;

                let actionButton = '';
                if (hasMaxOneMember) {
                    // Show "Change Member" button instead of "Add Member"
                    actionButton = `
                        <button type="button" class="btn btn-sm btn-warning"
                                onclick="changeMemberInRole(${role.teamRoleDefinitionId})">
                            <i class="ri-repeat-line me-1"></i>Change ${role.roleName}
                        </button>
                    `;
                } else if (role.maxOccurrences && currentCount >= role.maxOccurrences) {
                    // Max capacity reached
                    actionButton = `
                        <button type="button" class="btn btn-sm btn-primary" disabled>
                            <i class="ri-user-add-line me-1"></i>Max Capacity Reached
                        </button>
                    `;
                } else {
                    // Show normal "Add Member" button
                    actionButton = `
                        <button type="button" class="btn btn-sm btn-primary"
                                onclick="openAssignMemberModal(${role.teamRoleDefinitionId})">
                            <i class="ri-user-add-line me-1"></i>Add Member to ${role.roleName}
                        </button>
                    `;
                }

                let html = `
                    <div class="accordion-item role-accordion-item ${statusClass}" id="${accordionId}">
                        <h2 class="accordion-header">
                            <button class="accordion-button ${isFirst ? '' : 'collapsed'}" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#${collapseId}"
                                    aria-expanded="${isFirst ? 'true' : 'false'}">
                                <div class="d-flex justify-content-between align-items-center w-100 me-3">
                                    <div class="flex-fill">
                                        <div class="fw-semibold">${role.roleName}</div>
                                        ${role.description ? `<small class="text-muted">${role.description}</small>` : ''}
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-primary role-badge-count">
                                            ${currentCount} / ${maxCount}
                                        </span>
                                        ${statusBadge}
                                    </div>
                                </div>
                            </button>
                        </h2>
                        <div id="${collapseId}" class="accordion-collapse collapse ${isFirst ? 'show' : ''}"
                             data-bs-parent="#editRolesAccordion">
                            <div class="accordion-body">
                                <div class="mb-3 p-2 bg-light rounded">
                                    <div class="row g-2 fs-12">
                                        <div class="col-auto">
                                            <span class="text-muted">Min:</span> <strong>${minCount}</strong>
                                        </div>
                                        <div class="col-auto">
                                            <span class="text-muted">Max:</span> <strong>${maxCount}</strong>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    ${actionButton}
                                </div>

                                <div id="editRoleMembers_${role.teamRoleDefinitionId}">
                                    ${renderRoleMembers(role.teamRoleDefinitionId)}
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                accordion.append(html);
            });
        }

        function renderRoleMembers(roleId) {
            const roleMembers = assignedMembers.filter(m => m.roleId === roleId);

            if (roleMembers.length === 0) {
                return `
                    <div class="edit-empty-role-state">
                        <i class="ri-user-add-line fs-2 d-block mb-2"></i>
                        <p class="mb-0">No members assigned to this role yet</p>
                    </div>
                `;
            }

            let html = '';
            roleMembers.forEach(member => {
                const initials = getInitials(member.employeeName);
                const avatarColor = getAvatarColor(member.employeePayroll);

                html += `
                    <div class="edit-member-card" data-member-payroll="${member.employeePayroll}">
                        <div class="d-flex align-items-center">
                            <div class="edit-member-avatar" style="background: ${avatarColor};">
                                ${initials}
                            </div>
                            <div class="flex-fill ms-3">
                                <div class="fw-semibold">${member.employeeName}</div>
                                <div class="fs-12 text-muted">
                                    <i class="ri-user-line me-1"></i>${member.employeePayroll}
                                    ${member.designation ? ` • ${member.designation}` : ''}
                                </div>
                                ${member.isVoting ? '<span class="badge bg-success-transparent role-info-badge mt-1"><i class="ri-checkbox-circle-line me-1"></i>Voting</span>' : ''}
                                ${member.sectionName ? `<span class="badge bg-info-transparent role-info-badge mt-1"><i class="ri-building-line me-1"></i>${member.sectionName}</span>` : ''}
                            </div>
                            <button type="button" class="btn btn-sm btn-danger remove-member-btn"
                                    onclick="removeMemberFromRole('${member.employeePayroll}', ${member.roleId}, ${member.memberId || 0})">
                                <i class="ri-close-line"></i>
                            </button>
                        </div>
                    </div>
                `;
            });

            return html;
        }

        // ========== CHANGE MEMBER FUNCTION (for max=1 roles) ==========
        function changeMemberInRole(roleId) {
            const role = teamRoleDefinitions.find(r => r.teamRoleDefinitionId === roleId);
            const currentMembers = assignedMembers.filter(m => m.roleId === roleId);

            if (currentMembers.length === 0) {
                openAssignMemberModal(roleId);
                return;
            }

            const currentMember = currentMembers[0];

            // Confirm replacement
            if (confirm(`Replace ${currentMember.employeeName} as ${role.roleName}? The current member will be removed and you can select a new one.`)) {
                // Remove current member first
                removeMemberFromRole(currentMember.employeePayroll, roleId, currentMember.memberId);

                // Then open modal to add new member
                setTimeout(() => {
                    openAssignMemberModal(roleId);
                }, 500);
            }
        }

        // Include all other functions from Create.cshtml
        // (loadEmployeesForStation, openAssignMemberModal, displayEmployeesInModal, etc.)
        // For brevity, I'll include the key ones:

        function loadEmployeesForStation(stationId) {
            $.ajax({
                url: '/Team/SearchEmployees',
                type: 'GET',
                data: { stationId: stationId, searchTerm: '', teamId: teamId },
                success: function(data) {
                    availableEmployees = data;
                    console.log(`Loaded ${data.length} employees for station ${stationId}`);
                },
                error: function(xhr, status, error) {
                    console.error('Failed to load employees:', error);
                }
            });
        }

        function removeMemberFromRole(payrollNo, roleId, memberId) {
            if (!confirm('Are you sure you want to remove this member from the team?')) {
                return;
            }

            // If member exists in database (has memberId), call server to remove
            if (memberId && memberId > 0) {
                $.ajax({
                    url: '/Team/RemoveMember',
                    type: 'POST',
                    data: {
                        teamId: teamId,
                        memberId: memberId
                    },
                    success: function(response) {
                        if (response.success) {
                            // Remove from array
                            const memberIndex = assignedMembers.findIndex(m => m.memberId === memberId);
                            if (memberIndex > -1) {
                                const member = assignedMembers[memberIndex];
                                assignedMembers.splice(memberIndex, 1);

                                renderRoleAccordions();
                                updateOverallProgress();

                                if (typeof toastr !== 'undefined') {
                                    toastr.success(`${member.employeeName} removed from team`);
                                }
                            }
                        } else {
                            if (typeof toastr !== 'undefined') {
                                toastr.error(response.message || 'Failed to remove member');
                            }
                        }
                    },
                    error: function() {
                        if (typeof toastr !== 'undefined') {
                            toastr.error('Failed to remove member');
                        }
                    }
                });
            } else {
                // New member not yet saved, just remove from array
                const memberIndex = assignedMembers.findIndex(m => m.employeePayroll === payrollNo && m.roleId === roleId);
                if (memberIndex > -1) {
                    const member = assignedMembers[memberIndex];
                    assignedMembers.splice(memberIndex, 1);

                    renderRoleAccordions();
                    updateOverallProgress();

                    if (typeof toastr !== 'undefined') {
                        toastr.info(`${member.employeeName} removed`);
                    }
                }
            }
        }

        function updateOverallProgress() {
            const totalMembers = assignedMembers.length;
            $('#editTotalMembersNumber').text(totalMembers);

            let requiredRolesFilled = 0;
            let totalRequiredRoles = 0;

            teamRoleDefinitions.forEach(role => {
                if (role.minOccurrences && role.minOccurrences > 0) {
                    totalRequiredRoles++;
                    const currentCount = assignedMembers.filter(m => m.roleId === role.teamRoleDefinitionId).length;
                    if (currentCount >= role.minOccurrences) {
                        requiredRolesFilled++;
                    }
                }
            });

            $('#editRequiredRolesFilled').text(requiredRolesFilled);
            $('#editTotalRequiredRoles').text(totalRequiredRoles);

            const progress = totalRequiredRoles > 0 ? (requiredRolesFilled / totalRequiredRoles) * 100 : 0;
            $('#editOverallProgressBar').css('width', progress + '%');
        }

        function getInitials(name) {
            if (!name) return '?';
            const parts = name.split(' ');
            if (parts.length >= 2) {
                return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
            }
            return name.substring(0, 2).toUpperCase();
        }

        function getAvatarColor(payrollNo) {
            const colors = [
                'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
                'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)',
                'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)',
                'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)',
                'linear-gradient(135deg, #fa709a 0%, #fee140 100%)',
                'linear-gradient(135deg, #30cfd0 0%, #330867 100%)',
                'linear-gradient(135deg, #a8edea 0%, #fed6e3 100%)',
                'linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%)'
            ];
            const hash = (payrollNo || '').split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
            return colors[hash % colors.length];
        }

        function populateEducationLevels() {
            const select = $('#memberEducationLevel');
            select.empty().append('<option value="">-- Select --</option>');

            if (educationLevels && educationLevels.length > 0) {
                educationLevels.forEach(level => {
                    select.append(`<option value="${level}">${level}</option>`);
                });
            }
        }

        // ========== MODAL MANAGEMENT ==========
        function openAssignMemberModal(roleId) {
            const role = teamRoleDefinitions.find(r => r.teamRoleDefinitionId === roleId);
            if (!role) return;

            // Set modal title and info
            $('#modalRoleName').text(role.roleName);
            $('#selectedRoleId').val(roleId);

            // Set role info
            $('#roleDescription').text(role.description || role.roleName);
            let requirements = [];
            if (role.requiresVotingRights) requirements.push('Voting rights required');
            if (role.requiredQualifications) requirements.push(role.requiredQualifications);
            if (role.minOccurrences) requirements.push(`Min: ${role.minOccurrences} member(s)`);
            if (role.maxOccurrences) requirements.push(`Max: ${role.maxOccurrences} member(s)`);
            $('#roleRequirements').html(requirements.join(' • '));

            // Set current count
            const currentCount = assignedMembers.filter(m => m.roleId === roleId).length;
            $('#currentRoleCount').text(currentCount);
            $('#maxRoleCount').text(role.maxOccurrences || '∞');

            // Auto-check voting if required
            $('#memberIsVoting').prop('checked', role.requiresVotingRights);

            // Set default appointment date
            $('#memberAppointmentDate').val(new Date().toISOString().split('T')[0]);

            // Populate sections for selected station
            populateSections();

            // Load and display employees
            displayEmployeesInModal();

            // Clear previous selection
            clearEmployeeSelection();

            // Show modal
            const modal = new bootstrap.Modal(document.getElementById('assignMemberModal'));
            modal.show();
        }

        function displayEmployeesInModal() {
            const container = $('#employeeListContent');
            $('#employeesLoadingState').show();
            $('#noEmployeesFound').hide();
            container.empty();

            if (!availableEmployees || availableEmployees.length === 0) {
                $('#employeesLoadingState').hide();
                $('#noEmployeesFound').show();
                return;
            }

            // Filter out already assigned employees
            const assignedPayrolls = assignedMembers.map(m => m.employeePayroll);
            const availableForSelection = availableEmployees.filter(e => !assignedPayrolls.includes(e.payrollNo));

            if (availableForSelection.length === 0) {
                $('#employeesLoadingState').hide();
                container.html('<div class="text-center text-muted py-3">All employees from this station have been assigned</div>');
                return;
            }

            // Group by department
            const grouped = {};
            availableForSelection.forEach(emp => {
                const dept = emp.departmentName || 'No Department';
                if (!grouped[dept]) grouped[dept] = [];
                grouped[dept].push(emp);
            });

            let html = '';
            Object.keys(grouped).sort().forEach(dept => {
                html += `<div class="department-group-header"><i class="ri-building-2-line me-1"></i>${dept}</div>`;

                grouped[dept].forEach(emp => {
                    const initials = getInitials(emp.fullName);
                    const avatarColor = getAvatarColor(emp.payrollNo);

                    html += `
                        <div class="employee-item" onclick="selectEmployee('${emp.payrollNo}', '${emp.fullName}', '${emp.designation || ''}')">
                            <div class="d-flex align-items-center">
                                <div class="employee-avatar-sm" style="background: ${avatarColor};">
                                    ${initials}
                                </div>
                                <div class="flex-fill ms-2">
                                    <div class="fw-medium">${emp.fullName}</div>
                                    <small class="text-muted">${emp.payrollNo}${emp.designation ? ' • ' + emp.designation : ''}</small>
                                </div>
                            </div>
                        </div>
                    `;
                });
            });

            container.html(html);
            $('#employeesLoadingState').hide();

            // Setup search
            $('#employeeSearchInput').off('keyup').on('keyup', function() {
                const searchTerm = $(this).val().toLowerCase();
                $('.employee-item').each(function() {
                    const text = $(this).text().toLowerCase();
                    $(this).toggle(text.includes(searchTerm));
                });
            });
        }

        function selectEmployee(payrollNo, fullName, designation) {
            $('.employee-item').removeClass('selected');
            $(event.currentTarget).addClass('selected');

            $('#selectedEmployeePayrollNo').val(payrollNo);
            $('#selectedEmployeeName').text(fullName);
            $('#selectedEmployeePayroll').text(payrollNo);
            $('#selectedEmployeePreview').show();
            $('#additionalDetailsSection').show();
            $('#assignMemberButton').prop('disabled', false);

            // Store for later use
            window.selectedEmployeeData = { payrollNo, fullName, designation };
        }

        function clearEmployeeSelection() {
            $('.employee-item').removeClass('selected');
            $('#selectedEmployeePayrollNo').val('');
            $('#selectedEmployeePreview').hide();
            $('#additionalDetailsSection').hide();
            $('#assignMemberButton').prop('disabled', true);
            $('#employeeSearchInput').val('');
            window.selectedEmployeeData = null;
        }

        function assignMemberToRole() {
            const roleId = parseInt($('#selectedRoleId').val());
            const payrollNo = $('#selectedEmployeePayrollNo').val();

            if (!roleId || !payrollNo || !window.selectedEmployeeData) {
                alert('Please select an employee');
                return;
            }

            const role = teamRoleDefinitions.find(r => r.teamRoleDefinitionId === roleId);
            const currentCount = assignedMembers.filter(m => m.roleId === roleId).length;

            // Validate max occurrences
            if (role.maxOccurrences && currentCount >= role.maxOccurrences) {
                alert(`This role can only have ${role.maxOccurrences} member(s)`);
                return;
            }

            // Get section name if selected
            const sectionId = $('#memberSectionId').val();
            const sectionName = sectionId ? $('#memberSectionId option:selected').text() : null;

            // Create member object
            const member = {
                memberId: 0, // New member, no ID yet
                roleId: roleId,
                roleName: role.roleName,
                employeePayroll: payrollNo,
                employeeName: window.selectedEmployeeData.fullName,
                designation: window.selectedEmployeeData.designation,
                appointmentDate: $('#memberAppointmentDate').val(),
                sectionId: sectionId || null,
                sectionName: sectionName,
                isVoting: $('#memberIsVoting').is(':checked'),
                educationLevel: $('#memberEducationLevel').val() || null,
                relevantExperience: $('#memberRelevantExperience').val() || null
            };

            // Save to database via AJAX
            $.ajax({
                url: '/Team/AddMember',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    TeamId: teamId,
                    EmployeePayroll: member.employeePayroll,
                    TeamRoleDefinitionId: member.roleId,
                    SectionId: member.sectionId,
                    AppointmentDate: member.appointmentDate,
                    IsVotingMember: member.isVoting,
                    EducationLevel: member.educationLevel,
                    RelevantExperience: member.relevantExperience
                }),
                success: function(response) {
                    if (response.success) {
                        // Update member with server-generated ID
                        member.memberId = response.memberId;

                        // Add to assigned members
                        assignedMembers.push(member);

                        console.log('Member added:', member);

                        // Refresh UI
                        renderRoleAccordions();
                        updateOverallProgress();

                        // Close modal
                        bootstrap.Modal.getInstance(document.getElementById('assignMemberModal')).hide();

                        // Reset modal
                        clearEmployeeSelection();

                        // Show success message
                        if (typeof toastr !== 'undefined') {
                            toastr.success(`${member.employeeName} assigned to ${role.roleName}`);
                        }
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(response.message || 'Failed to add member');
                        }
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Failed to add member:', error);
                    if (typeof toastr !== 'undefined') {
                        toastr.error('Failed to add member. Please try again.');
                    }
                }
            });
        }

        function populateSections() {
            const select = $('#memberSectionId');
            select.empty().append('<option value="">-- No Section --</option>');

            // Filter sections by selected station
            if (selectedStationId && sectionsData) {
                const stationSections = sectionsData.filter(s => s.stationId == selectedStationId);
                stationSections.forEach(section => {
                    select.append(`<option value="${section.sectionId}">${section.sectionName}</option>`);
                });
            }
        }
    </script>
}
