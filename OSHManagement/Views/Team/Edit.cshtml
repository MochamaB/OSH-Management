</form>

<!-- Add/Edit Member Modal -->
<div class="modal fade" id="memberModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="memberModalTitle">Add Team Member</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="memberForm">
                    <input type="hidden" id="memberId" name="memberId" value="0" />
                    <input type="hidden" id="teamId" name="teamId" value="@Model.TeamId" />

                    <!-- Role Selection -->
                    <div class="mb-3">
                        <label for="roleId" class="form-label">Role <span class="text-danger">*</span></label>
                        <select class="form-select" id="roleId" name="roleId" required>
                            <option value="">-- Select Role --</option>
                        </select>
                        <div id="roleInfo" class="mt-2" style="display: none;">
                            <div class="alert alert-info alert-permanent mb-0">
                                <div class="d-flex align-items-start">
                                    <i class="ri-information-line me-2 mt-1"></i>
                                    <div class="flex-fill">
                                        <div id="roleDescription" class="mb-1"></div>
                                        <div id="roleRequirements" class="fs-12"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Employee Selection -->
                    <div class="mb-3">
                        <label class="form-label">Employee <span class="text-danger">*</span></label>
                        <input type="hidden" id="employeePayroll" name="employeePayroll" required />

                        <!-- Search Filter -->
                        <div class="mb-2">
                            <input type="text" class="form-control" id="employeeSearch" placeholder="Search by name or payroll number..." />
                        </div>

                        <!-- Employee List -->
                        <div id="employeeListContainer" style="max-height: 300px; overflow-y: auto; border: 1px solid var(--bs-border-color); border-radius: 0.375rem; padding: 0.5rem 1.5rem;">
                            <div class="text-center text-muted py-3">
                                <div class="spinner-border spinner-border-sm" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="mb-0 mt-2">Loading employees...</p>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="appointmentDate" class="form-label">Appointment Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="appointmentDate" name="appointmentDate" required />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="sectionId" class="form-label">Section</label>
                            <select class="form-select" id="sectionId" name="sectionId">
                                <option value="">-- No Section --</option>
                            </select>
                            <div class="form-text">Optional: Assign member to specific section</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isVotingMember" name="isVotingMember" />
                            <label class="form-check-label" for="isVotingMember">
                                Voting Rights
                            </label>
                        </div>
                        <div class="form-text">Grant this member voting rights in team decisions</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="educationLevel" class="form-label">Education Level</label>
                            <input type="text" class="form-control" id="educationLevel" name="educationLevel" maxlength="50" placeholder="e.g., Bachelor's Degree" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="relevantExperience" class="form-label">Relevant Experience</label>
                            <input type="text" class="form-control" id="relevantExperience" name="relevantExperience" maxlength="200" placeholder="Years of experience, certifications, etc." />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveMember()">
                    <i class="ri-save-line me-1"></i>Save Member
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const teamId = @Model.TeamId;
        const teamType = '@Model.TeamType';
        const stationId = @Model.StationId;
        let roleDefinitions = [];
        let employeeSearchTimeout;

        $(document).ready(function() {
            // Load role definitions, sections, and employees
            loadRoleDefinitions();
            loadSections();
            loadEmployees();
        });

        // Load available roles for this team type
        function loadRoleDefinitions() {
            $.ajax({
                url: '/Team/GetAvailableRoles',
                type: 'GET',
                data: { teamId: teamId, teamType: teamType },
                success: function(data) {
                    roleDefinitions = data;
                    populateRoleDropdown();
                },
                error: function() {
                    toastr.error('Failed to load role definitions');
                }
            });
        }

        // Populate role dropdown with current counts
        function populateRoleDropdown() {
            const roleSelect = $('#roleId');
            roleSelect.empty().append('<option value="">-- Select Role --</option>');

            roleDefinitions.forEach(function(role) {
                const currentCount = role.currentCount || 0;
                const maxCount = role.maxOccurrences || '∞';
                const isDisabled = role.maxOccurrences && currentCount >= role.maxOccurrences;

                let optionText = `${role.roleName} (${currentCount}/${maxCount})`;

                if (isDisabled) {
                    optionText += ' - Full';
                } else if (role.minOccurrences && currentCount < role.minOccurrences) {
                    optionText += ' ⚠️ Required';
                }

                const option = $('<option></option>')
                    .val(role.teamRoleDefinitionId)
                    .text(optionText)
                    .prop('disabled', isDisabled)
                    .data('role', role);

                roleSelect.append(option);
            });
        }

        // Handle role selection
        $('#roleId').on('change', function() {
            const selectedOption = $(this).find('option:selected');
            const role = selectedOption.data('role');

            if (role) {
                // Auto-check voting rights if role requires it
                $('#isVotingMember').prop('checked', role.requiresVotingRights);

                // Show role information
                let infoHtml = '';
                if (role.description) {
                    infoHtml += `<strong>${role.roleName}:</strong> ${role.description}<br>`;
                }

                let requirements = [];
                if (role.requiresVotingRights) {
                    requirements.push('Voting rights required');
                }
                if (role.requiredQualifications) {
                    requirements.push(role.requiredQualifications);
                }
                if (role.minOccurrences) {
                    requirements.push(`Min: ${role.minOccurrences} member(s)`);
                }
                if (role.maxOccurrences) {
                    requirements.push(`Max: ${role.maxOccurrences} member(s)`);
                }

                if (requirements.length > 0) {
                    infoHtml += requirements.join(' • ');
                }

                if (infoHtml) {
                    $('#roleDescription').html(infoHtml);
                    $('#roleInfo').show();
                } else {
                    $('#roleInfo').hide();
                }
            } else {
                $('#roleInfo').hide();
            }
        });

        // Load sections for the team's station
        function loadSections() {
            $.ajax({
                url: '/Team/GetSectionsByStation',
                type: 'GET',
                data: { stationId: stationId },
                success: function(data) {
                    const sectionSelect = $('#sectionId');
                    sectionSelect.empty().append('<option value="">-- No Section --</option>');

                    data.forEach(function(section) {
                        sectionSelect.append($('<option></option>')
                            .val(section.sectionId)
                            .text(section.sectionName));
                    });
                },
                error: function() {
                    console.error('Failed to load sections');
                }
            });
        }

        // Load all employees for this station
        let allEmployees = [];
        let existingMemberPayrolls = [];

        function loadEmployees() {
            $.ajax({
                url: '/Team/SearchEmployees',
                type: 'GET',
                data: {
                    stationId: stationId,
                    searchTerm: '', // Empty = get all
                    teamId: teamId
                },
                success: function(data) {
                    allEmployees = data;
                    displayEmployees();
                },
                error: function() {
                    $('#employeeListContainer').html('<div class="alert alert-danger mb-0"><i class="ri-error-warning-line me-2"></i>Failed to load employees</div>');
                }
            });

            // Also load existing team members to mark them as disabled
            $.ajax({
                url: '/Team/GetTeamMembers',
                type: 'GET',
                data: { teamId: teamId },
                success: function(data) {
                    existingMemberPayrolls = data.map(m => m.employeePayroll);
                    displayEmployees();
                }
            });
        }

        function displayEmployees() {
            if (allEmployees.length === 0) return;

            const container = $('#employeeListContainer');
            container.empty();

            if (allEmployees.length === 0) {
                container.html('<div class="text-center text-muted py-3">No employees found at this station</div>');
                return;
            }

            // Group by department
            const grouped = {};
            allEmployees.forEach(emp => {
                const dept = emp.departmentName || 'No Department';
                if (!grouped[dept]) grouped[dept] = [];
                grouped[dept].push(emp);
            });

            let html = '';
            Object.keys(grouped).sort().forEach(dept => {
                html += `<div class="mb-3">`;
                html += `<div class="fw-semibold text-muted mb-2" style="font-size: 0.85rem;"><i class="ri-building-2-line me-1"></i>${dept}</div>`;

                grouped[dept].forEach(emp => {
                    const isInTeam = existingMemberPayrolls.includes(emp.payrollNo);
                    const disabled = isInTeam ? 'disabled' : '';
                    const disabledClass = isInTeam ? 'opacity-50' : '';
                    const badgeHtml = isInTeam ? '<span class="badge bg-secondary ms-2">Already in team</span>' : '';

                    html += `
                        <div class="form-check mb-2 employee-radio-wrapper ${disabledClass}">
                            <input class="form-check-input employee-radio"
                                   type="radio"
                                   name="employeeRadio"
                                   value="${emp.payrollNo}"
                                   id="emp_${emp.payrollNo}"
                                   data-name="${emp.fullName}"
                                   data-designation="${emp.designation || ''}"
                                   ${disabled}>
                            <label class="form-check-label w-100" for="emp_${emp.payrollNo}">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="fw-medium">${emp.fullName}</span>
                                        <small class="text-muted d-block">${emp.payrollNo}${emp.designation ? ' • ' + emp.designation : ''}</small>
                                    </div>
                                    ${badgeHtml}
                                </div>
                            </label>
                        </div>
                    `;
                });
                html += `</div>`;
            });

            container.html(html);

            // Handle selection
            $('.employee-radio').on('change', function() {
                if ($(this).is(':checked')) {
                    $('#employeePayroll').val($(this).val());
                }
            });
        }

        // Employee search filter
        $('#employeeSearch').on('keyup', function() {
            const searchTerm = $(this).val().toLowerCase();

            $('.employee-radio-wrapper').each(function() {
                const name = $(this).find('.fw-medium').text().toLowerCase();
                const payroll = $(this).find('.text-muted').text().toLowerCase();

                if (name.includes(searchTerm) || payroll.includes(searchTerm)) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        });

        // Open modal for adding member
        function openAddMemberModal() {
            $('#memberModalTitle').text('Add Team Member');
            $('#memberForm')[0].reset();
            $('#memberId').val('0');
            $('#appointmentDate').val(new Date().toISOString().split('T')[0]);
            $('#employeePayroll').val('');
            $('.employee-radio').prop('checked', false);
            $('#employeeSearch').val('');
            $('#roleInfo').hide();

            const modal = new bootstrap.Modal(document.getElementById('memberModal'));
            modal.show();
        }

        // Edit member
        function editMember(memberId) {
            $.ajax({
                url: '/Team/GetMemberDetails',
                type: 'GET',
                data: { memberId: memberId },
                success: function(data) {
                    $('#memberModalTitle').text('Edit Team Member');
                    $('#memberId').val(data.memberId);
                    $('#roleId').val(data.teamRoleDefinitionId).trigger('change');
                    $('#employeePayroll').val(data.employeePayroll);
                    $('#appointmentDate').val(data.appointmentDate.split('T')[0]);
                    $('#sectionId').val(data.sectionId || '');
                    $('#isVotingMember').prop('checked', data.isVotingMember);
                    $('#educationLevel').val(data.educationLevel || '');
                    $('#relevantExperience').val(data.relevantExperience || '');

                    // Show selected employee
                    $('#selectedEmployeeName').text(data.employeeName);
                    $('#selectedEmployeePayroll').text(data.employeePayroll);
                    $('#selectedEmployee').show();

                    const modal = new bootstrap.Modal(document.getElementById('memberModal'));
                    modal.show();
                },
                error: function() {
                    toastr.error('Failed to load member details');
                }
            });
        }

        // Save member (add or update)
        function saveMember() {
            const form = $('#memberForm')[0];
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const memberData = {
                memberId: parseInt($('#memberId').val()),
                teamId: teamId,
                teamRoleDefinitionId: parseInt($('#roleId').val()),
                employeePayroll: $('#employeePayroll').val(),
                appointmentDate: $('#appointmentDate').val(),
                sectionId: $('#sectionId').val() ? parseInt($('#sectionId').val()) : null,
                isVotingMember: $('#isVotingMember').is(':checked'),
                educationLevel: $('#educationLevel').val(),
                relevantExperience: $('#relevantExperience').val()
            };

            const isEdit = memberData.memberId > 0;
            const url = isEdit ? '/Team/UpdateMember' : '/Team/AddMember';

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(memberData),
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        toastr.success(response.message);
                        bootstrap.Modal.getInstance(document.getElementById('memberModal')).hide();
                        location.reload(); // Reload to refresh member list and compliance
                    } else {
                        toastr.error(response.message);
                    }
                },
                error: function(xhr) {
                    const error = xhr.responseJSON?.message || 'An error occurred while saving the member';
                    toastr.error(error);
                }
            });
        }

        // Remove member
        function removeMember(memberId, memberName) {
            if (!confirm(`Are you sure you want to remove ${memberName} from this team?`)) {
                return;
            }

            $.ajax({
                url: '/Team/RemoveMember',
                type: 'POST',
                data: {
                    memberId: memberId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        toastr.success(response.message);
                        location.reload(); // Reload to refresh member list and compliance
                    } else {
                        toastr.error(response.message);
                    }
                },
                error: function(xhr) {
                    const error = xhr.responseJSON?.message || 'An error occurred while removing the member';
                    toastr.error(error);
                }
            });
        }
    </script>

    <style>
        .employee-radio-wrapper {
            padding: 0.5rem;
            border-radius: 0.375rem;
            transition: background-color 0.2s;
        }

        .employee-radio-wrapper:hover:not(.opacity-50) {
            background-color: var(--bs-light);
        }

        .employee-radio-wrapper .form-check-input:checked ~ label {
            color: var(--bs-primary);
            font-weight: 500;
        }

        .employee-radio-wrapper.opacity-50 {
            opacity: 0.5;
            cursor: not-allowed;
        }
    </style>
}
