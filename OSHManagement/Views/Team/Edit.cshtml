@using OSHManagement.Extensions
@model OSHManagement.Models.ViewModels.EditTeamViewModel
@{
    ViewData["Title"] = $"Edit Team - {Model.TeamName}";

    // Get current members
    var currentMembers = ViewBag.CurrentMembers as List<dynamic> ?? new List<dynamic>();

    // Get station name from ViewBag.Stations
    var stations = ViewBag.Stations as IEnumerable<dynamic>;
    var currentStation = stations?.FirstOrDefault(s => s.StationId == Model.StationId);
    var stationName = currentStation?.StationName ?? "Unknown Station";

    // Configure Vertical Tabs
    var tabsConfig = new OSHManagement.Models.ViewModels.TabsConfig
    {
        TabsId = "editTeamTabs",
        Type = OSHManagement.Models.ViewModels.TabsType.VerticalStyle1,
        NavColumnClass = "col-md-3",
        ContentColumnClass = "col-md-9",
        WrapInCard = true,
        CardTitle = $"Edit Team: {Model.TeamName}",
        CardSubtitle = $"{Model.TeamType} | {stationName}",

        Tabs = new List<OSHManagement.Models.ViewModels.TabConfig>
        {
            // ========== TAB 1: Basic Information ==========
            new OSHManagement.Models.ViewModels.TabConfig
            {
                TabId = "basicInfo",
                Title = "Basic Information",
                Icon = "ri-information-line",
                IsActive = true,
                Content = @<text>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TeamName" class="form-label"></label>
                            <input asp-for="TeamName" class="form-control" required />
                            <span asp-validation-for="TeamName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="TeamType" class="form-label"></label>
                            <input asp-for="TeamType" class="form-control" readonly />
                            <div class="form-text">Team type cannot be changed after creation</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="StationId" class="form-label"></label>
                            <select asp-for="StationId" class="form-select" disabled>
                                @if (ViewBag.Stations != null)
                                {
                                    foreach (var station in (IEnumerable<dynamic>)ViewBag.Stations)
                                    {
                                        <option value="@station.StationId" selected="@(station.StationId == Model.StationId)">
                                            @station.StationName
                                        </option>
                                    }
                                }
                            </select>
                            <div class="form-text">Station cannot be changed after creation</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="TeamStatus" class="form-label"></label>
                            <select asp-for="TeamStatus" class="form-select">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                                <option value="Suspended">Suspended</option>
                            </select>
                            <span asp-validation-for="TeamStatus" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="FormationDate" class="form-label"></label>
                            <input asp-for="FormationDate" type="date" class="form-control" />
                            <span asp-validation-for="FormationDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Created At</label>
                            <input type="text" class="form-control" value="@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")" readonly />
                        </div>
                        <div class="col-12 mb-3">
                            <label asp-for="TeamDescription" class="form-label"></label>
                            <textarea asp-for="TeamDescription" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="TeamDescription" class="text-danger"></span>
                        </div>
                    </div>
                </text>
            },

            // ========== TAB 2: Team Configuration ==========
            new OSHManagement.Models.ViewModels.TabConfig
            {
                TabId = "configuration",
                Title = "Configuration",
                Icon = "ri-settings-3-line",
                Content = @<text>
                    @{
                        var roleDefinitions = ViewBag.RoleDefinitions as List<dynamic> ?? new List<dynamic>();
                        var calculatedMinimum = ViewBag.CalculatedMinimum ?? 0;
                        var sectionCount = ViewBag.SectionCount ?? 0;
                        var totalMembers = currentMembers.Count;
                    }

                    <!-- Team-Level Settings -->
                    <div class="row mb-4">
                        <div class="col-12 mb-3">
                            <h6 class="fw-semibold text-primary">
                                <i class="ri-settings-3-line me-2"></i>Team-Level Settings
                            </h6>
                            <p class="text-muted fs-12">Configure overall team capacity and requirements</p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="RequiredMemberCount" class="form-label"></label>
                            <input asp-for="RequiredMemberCount" type="number" class="form-control" min="@calculatedMinimum" />
                            <span asp-validation-for="RequiredMemberCount" class="text-danger"></span>
                            <div class="form-text">
                                Minimum members required
                                @if (calculatedMinimum > 0)
                                {
                                    <span class="text-warning">(Role minimum: @calculatedMinimum)</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="MaxMemberCount" class="form-label"></label>
                            <input asp-for="MaxMemberCount" type="number" class="form-control" min="1" />
                            <span asp-validation-for="MaxMemberCount" class="text-danger"></span>
                            <div class="form-text">Maximum members allowed in team</div>
                        </div>
                        <div class="col-12 mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="RequiresSectionRepresentation" class="form-check-input" type="checkbox" />
                                <label asp-for="RequiresSectionRepresentation" class="form-check-label"></label>
                            </div>
                            <div class="form-text">Team must have members from different sections</div>
                        </div>
                    </div>

                    <!-- Role Requirements Summary -->
                    <div class="row mb-4">
                        <div class="col-12 mb-3">
                            <h6 class="fw-semibold text-primary">
                                <i class="ri-user-star-line me-2"></i>Role Requirements for @Model.TeamType
                            </h6>
                            <p class="text-muted fs-12">Based on active role definitions for this team type</p>
                        </div>

                        <div class="col-12">
                            @if (roleDefinitions.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Role</th>
                                                <th class="text-center">Current</th>
                                                <th class="text-center">Min</th>
                                                <th class="text-center">Max</th>
                                                <th class="text-center">Voting</th>
                                                <th class="text-center">Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var role in roleDefinitions)
                                            {
                                                var isFilled = role.MinOccurrences.HasValue && role.CurrentCount >= role.MinOccurrences;
                                                var isOverfilled = role.MaxOccurrences.HasValue && role.CurrentCount > role.MaxOccurrences;
                                                var statusClass = isOverfilled ? "danger" : (isFilled ? "success" : "warning");
                                                var statusIcon = isOverfilled ? "ri-error-warning-line" : (isFilled ? "ri-checkbox-circle-line" : "ri-alert-line");
                                                var statusText = isOverfilled ? "Over capacity" : (isFilled ? "Met" : "Needs filling");

                                                <tr>
                                                    <td>
                                                        <strong>@role.RoleName</strong>
                                                        @if (!string.IsNullOrEmpty(role.Description))
                                                        {
                                                            <br /><small class="text-muted">@role.Description</small>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-@statusClass-transparent fs-13">@role.CurrentCount</span>
                                                    </td>
                                                    <td class="text-center">@(role.MinOccurrences?.ToString() ?? "—")</td>
                                                    <td class="text-center">@(role.MaxOccurrences?.ToString() ?? "—")</td>
                                                    <td class="text-center">
                                                        @if (role.RequiresVotingRights)
                                                        {
                                                            <i class="ri-checkbox-circle-fill text-success"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="ri-close-circle-fill text-muted"></i>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-@statusClass-transparent">
                                                            <i class="@statusIcon me-1"></i>@statusText
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot class="table-light">
                                            <tr>
                                                <td><strong>Total</strong></td>
                                                <td class="text-center"><strong>@totalMembers</strong></td>
                                                <td class="text-center"><strong>@calculatedMinimum</strong></td>
                                                <td class="text-center">—</td>
                                                <td class="text-center">—</td>
                                                <td class="text-center">—</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning border-0">
                                    <i class="ri-alert-line me-2"></i>
                                    No role definitions found for <strong>@Model.TeamType</strong>.
                                    <a href="/TeamRoleDefinition/Index?teamType=@Model.TeamType" class="alert-link">Create role definitions</a> to enable role-based validation.
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Current Compliance -->
                    <div class="row">
                        <div class="col-12 mb-3">
                            <h6 class="fw-semibold text-primary">
                                <i class="ri-check-double-line me-2"></i>Current Compliance
                            </h6>
                        </div>

                        <div class="col-md-6 mb-3">
                            <div class="card border">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar avatar-md bg-primary-transparent me-3">
                                            <i class="ri-team-line fs-18"></i>
                                        </div>
                                        <div class="flex-fill">
                                            <h6 class="mb-1">Team Size</h6>
                                            <div class="d-flex align-items-center">
                                                <span class="fs-20 fw-semibold me-2">@totalMembers</span>
                                                @if (Model.MaxMemberCount.HasValue)
                                                {
                                                    <span class="text-muted">/ @Model.MaxMemberCount</span>
                                                }
                                            </div>
                                            @if (Model.RequiredMemberCount.HasValue)
                                            {
                                                var meetsMinimum = totalMembers >= Model.RequiredMemberCount.Value;
                                                <small class="text-@(meetsMinimum ? "success" : "danger")">
                                                    <i class="ri-@(meetsMinimum ? "checkbox" : "close")-circle-line me-1"></i>
                                                    Required: @Model.RequiredMemberCount
                                                </small>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (Model.RequiresSectionRepresentation)
                        {
                            <div class="col-md-6 mb-3">
                                <div class="card border">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar avatar-md bg-info-transparent me-3">
                                                <i class="ri-git-branch-line fs-18"></i>
                                            </div>
                                            <div class="flex-fill">
                                                <h6 class="mb-1">Section Diversity</h6>
                                                <div class="d-flex align-items-center">
                                                    <span class="fs-20 fw-semibold me-2">@sectionCount</span>
                                                    <span class="text-muted">sections</span>
                                                </div>
                                                <small class="text-@(sectionCount >= 2 ? "success" : "warning")">
                                                    <i class="ri-@(sectionCount >= 2 ? "checkbox" : "alert")-circle-line me-1"></i>
                                                    @(sectionCount >= 2 ? "Diverse representation" : "Need more sections")
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Validation Messages -->
                        <div class="col-12">
                            @{
                                var hasErrors = false;
                                var hasWarnings = false;
                            }

                            @if (Model.RequiredMemberCount.HasValue && totalMembers < Model.RequiredMemberCount.Value)
                            {
                                hasErrors = true;
                                <div class="alert alert-danger border-0">
                                    <i class="ri-error-warning-line me-2"></i>
                                    <strong>Error:</strong> Team has @totalMembers members but requires minimum @Model.RequiredMemberCount
                                </div>
                            }

                            @if (Model.MaxMemberCount.HasValue && totalMembers > Model.MaxMemberCount.Value)
                            {
                                hasErrors = true;
                                <div class="alert alert-danger border-0">
                                    <i class="ri-error-warning-line me-2"></i>
                                    <strong>Error:</strong> Team has @totalMembers members but maximum is @Model.MaxMemberCount
                                </div>
                            }

                            @if (calculatedMinimum > 0 && Model.RequiredMemberCount.HasValue && Model.RequiredMemberCount.Value < calculatedMinimum)
                            {
                                hasWarnings = true;
                                <div class="alert alert-warning border-0">
                                    <i class="ri-alert-line me-2"></i>
                                    <strong>Warning:</strong> Required member count (@Model.RequiredMemberCount) is less than role-based minimum (@calculatedMinimum)
                                </div>
                            }

                            @foreach (var role in roleDefinitions)
                            {
                                if (role.MinOccurrences.HasValue && role.CurrentCount < role.MinOccurrences)
                                {
                                    hasWarnings = true;
                                    <div class="alert alert-warning border-0">
                                        <i class="ri-alert-line me-2"></i>
                                        <strong>Warning:</strong> Role "@role.RoleName" has @role.CurrentCount member(s) but requires minimum @role.MinOccurrences
                                    </div>
                                }

                                if (role.MaxOccurrences.HasValue && role.CurrentCount > role.MaxOccurrences)
                                {
                                    hasErrors = true;
                                    <div class="alert alert-danger border-0">
                                        <i class="ri-error-warning-line me-2"></i>
                                        <strong>Error:</strong> Role "@role.RoleName" has @role.CurrentCount member(s) but maximum is @role.MaxOccurrences
                                    </div>
                                }
                            }

                            @if (Model.RequiresSectionRepresentation && sectionCount < 2)
                            {
                                hasWarnings = true;
                                <div class="alert alert-warning border-0">
                                    <i class="ri-alert-line me-2"></i>
                                    <strong>Warning:</strong> Team requires section representation but only has members from @sectionCount section(s)
                                </div>
                            }

                            @if (!hasErrors && !hasWarnings)
                            {
                                <div class="alert alert-success border-0">
                                    <i class="ri-checkbox-circle-line me-2"></i>
                                    <strong>All checks passed!</strong> Team configuration meets all requirements.
                                </div>
                            }
                        </div>
                    </div>
                </text>
            },

            // ========== TAB 3: Team Members ==========
            new OSHManagement.Models.ViewModels.TabConfig
            {
                TabId = "members",
                Title = "Team Members",
                Icon = "ri-team-line",
                Content = @<text>
                    @{
                        var roleDefinitions = ViewBag.RoleDefinitions as List<dynamic> ?? new List<dynamic>();
                    }

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="mb-0">Current Members (@currentMembers.Count)</h6>
                        <button type="button" class="btn btn-primary btn-sm" onclick="openAddMemberModal()">
                            <i class="ri-user-add-line me-1"></i>Add Member
                        </button>
                    </div>

                    <!-- Role Compliance Summary -->
                    @if (roleDefinitions.Any())
                    {
                        <div class="card border mb-3">
                            <div class="card-body">
                                <h6 class="card-title mb-3">Role Compliance</h6>
                                <div class="row g-2">
                                    @foreach (var role in roleDefinitions)
                                    {
                                        var isFilled = role.MinOccurrences.HasValue && role.CurrentCount >= role.MinOccurrences;
                                        var isOverfilled = role.MaxOccurrences.HasValue && role.CurrentCount > role.MaxOccurrences;
                                        var statusClass = isOverfilled ? "danger" : (isFilled ? "success" : "warning");

                                        <div class="col-md-4 col-sm-6">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar avatar-sm bg-@statusClass-transparent me-2">
                                                    <i class="ri-user-star-line"></i>
                                                </div>
                                                <div class="flex-fill">
                                                    <div class="fs-12 text-muted">@role.RoleName</div>
                                                    <div class="fw-semibold">
                                                        @role.CurrentCount
                                                        @if (role.MinOccurrences.HasValue || role.MaxOccurrences.HasValue)
                                                        {
                                                            <span class="text-muted fs-11">
                                                                (@(role.MinOccurrences?.ToString() ?? "0")-@(role.MaxOccurrences?.ToString() ?? "∞"))
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (currentMembers.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered" id="teamMembersTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>Employee</th>
                                        <th>Role</th>
                                        <th>Section</th>
                                        <th>Appointed</th>
                                        <th>Voting</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var member in currentMembers)
                                    {
                                        <tr data-member-id="@member.MemberId" data-role-id="@member.TeamRoleDefinitionId">
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar avatar-sm bg-primary-transparent me-2">
                                                        <i class="ri-user-line"></i>
                                                    </div>
                                                    <div>
                                                        <strong>@member.EmployeeName</strong><br>
                                                        <small class="text-muted">@member.EmployeePayroll</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary-transparent">
                                                    <i class="ri-user-star-line me-1"></i>@member.MemberRole
                                                </span>
                                            </td>
                                            <td>@(member.SectionId != null ? "Section assigned" : "—")</td>
                                            <td>@((DateTime)member.AppointmentDate).ToString("dd/MM/yyyy")</td>
                                            <td class="text-center">
                                                @if (member.IsVotingMember)
                                                {
                                                    <span class="badge bg-success-transparent">
                                                        <i class="ri-checkbox-circle-line me-1"></i>Yes
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-muted">
                                                        <i class="ri-close-circle-line me-1"></i>No
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-light" onclick="editMember(@member.MemberId)" title="Edit">
                                                    <i class="ri-edit-line"></i>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-danger" onclick="removeMember(@member.MemberId, '@member.EmployeeName')" title="Remove">
                                                    <i class="ri-user-unfollow-line"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning border-0">
                            <i class="ri-alert-line me-2"></i>
                            No members in this team yet. Click "Add Member" to add team members.
                        </div>
                    }
                </text>
            },

            // ========== TAB 4: Type-Specific Settings ==========
            new OSHManagement.Models.ViewModels.TabConfig
            {
                TabId = "typeSettings",
                Title = $"{Model.TeamType} Settings",
                Icon = "ri-file-settings-line",
                Content = @<text>
                    <div class="alert alert-info border-0 mb-3 alert-permanent">
                        <i class="ri-information-line me-2"></i>
                        <strong>Team Type:</strong> @Model.TeamType - Configure operational and compliance settings specific to this team type.
                    </div>

                    @if (Model.TeamType == "OSH Committee")
                    {
                        var config = ViewBag.OshCommitteeConfig;
                        var hasConfig = config != null;

                        <div class="row">
                            <div class="col-12 mb-3">
                                <h6 class="fw-semibold text-primary">
                                    <i class="ri-shield-check-line me-2"></i>OSH Committee Configuration
                                </h6>
                                <p class="text-muted fs-12">Training, meetings, and inspection requirements</p>
                            </div>

                            <input type="hidden" name="OshConfig.ConfigId" value="@(hasConfig ? config.ConfigId : 0)" />
                            <input type="hidden" name="OshConfig.TeamId" value="@Model.TeamId" />

                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input"
                                           name="OshConfig.IsCommitteeTrained"
                                           id="isCommitteeTrained"
                                           @(hasConfig && config.IsCommitteeTrained ? "checked" : "") />
                                    <label class="form-check-label" for="isCommitteeTrained">Committee Trained</label>
                                </div>
                                <div class="form-text">Has the committee received OSH training?</div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="trainingDate" class="form-label">Training Date</label>
                                <input type="date" class="form-control"
                                       name="OshConfig.TrainingDate"
                                       id="trainingDate"
                                       value="@(hasConfig && config.TrainingDate.HasValue ? config.TrainingDate.Value.ToString("yyyy-MM-dd") : "")" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input"
                                           name="OshConfig.HasMeetingSchedule"
                                           id="hasMeetingSchedule"
                                           @(hasConfig && config.HasMeetingSchedule ? "checked" : "") />
                                    <label class="form-check-label" for="hasMeetingSchedule">Has Meeting Schedule</label>
                                </div>
                                <div class="form-text">Does the committee have a regular meeting schedule?</div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="inspectionFrequency" class="form-label">Inspection Frequency</label>
                                <select class="form-select" name="OshConfig.InspectionFrequency" id="inspectionFrequency">
                                    <option value="">-- Select Frequency --</option>
                                    <option value="Weekly" @@(hasConfig && config.InspectionFrequency == "Weekly" ? "selected" : "")>Weekly</option>
                                    <option value="Monthly" @@(hasConfig && config.InspectionFrequency == "Monthly" ? "selected" : "")>Monthly</option>
                                    <option value="Quarterly" @@(hasConfig && config.InspectionFrequency == "Quarterly" ? "selected" : "")>Quarterly</option>
                                    <option value="Annually" @@(hasConfig && config.InspectionFrequency == "Annually" ? "selected" : "")>Annually</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="lastInspectionDate" class="form-label">Last Inspection Date</label>
                                <input type="date" class="form-control"
                                       name="OshConfig.LastInspectionDate"
                                       id="lastInspectionDate"
                                       value="@(hasConfig && config.LastInspectionDate.HasValue ? config.LastInspectionDate.Value.ToString("yyyy-MM-dd") : "")" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="nextInspectionDate" class="form-label">Next Inspection Date</label>
                                <input type="date" class="form-control"
                                       name="OshConfig.NextInspectionDate"
                                       id="nextInspectionDate"
                                       value="@(hasConfig && config.NextInspectionDate.HasValue ? config.NextInspectionDate.Value.ToString("yyyy-MM-dd") : "")" />
                            </div>
                        </div>
                    }
                    else if (Model.TeamType == "Risk Assessment")
                    {
                        var config = ViewBag.RiskAssessmentConfig;
                        var hasConfig = config != null;

                        <div class="row">
                            <div class="col-12 mb-3">
                                <h6 class="fw-semibold text-primary">
                                    <i class="ri-alert-line me-2"></i>Risk Assessment Configuration
                                </h6>
                                <p class="text-muted fs-12">Assessment frequency and team qualifications</p>
                            </div>

                            <input type="hidden" name="RiskConfig.ConfigId" value="@(hasConfig ? config.ConfigId : 0)" />
                            <input type="hidden" name="RiskConfig.TeamId" value="@Model.TeamId" />

                            <div class="col-md-6 mb-3">
                                <label for="assessmentFrequency" class="form-label">Assessment Frequency</label>
                                <select class="form-select" name="RiskConfig.AssessmentFrequency" id="assessmentFrequency">
                                    <option value="">-- Select Frequency --</option>
                                    <option value="Monthly" @@(hasConfig && config.AssessmentFrequency == "Monthly" ? "selected" : "")>Monthly</option>
                                    <option value="Quarterly" @@(hasConfig && config.AssessmentFrequency == "Quarterly" ? "selected" : "")>Quarterly</option>
                                    <option value="Semi-Annually" @@(hasConfig && config.AssessmentFrequency == "Semi-Annually" ? "selected" : "")>Semi-Annually</option>
                                    <option value="Annually" @@@(hasConfig && config.AssessmentFrequency == "As-Needed" ? "selected" : "")>As-Needed</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="lastAssessmentDate" class="form-label">Last Assessment Date</label>
                                <input type="date" class="form-control"
                                       name="RiskConfig.LastAssessmentDate"
                                       id="lastAssessmentDate"
                                       value="@(hasConfig && config.LastAssessmentDate.HasValue ? config.LastAssessmentDate.Value.ToString("yyyy-MM-dd") : "")" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="nextAssessmentDate" class="form-label">Next Assessment Date</label>
                                <input type="date" class="form-control"
                                       name="RiskConfig.NextAssessmentDate"
                                       id="nextAssessmentDate"
                                       value="@(hasConfig && config.NextAssessmentDate.HasValue ? config.NextAssessmentDate.Value.ToString("yyyy-MM-dd") : "")" />
                            </div>

                            <div class="col-12 mb-3">
                                <label for="teamQualifications" class="form-label">Team Qualifications</label>
                                <textarea class="form-control"
                                          name="RiskConfig.TeamQualifications"
                                          id="teamQualifications"
                                          rows="3"
                                          maxlength="500"
                                          placeholder="Describe the qualifications and expertise of team members">@(hasConfig ? config.TeamQualifications : "")</textarea>
                                <div class="form-text">Optional: List relevant certifications, training, or experience</div>
                            </div>
                        </div>
                    }
                    else if (Model.TeamType == "Investigation")
                    {
                        var config = ViewBag.IncidentInvestigationConfig;
                        var hasConfig = config != null;

                        <div class="row">
                            <div class="col-12 mb-3">
                                <h6 class="fw-semibold text-primary">
                                    <i class="ri-search-line me-2"></i>Investigation Team Configuration
                                </h6>
                                <p class="text-muted fs-12">Response time, scope, and team expertise</p>
                            </div>

                            <input type="hidden" name="InvestigationConfig.ConfigId" value="@(hasConfig ? config.ConfigId : 0)" />
                            <input type="hidden" name="InvestigationConfig.TeamId" value="@Model.TeamId" />

                            <div class="col-md-6 mb-3">
                                <label for="responseTimeHours" class="form-label">Response Time (Hours)</label>
                                <input type="number" class="form-control"
                                       name="InvestigationConfig.ResponseTimeHours"
                                       id="responseTimeHours"
                                       min="1"
                                       max="168"
                                       value="@(hasConfig ? config.ResponseTimeHours : 24)" />
                                <div class="form-text">Time to respond to incident (1-168 hours)</div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="escalationThreshold" class="form-label">Escalation Threshold</label>
                                <select class="form-select" name="InvestigationConfig.EscalationThreshold" id="escalationThreshold">
                                    <option value="">-- Select Threshold --</option>
                                    <option value="Minor" @@(hasConfig && config.EscalationThreshold == "Minor" ? "selected" : "")>Minor Incidents</option>
                                    <option value="Moderate" @@(hasConfig && config.EscalationThreshold == "Moderate" ? "selected" : "")>Moderate Incidents</option>
                                    <option value="Serious" @@(hasConfig && config.EscalationThreshold == "Serious" ? "selected" : "")>Serious Incidents</option>
                                    <option value="Critical" @@(hasConfig && config.EscalationThreshold == "Critical" ? "selected" : "")>Critical Incidents Only</option>
                                </select>
                            </div>

                            <div class="col-12 mb-3">
                                <label for="investigationScope" class="form-label">Investigation Scope</label>
                                <textarea class="form-control"
                                          name="InvestigationConfig.InvestigationScope"
                                          id="investigationScope"
                                          rows="3"
                                          maxlength="500"
                                          placeholder="Define the scope of investigations this team handles">@(hasConfig ? config.InvestigationScope : "")</textarea>
                                <div class="form-text">Optional: Describe types of incidents and investigation depth</div>
                            </div>

                            <div class="col-12 mb-3">
                                <label for="teamExpertise" class="form-label">Team Expertise</label>
                                <textarea class="form-control"
                                          name="InvestigationConfig.TeamExpertise"
                                          id="teamExpertise"
                                          rows="3"
                                          maxlength="500"
                                          placeholder="Describe the expertise and specializations of team members">@(hasConfig ? config.TeamExpertise : "")</textarea>
                                <div class="form-text">Optional: List relevant skills, certifications, or experience</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary border-0">
                            <i class="ri-file-list-line me-2"></i>
                            No additional operational configuration required for team type: <strong>@Model.TeamType</strong>
                        </div>
                    }
                </text>
            },

            // ========== TAB 5: Activity Log ==========
            new OSHManagement.Models.ViewModels.TabConfig
            {
                TabId = "activityLog",
                Title = "Activity Log",
                Icon = "ri-history-line",
                Content = @<text>
                    <div class="row">
                        <div class="col-12 mb-3">
                            <h6 class="fw-semibold">Team History</h6>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="card border">
                                <div class="card-body">
                                    <h6 class="card-title text-muted fs-12">Created</h6>
                                    <p class="mb-0">@Model.CreatedAt.ToString("dd MMMM yyyy, HH:mm")</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="card border">
                                <div class="card-body">
                                    <h6 class="card-title text-muted fs-12">Last Updated</h6>
                                    <p class="mb-0">@(Model.UpdatedAt?.ToString("dd MMMM yyyy, HH:mm") ?? "Never")</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="text-center py-5">
                                <i class="ri-history-line fs-1 text-muted mb-3 d-block"></i>
                                <p class="text-muted">Detailed activity logging will be implemented soon.</p>
                            </div>
                        </div>
                    </div>
                </text>
            }
        }
    };

    var tabs = tabsConfig.BuildTabs();
}

<!-- Form wraps entire tabs component -->
