@using OSHManagement.Extensions
@model List<OSHManagement.Models.ViewModels.SectionViewModel>
@{
    ViewData["Title"] = "Section Management";

    // Build stat cards
    var statConfig = new OSHManagement.Models.ViewModels.StatsRowConfig
    {
        Titles = new List<string> { "Total Sections", "Active Sections", "Inactive Sections", "Team Members" },
        Values = new List<string> {
            ViewBag.TotalSections.ToString(),
            ViewBag.ActiveSections.ToString(),
            ViewBag.InactiveSections.ToString(),
            ViewBag.TotalTeamMembers.ToString()
        },
        Icons = new List<string> {
            "ri-layout-grid-line",
            "ri-checkbox-circle-line",
            "ri-close-circle-line",
            "ri-group-line"
        },
        ColorThemes = new List<string> { "primary", "success", "danger", "info" },
        CardType = OSHManagement.Models.ViewModels.CardType.LeftBorderCard
    };
    var statCards = statConfig.BuildStatsRow();

    // Build DataTable configuration
    var tableConfig = new OSHManagement.Models.ViewModels.TableConfig
    {
        TableId = "sectionsTable",
        ActionUrl = "/Section/Index",
        Columns = new List<string> {
            "Section Name",
            "Station",
            "Supervisor",
            "Team Members",
            "Status",
            "Created",
            "Actions"
        },
        SearchPlaceholder = "Search sections...",
        SearchValue = ViewBag.CurrentSearch,
        CreateButtonText = "Create Section",
        CreateButtonUrl = "/Section/Create",
        Filters = new List<OSHManagement.Models.ViewModels.FilterConfig>
        {
            new OSHManagement.Models.ViewModels.FilterConfig
            {
                Label = "Status",
                ParameterName = "status",
                CurrentValue = ViewBag.CurrentStatus,
                Type = OSHManagement.Models.ViewModels.FilterType.Select,
                Options = new List<OSHManagement.Models.ViewModels.FilterOptionConfig>
                {
                    new OSHManagement.Models.ViewModels.FilterOptionConfig { Text = "All Status", Value = "" },
                    new OSHManagement.Models.ViewModels.FilterOptionConfig { Text = "Active", Value = "active" },
                    new OSHManagement.Models.ViewModels.FilterOptionConfig { Text = "Inactive", Value = "inactive" }
                }
            },
            new OSHManagement.Models.ViewModels.FilterConfig
            {
                Label = "Station",
                ParameterName = "stationId",
                CurrentValue = ViewBag.CurrentStationId?.ToString(),
                Type = OSHManagement.Models.ViewModels.FilterType.Select,
                Options = new List<OSHManagement.Models.ViewModels.FilterOptionConfig>
                {
                    new OSHManagement.Models.ViewModels.FilterOptionConfig { Text = "All Stations", Value = "" }
                }.Concat(
                    ((IEnumerable<dynamic>)ViewBag.Stations).Select(s =>
                        new OSHManagement.Models.ViewModels.FilterOptionConfig
                        {
                            Text = s.StationName,
                            Value = s.StationId.ToString()
                        }
                    )
                ).ToList()
            }
        }
    };

    // Build table with row data
    var table = tableConfig.BuildTable(
        tableContent: @<text>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center">
                            <div class="avatar avatar-sm bg-primary-transparent me-2">
                                <i class="ri-layout-grid-line fs-16"></i>
                            </div>
                            <div>
                                <span class="fw-medium">@item.SectionName</span>
                            </div>
                        </div>
                    </td>
                    <td><span class="badge bg-info-transparent">@item.StationName</span></td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.SectionSupervisorPayroll))
                        {
                            <div>
                                <small class="text-muted d-block">
                                    @if (!string.IsNullOrEmpty(item.SupervisorFullName))
                                    {
                                        <span>@item.SupervisorFullName</span>
                                    }
                                    <span class="text-muted">(@item.SectionSupervisorPayroll)</span>
                                </small>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td><span class="badge bg-secondary-transparent"><i class="ri-group-line me-1"></i>@item.TeamMemberCount</span></td>
                    <td><span class="badge bg-@(item.StatusClass)-transparent">@item.StatusText</span></td>
                    <td>@item.FormattedCreatedDate</td>
                    <td>
                        @{
                            var rowActions = new OSHManagement.Models.ViewModels.RowActionConfig
                            {
                                EditUrl = $"/Section/Edit/{{id}}",
                                ViewUrl = $"/Section/View/{{id}}",
                                DeleteUrl = $"/Section/Delete/{{id}}",
                                DeleteItemName = item.SectionName,
                                ShowView = false,
                                ShowEdit = true,
                                ShowDelete = true
                            };
                            var actions = OSHManagement.Extensions.DataTableExtensions.BuildRowActions(item.SectionId, "/Section", rowActions);
                        }
                        <partial name="~/Views/Shared/Components/_ActionButtons.cshtml" model="actions" />
                    </td>
                </tr>
            }
        </text>,
        currentUrl: Context.Request.Path + Context.Request.QueryString
    );

    // Enable pagination
    table.ShowPagination = true;
    table.CurrentPage = ViewBag.CurrentPage;
    table.TotalPages = ViewBag.TotalPages;
    table.TotalRecords = ViewBag.TotalItems;
    table.PageSize = ViewBag.PageSize;
}

<!-- Stat Cards Row -->
<div class="row">
    @foreach (var card in statCards)
    {
        <partial name="~/Views/Shared/Components/StatisticCards/_LeftBorderCard.cshtml" model="card" />
    }
</div>

<!-- Main Content -->
<div class="row mt-3">
    <div class="col-xl-12">
        <partial name="~/Views/Shared/Components/_DataTable.cshtml" model="table" />
    </div>
</div>
