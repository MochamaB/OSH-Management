@using OSHManagement.Models.DTOs
@model IEnumerable<IGrouping<dynamic, EmployeeSelectionDto>>

@{
    var accordionId = ViewBag.AccordionId ?? "employeesAccordion";
    var selectedEmployees = ViewBag.SelectedEmployees as List<int> ?? new List<int>();
}

<div class="mb-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <label class="form-label fw-semibold mb-1">Assign Initial Employees (Optional)</label>
            <div class="form-text">
                Select employees who should have this role. You can only see employees within your scope.
                <br>You can skip this step and assign employees later.
            </div>
        </div>
        <div>
            <button type="button" class="btn btn-sm btn-outline-primary" id="selectAllEmployees">
                <i class="ri-checkbox-multiple-line me-1"></i>Select All
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="deselectAllEmployees">
                <i class="ri-checkbox-blank-line me-1"></i>Deselect All
            </button>
        </div>
    </div>

    <!-- Search Filter -->
    <div class="mb-3">
        <input type="text"
               class="form-control"
               id="employeeSearch"
               placeholder="Search by name or payroll number...">
    </div>

    <div class="accordion accordion-primary" id="@accordionId">
        @{
            var stationIndex = 0;
        }
        @foreach (var stationGroup in Model)
        {
            var station = stationGroup.Key;
            var employees = stationGroup.ToList();
            var collapseId = $"collapse-station-{station.StationId}";
            var headerId = $"heading-station-{station.StationId}";
            var isFirstStation = stationIndex == 0;
            var selectedCount = employees.Count(e => selectedEmployees.Contains(e.EmployeeId));

            <div class="accordion-item">
                <h2 class="accordion-header" id="@headerId">
                    <button class="accordion-button @(isFirstStation ? "" : "collapsed")"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId"
                            aria-expanded="@(isFirstStation ? "true" : "false")"
                            aria-controls="@collapseId">
                        <div class="d-flex justify-content-between align-items-center w-100 me-3">
                            <span>
                                <i class="ri-building-line me-2"></i>
                                <strong>@station.StationName</strong>
                            </span>
                            <span class="badge bg-light text-dark employee-count" data-station="@station.StationId">
                                <span class="selected-count">@selectedCount</span>/@employees.Count
                            </span>
                        </div>
                    </button>
                </h2>
                <div id="@collapseId"
                     class="accordion-collapse collapse @(isFirstStation ? "show" : "")"
                     aria-labelledby="@headerId"
                     data-bs-parent="#@accordionId">
                    <div class="accordion-body">
                        <div class="d-flex justify-content-end mb-2">
                            <button type="button" class="btn btn-xs btn-outline-primary select-station-all" data-station="@station.StationId">
                                <i class="ri-checkbox-line me-1"></i>Select All in @station.StationName
                            </button>
                        </div>
                        <div class="row g-3">
                            @foreach (var employee in employees)
                            {
                                var isChecked = selectedEmployees.Contains(employee.EmployeeId);
                                <div class="col-md-6 employee-checkbox-wrapper"
                                     data-employee-name="@employee.FullName.ToLower()"
                                     data-employee-payroll="@employee.PayrollNo.ToLower()">
                                    <div class="form-check employee-checkbox-card">
                                        <input class="form-check-input employee-checkbox"
                                               type="checkbox"
                                               name="SelectedEmployeeIds"
                                               value="@employee.EmployeeId"
                                               id="employee_@employee.EmployeeId"
                                               data-station="@station.StationId"
                                               @(isChecked ? "checked" : "")>
                                        <label class="form-check-label w-100" for="employee_@employee.EmployeeId">
                                            <div class="d-flex flex-column">
                                                <span class="fw-medium employee-name">@employee.FullName</span>
                                                <small class="text-muted employee-payroll">
                                                    <i class="ri-user-line me-1"></i>@employee.PayrollNo
                                                    @if (!string.IsNullOrEmpty(employee.Designation))
                                                    {
                                                        <span> • @employee.Designation</span>
                                                    }
                                                </small>
                                                @if (!string.IsNullOrEmpty(employee.DepartmentName))
                                                {
                                                    <small class="text-muted">
                                                        <i class="ri-building-2-line me-1"></i>@employee.DepartmentName
                                                    </small>
                                                }
                                            </div>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            stationIndex++;
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info" role="alert">
            <i class="ri-information-line me-2"></i>
            No employees available in your scope. You can assign employees to this role later from the Role Edit page.
        </div>
    }
</div>

<style>
    .employee-checkbox-card {
        padding: 0.75rem;
        border: 1px solid var(--bs-border-color);
        border-radius: 0.375rem;
        transition: all 0.2s ease;
        background-color: var(--bs-body-bg);
    }

    .employee-checkbox-card:hover {
        background-color: var(--bs-light);
        border-color: var(--bs-primary);
    }

    .employee-checkbox-card .form-check-input:checked ~ label {
        color: var(--bs-primary);
    }

    .employee-checkbox-card .form-check-input:checked {
        background-color: var(--bs-primary);
        border-color: var(--bs-primary);
    }

    .employee-count {
        font-size: 0.875rem;
        padding: 0.25rem 0.5rem;
    }

    .accordion-button:not(.collapsed) .employee-count {
        background-color: var(--bs-primary) !important;
        color: white !important;
    }

    .btn-xs {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
    }

    .employee-checkbox-wrapper {
        display: block;
    }

    .employee-checkbox-wrapper.hidden {
        display: none;
    }
</style>
