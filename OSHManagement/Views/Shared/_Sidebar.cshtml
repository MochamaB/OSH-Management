<script>
document.addEventListener('DOMContentLoaded', function() {
    // Get current URL path
    const currentPath = window.location.pathname.toLowerCase();

    // Remove existing active classes from all elements
    document.querySelectorAll('.side-menu__item').forEach(item => {
        item.classList.remove('active', 'open');
    });
    document.querySelectorAll('.slide').forEach(slide => {
        slide.classList.remove('active', 'open');
    });
    document.querySelectorAll('.has-sub').forEach(hasSub => {
        hasSub.classList.remove('active', 'open');
    });
    document.querySelectorAll('.slide-menu').forEach(menu => {
        menu.classList.remove('double-menu-active');
    });

    // Extract controller from current path (e.g., /Organization/CreateCategory -> organization)
    const pathParts = currentPath.split('/').filter(p => p);
    const currentController = pathParts.length > 0 ? pathParts[0] : '';

    // Find best matching menu item using longest match algorithm
    let bestMatch = null;
    let longestMatchLength = 0;

    document.querySelectorAll('.slide-menu .side-menu__item').forEach(item => {
        const href = item.getAttribute('href');
        if (href && href !== 'javascript:void(0);' && href !== '#') {
            const linkPath = href.toLowerCase();
            const linkParts = linkPath.split('/').filter(p => p);
            const linkController = linkParts.length > 0 ? linkParts[0] : '';

            // Check for exact match first
            if (currentPath === linkPath) {
                bestMatch = item;
                longestMatchLength = linkPath.length;
            }
            // Then check if current path starts with link path
            else if (linkPath !== '/' && currentPath.startsWith(linkPath)) {
                if (linkPath.length > longestMatchLength) {
                    bestMatch = item;
                    longestMatchLength = linkPath.length;
                }
            }
            // Finally, if same controller and no better match, use first link from that controller
            else if (currentController && linkController === currentController && longestMatchLength === 0) {
                bestMatch = item;
                longestMatchLength = 1; // Set to 1 to indicate we have a controller match
            }
        }
    });

    // Activate the best matching item and its entire hierarchy
    if (bestMatch) {
        // 1. Activate the child link itself
        bestMatch.classList.add('active');

        // 2. Activate the child <li class="slide">
        const childSlide = bestMatch.closest('.slide');
        if (childSlide) {
            childSlide.classList.add('active', 'open');
        }

        // 3. Activate the parent <li class="slide has-sub">
        const parentHasSub = bestMatch.closest('.has-sub');
        if (parentHasSub) {
            parentHasSub.classList.add('active', 'open');

            // 4. Activate the parent link (direct child of has-sub)
            const parentLink = parentHasSub.querySelector(':scope > .side-menu__item');
            if (parentLink) {
                parentLink.classList.add('active', 'open');
            }

            // 5. Activate the submenu container
            const slideMenu = parentHasSub.querySelector('.slide-menu');
            if (slideMenu) {
                slideMenu.classList.add('double-menu-active');
            }
        }
    }
});
</script>