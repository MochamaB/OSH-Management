@using OSHManagement.Models.ViewModels
@model IEnumerable<IGrouping<string, PermissionViewModel>>

@{
    var accordionId = ViewBag.AccordionId ?? "permissionsAccordion";
    var selectedPermissions = ViewBag.SelectedPermissions as List<int> ?? new List<int>();
}

<div class="mb-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <label class="form-label fw-semibold mb-1">Assign Permissions</label>
            <div class="form-text">Select permissions that this role should have. Permissions are grouped by module.</div>
        </div>
        <div>
            <button type="button" class="btn btn-sm btn-outline-primary" id="selectAllPermissions">
                <i class="ri-checkbox-multiple-line me-1"></i>Select All
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="deselectAllPermissions">
                <i class="ri-checkbox-blank-line me-1"></i>Deselect All
            </button>
        </div>
    </div>

    <div class="accordion accordion-primary" id="@accordionId">
        @{
            var moduleIndex = 0;
        }
        @foreach (var moduleGroup in Model)
        {
            var module = moduleGroup.Key;
            var permissions = moduleGroup.ToList();
            var collapseId = $"collapse-{module.Replace(" ", "-").ToLower()}";
            var headerId = $"heading-{module.Replace(" ", "-").ToLower()}";
            var isFirstModule = moduleIndex == 0;
            var selectedCount = permissions.Count(p => selectedPermissions.Contains(p.PermissionId));

            <div class="accordion-item">
                <h2 class="accordion-header" id="@headerId">
                    <button class="accordion-button @(isFirstModule ? "" : "collapsed")"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId"
                            aria-expanded="@(isFirstModule ? "true" : "false")"
                            aria-controls="@collapseId">
                        <div class="d-flex justify-content-between align-items-center w-100 me-3">
                            <span>
                                <i class="ri-folder-line me-2"></i>
                                <strong>@module</strong>
                            </span>
                            <span class="badge bg-light text-dark permission-count" data-module="@module">
                                <span class="selected-count">@selectedCount</span>/@permissions.Count
                            </span>
                        </div>
                    </button>
                </h2>
                <div id="@collapseId"
                     class="accordion-collapse collapse @(isFirstModule ? "show" : "")"
                     aria-labelledby="@headerId"
                     data-bs-parent="#@accordionId">
                    <div class="accordion-body">
                        <div class="d-flex justify-content-end mb-2">
                            <button type="button" class="btn btn-xs btn-outline-primary select-module-all" data-module="@module">
                                <i class="ri-checkbox-line me-1"></i>Select All in @module
                            </button>
                        </div>
                        <div class="row g-3">
                            @foreach (var permission in permissions)
                            {
                                var isChecked = selectedPermissions.Contains(permission.PermissionId);
                                <div class="col-md-6">
                                    <div class="form-check permission-checkbox-item">
                                        <input class="form-check-input permission-checkbox"
                                               type="checkbox"
                                               name="SelectedPermissionIds"
                                               value="@permission.PermissionId"
                                               id="permission_@permission.PermissionId"
                                               data-module="@module"
                                               @(isChecked ? "checked" : "")>
                                        <label class="form-check-label w-100" for="permission_@permission.PermissionId">
                                            <div class="d-flex flex-column">
                                                <span class="fw-medium">@permission.PermissionName</span>
                                                @if (!string.IsNullOrEmpty(permission.Description))
                                                {
                                                    <small class="text-muted">@permission.Description</small>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">@permission.Action access for @module</small>
                                                }
                                            </div>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            moduleIndex++;
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning" role="alert">
            <i class="ri-alert-line me-2"></i>
            No permissions available. Please create permissions before assigning them to roles.
        </div>
    }
</div>

<style>
    .permission-checkbox-item {
        padding: 0.75rem;
        border: 1px solid var(--bs-border-color);
        border-radius: 0.375rem;
        transition: all 0.2s ease;
        background-color: var(--bs-body-bg);
    }

    .permission-checkbox-item:hover {
        background-color: var(--bs-light);
        border-color: var(--bs-primary);
    }

    .permission-checkbox-item .form-check-input:checked ~ label {
        color: var(--bs-primary);
    }

    .permission-checkbox-item .form-check-input:checked {
        background-color: var(--bs-primary);
        border-color: var(--bs-primary);
    }

    .permission-count {
        font-size: 0.875rem;
        padding: 0.25rem 0.5rem;
    }

    .accordion-button:not(.collapsed) .permission-count {
        background-color: var(--bs-primary) !important;
        color: white !important;
    }

    .btn-xs {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
    }
</style>
