<!DOCTYPE html>
<html lang="en" dir="ltr" data-nav-layout="vertical" data-theme-mode="light" data-header-styles="transparent" data-width="fullwidth" data-menu-styles="transparent" data-page-style="flat" data-toggled="close" data-vertical-style="doublemenu" data-toggled="double-menu-open">
<head>
    <!-- Meta Data -->
    <meta charset="UTF-8">
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@ViewData["Title"] - KTDA OSH Management System</title>
    <meta name="Description" content="KTDA Occupational Safety & Health Management System">
    <meta name="Author" content="KTDA">
    <meta name="keywords" content="OSH,safety,health,management,KTDA,tea,factories,compliance,risk assessment">
@{
    await Html.RenderPartialAsync("styles");
}

@RenderSection("Styles", required: false)
</head>
<body>
    <div class="progress-top-bar"></div>

<!-- Theme Switcher -->
@{
    await Html.RenderPartialAsync("_ThemeSwitcher");
}

@{
    await Html.RenderPartialAsync("_Loader");
}

    <div class="page">
        @await Html.PartialAsync("_Navbar")
        @await Html.PartialAsync("_Sidebar")

        <!-- Main Content -->
        <div class="main-content app-content">
            @await Html.PartialAsync("_Alerts")
            <div class="container-fluid page-container main-body-container pt-2">
                @await Html.PartialAsync("_Breadcrumb")
                @RenderBody()
            </div>
        </div>

        <!-- Footer -->
        @await Html.PartialAsync("_Footer")
    </div>

    <!-- Global Delete Confirmation Modal -->
    @await Html.PartialAsync("~/Views/Shared/Components/_DeleteModal.cshtml")

@{
    await Html.RenderPartialAsync("_UIComponents");
}

@{
    await Html.RenderPartialAsync("_Scripts");
}

@RenderSection("Scripts", required: false)
</body>
</html>
