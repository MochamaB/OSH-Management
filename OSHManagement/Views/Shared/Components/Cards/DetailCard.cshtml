@using OSHManagement.Extensions
@model OSHManagement.Models.ViewModels.DetailCardViewModel

@if (Model.ShowCard)
{
    <div class="card custom-card" id="@Model.CardId">
        <div class="pt-4 pb-0 ps-4 pe-4">
            <!-- Top Section: Action Buttons -->
            @if (Model.HasActions)
            {
                <div class="d-flex justify-content-end gap-2 mb-1">
                    @foreach (var action in Model.Actions)
                    {
                        @if (action.IsDropdown && action.DropdownItems != null && action.DropdownItems.Any())
                        {
                            <!-- Dropdown Button -->
                            <div class="dropdown">
                                <button class="btn btn-@action.ButtonStyle btn-@action.ButtonSize dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @if (!string.IsNullOrEmpty(action.Icon))
                                    {
                                        <i class="@action.Icon me-1"></i>
                                    }
                                    @action.Text
                                </button>
                                <ul class="dropdown-menu">
                                    @foreach (var item in action.DropdownItems)
                                    {
                                        @if (item.IsDivider)
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                        }
                                        else
                                        {
                                            <li>
                                                <a class="dropdown-item"
                                                   href="@(item.Url ?? "javascript:void(0);")"
                                                   @(item.OnClick != null ? $"onclick=\"{item.OnClick}\"" : "")>
                                                    @if (!string.IsNullOrEmpty(item.Icon))
                                                    {
                                                        <i class="@item.Icon me-2"></i>
                                                    }
                                                    @item.Text
                                                </a>
                                            </li>
                                        }
                                    }
                                </ul>
                            </div>
                        }
                        else
                        {
                            <!-- Regular Button -->
                            <a href="@(action.Url ?? "javascript:void(0);")"
                               class="btn btn-@action.ButtonStyle btn-@action.ButtonSize"
                               @(action.OnClick != null ? $"onclick=\"{action.OnClick}\"" : "")>
                                @if (!string.IsNullOrEmpty(action.Icon))
                                {
                                    <i class="@action.Icon me-1"></i>
                                }
                                @action.Text
                            </a>
                        }
                    }
                </div>
            }

            <!-- Main Section: Icon + Title + Fields -->
            <div class="d-flex align-items-start gap-3">
                <!-- Icon -->
                <div class="flex-shrink-0">
                    <span class="avatar avatar-xl avatar-rounded @Model.IconColorClass">
                        <i class="@Model.Icon fs-3"></i>
                    </span>
                </div>

                <!-- Title, Subtitle, Category -->
                <div class="flex-fill">
                    <!-- Title and Status Badge -->
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <h5 class="fw-semibold mb-0">@Model.Title</h5>
                        @if (Model.StatusBadge != null)
                        {
                            <span class="badge bg-@Model.StatusBadge.Color">
                                @if (!string.IsNullOrEmpty(Model.StatusBadge.Icon))
                                {
                                    <i class="@Model.StatusBadge.Icon me-1"></i>
                                }
                                @Model.StatusBadge.Text
                            </span>
                        }
                    </div>

                    <!-- Subtitle -->
                    @if (!string.IsNullOrEmpty(Model.Subtitle))
                    {
                        <p class="text-muted mb-1 fs-14">@Model.Subtitle</p>
                    }

                    <!-- Category -->
                    @if (!string.IsNullOrEmpty(Model.Category))
                    {
                        <p class="text-muted mb-0 fs-12">
                            <i class="ri-price-tag-3-line me-1"></i>@Model.Category
                        </p>
                    }
                </div>
            </div>

            <!-- Fields Grid with Top Border -->
            @if (Model.HasFields)
            {
                <div class="border-top mt-3 pt-0">
                    <div class="row g-3">
                        @foreach (var field in Model.Fields)
                        {
                            <div class="col-auto">
                                <div class="border-right p-2 d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(field.Icon))
                                    {
                                        <i class="@field.Icon text-muted fs-16"></i>
                                    }
                                    <div>
                                        <span class="text-muted fs-12 d-block">@field.Label</span>
                                        @if (field.Badge != null)
                                        {
                                            <span class="badge bg-@field.Badge.Color fs-11">
                                                @if (!string.IsNullOrEmpty(field.Badge.Icon))
                                                {
                                                    <i class="@field.Badge.Icon me-1"></i>
                                                }
                                                @field.Badge.Text
                                            </span>
                                        }
                                        else if (!string.IsNullOrEmpty(field.Href))
                                        {
                                            <a href="@field.Href" class="fw-medium fs-13 text-primary">@field.Value</a>
                                        }
                                        else if (field.IsHtml)
                                        {
                                            <span class="fw-medium fs-13">@Html.Raw(field.Value)</span>
                                        }
                                        else
                                        {
                                            <span class="fw-medium fs-13">@field.Value</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
