@model OSHManagement.Models.ViewModels.StatCardViewModel

<div class="@Model.ColumnClass">
    <div class="card custom-card dashboard-main-card @Model.ColorTheme">
        <div class="card-body p-4">
            <div class="d-flex align-items-start gap-3">
                <div class="flex-fill">
                    <h6 class="mb-2 fs-12">@Model.Title</h6>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <h4 class="fw-medium mb-0">@Model.Value</h4>
                            @if (!string.IsNullOrEmpty(Model.BadgeValue))
                            {
                                <span class="badge bg-@Model.BadgeColor">@Model.BadgeValue</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(Model.TrendPercentage))
                        {
                            var trendColorClass = Model.TrendDirection == OSHManagement.Models.ViewModels.TrendDirection.Up ? "success" :
                                                  Model.TrendDirection == OSHManagement.Models.ViewModels.TrendDirection.Down ? "danger" : "muted";
                            var trendIcon = Model.TrendDirection == OSHManagement.Models.ViewModels.TrendDirection.Up ? "ri-arrow-up-s-line" :
                                           Model.TrendDirection == OSHManagement.Models.ViewModels.TrendDirection.Down ? "ri-arrow-down-s-line" : "ri-subtract-line";

                            <p class="text-muted fs-11 mb-0 lh-1">
                                <span class="text-@trendColorClass me-1 fw-medium">
                                    <i class="@trendIcon me-1 align-middle"></i>@Model.TrendPercentage%
                                </span>
                                <span>@Model.TrendPeriod</span>
                            </p>
                        }
                    </div>
                </div>
                <div class="avatar avatar-lg bg-@Model.ColorTheme-transparent svg-@Model.ColorTheme">
                    @if (!string.IsNullOrEmpty(Model.CustomSvg))
                    {
                        @Html.Raw(Model.CustomSvg)
                    }
                    else
                    {
                        <i class="@Model.Icon fs-24"></i>
                    }
                </div>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.LinkUrl))
        {
            <a href="@Model.LinkUrl" class="stretched-link"></a>
        }
    </div>
</div>
