@model OSHManagement.Models.ViewModels.FormFieldViewModel

@* Hidden fields don't need labels *@
@if (Model.Type == OSHManagement.Models.ViewModels.FieldType.Hidden)
{
    <input type="hidden" id="@Model.UniqueId" name="@Model.PropertyName" value="@Model.Value" />
}
else if (Model.Type == OSHManagement.Models.ViewModels.FieldType.Checkbox)
{
    @* Checkbox has label inside *@
    <div class="form-check">
        <input class="form-check-input @Model.CustomCssClass" type="checkbox" id="@Model.UniqueId"
               name="@Model.PropertyName" value="true"
               @(Model.DefaultValue == "true" || Model.Value == "true" ? "checked" : "")
               @(Model.Required ? "required" : "")
               @(Model.Disabled ? "disabled" : "")
               data-val-required="@(Model.ValidationMessage ?? "This field is required")">
        <label class="form-check-label" for="@Model.UniqueId">
            @Model.Label @if (Model.Required)
            {<span class="text-danger">*</span>}
        </label>
        @if (!string.IsNullOrEmpty(Model.HelpText))
        {
            <div class="form-text">@Model.HelpText</div>
        }
    </div>
}
else
{
    @* All other fields with label *@
    <div class="form-group">
        @if (!string.IsNullOrEmpty(Model.Label))
        {
            <label for="@Model.UniqueId" class="form-label">
                @Model.Label @if (Model.Required)
                {<span class="text-danger">*</span>}
            </label>
        }

        @switch (Model.Type)
        {
            case OSHManagement.Models.ViewModels.FieldType.Textarea:
                var textareaAttrs = new System.Text.StringBuilder();
                if (Model.Required) textareaAttrs.Append(" required");
                if (Model.Disabled) textareaAttrs.Append(" disabled");
                if (Model.ReadOnly) textareaAttrs.Append(" readonly");
                if (Model.MaxLength.HasValue) textareaAttrs.Append($" maxlength=\"{Model.MaxLength}\"");
                if (Model.MaxLength.HasValue || Model.Required) textareaAttrs.Append(" data-val=\"true\"");
                if (Model.Required) textareaAttrs.Append($" data-val-required=\"{Model.ValidationMessage ?? "This field is required"}\"");
                if (Model.MaxLength.HasValue)
                {
                    textareaAttrs.Append($" data-val-maxlength=\"Please enter no more than {Model.MaxLength} characters.\"");
                    textareaAttrs.Append($" data-val-maxlength-max=\"{Model.MaxLength}\"");
                }
                <textarea class="form-control @Model.CustomCssClass" id="@Model.UniqueId" name="@Model.PropertyName"
                          rows="@Model.Rows" placeholder="@Model.Placeholder"@Html.Raw(textareaAttrs.ToString())>@Model.Value</textarea>
                break;

            case OSHManagement.Models.ViewModels.FieldType.Select:
                var selectClass = $"form-select {Model.CustomCssClass}".Trim();
                <select class="@selectClass" id="@Model.UniqueId" name="@Model.PropertyName"
                        @(Model.Required ? "required" : "")
                        @(Model.Disabled ? "disabled" : "")
                        data-val-required="@(Model.ValidationMessage ?? "This field is required")">
                    @if (Model.Options != null)
                    {
                        @foreach (var option in Model.Options)
                        {
                            if (option.Selected)
                            {
                                if (option.Disabled)
                                {
                                    <option value="@option.Value" selected disabled>@option.Text</option>
                                }
                                else
                                {
                                    <option value="@option.Value" selected>@option.Text</option>
                                }
                            }
                            else if (option.Disabled)
                            {
                                <option value="@option.Value" disabled>@option.Text</option>
                            }
                            else
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        }
                    }
                </select>
                break;

            default:
                var inputType = Model.Type.ToString().ToLower();
                var inputAttrs = new System.Text.StringBuilder();
                if (Model.Required) inputAttrs.Append(" required");
                if (Model.Disabled) inputAttrs.Append(" disabled");
                if (Model.ReadOnly) inputAttrs.Append(" readonly");
                if (Model.MaxLength.HasValue) inputAttrs.Append($" maxlength=\"{Model.MaxLength}\"");
                if (Model.MinLength.HasValue) inputAttrs.Append($" minlength=\"{Model.MinLength}\"");
                if (Model.MaxLength.HasValue || Model.MinLength.HasValue || Model.Required) inputAttrs.Append(" data-val=\"true\"");
                if (Model.Required) inputAttrs.Append($" data-val-required=\"{Model.ValidationMessage ?? "This field is required"}\"");
                if (Model.MaxLength.HasValue)
                {
                    inputAttrs.Append($" data-val-maxlength=\"Please enter no more than {Model.MaxLength} characters.\"");
                    inputAttrs.Append($" data-val-maxlength-max=\"{Model.MaxLength}\"");
                }
                if (Model.MinLength.HasValue)
                {
                    inputAttrs.Append($" data-val-minlength=\"Please enter at least {Model.MinLength} characters.\"");
                    inputAttrs.Append($" data-val-minlength-min=\"{Model.MinLength}\"");
                }
                <input type="@inputType" class="form-control @Model.CustomCssClass" id="@Model.UniqueId"
                       name="@Model.PropertyName" value="@Model.Value" placeholder="@Model.Placeholder"@Html.Raw(inputAttrs.ToString()) />
                break;
        }

        @if (!string.IsNullOrEmpty(Model.HelpText))
        {
            <div class="form-text">@Model.HelpText</div>
        }

        <span class="invalid-feedback"></span>
    </div>
}
