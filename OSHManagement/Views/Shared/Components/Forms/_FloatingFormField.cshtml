@model OSHManagement.Models.ViewModels.FormFieldViewModel

@switch (Model.Type)
{
    case OSHManagement.Models.ViewModels.FieldType.Textarea:
        <textarea class="form-control @Model.CustomCssClass" id="@Model.UniqueId" name="@Model.PropertyName"
                  rows="@Model.Rows" placeholder="@Model.Placeholder"
                  @(Model.Required ? "required" : "")
                  @(Model.Disabled ? "disabled" : "")
                  @(Model.ReadOnly ? "readonly" : "")
                  @(Model.MaxLength.HasValue ? $"maxlength=\"{Model.MaxLength}\"" : "")>@Model.Value</textarea>
        break;

    case OSHManagement.Models.ViewModels.FieldType.Select:
        var selectClass = $"form-select {Model.CustomCssClass}".Trim();

        <select class="@selectClass" id="@Model.UniqueId" name="@Model.PropertyName" 
                @(Model.Required ? "required" : "") 
                @(Model.Disabled ? "disabled" : "")>
            @if (Model.Options != null)
            {
                @foreach (var option in Model.Options)
                {
                    if (option.Selected)
                    {
                        if (option.Disabled)
                        {
                            <option value="@option.Value" selected disabled>@option.Text</option>
                        }
                        else
                        {
                            <option value="@option.Value" selected>@option.Text</option>
                        }
                    }
                    else if (option.Disabled)
                    {
                        <option value="@option.Value" disabled>@option.Text</option>
                    }
                    else
                    {
                        <option value="@option.Value">@option.Text</option>
                    }
                }
            }
        </select>
        break;

    case OSHManagement.Models.ViewModels.FieldType.Hidden:
        <input type="hidden" id="@Model.UniqueId" name="@Model.PropertyName" value="@Model.Value" />
        break;

    default:
        var inputType = Model.Type.ToString().ToLower();
        <input type="@inputType" class="form-control @Model.CustomCssClass" id="@Model.UniqueId"
               name="@Model.PropertyName" value="@Model.Value" placeholder="@Model.Placeholder"
               @(Model.Required ? "required" : "")
               @(Model.Disabled ? "disabled" : "")
               @(Model.ReadOnly ? "readonly" : "")
               @(Model.MaxLength.HasValue ? $"maxlength=\"{Model.MaxLength}\"" : "")
               @(Model.MinLength.HasValue ? $"minlength=\"{Model.MinLength}\"" : "") />
        break;
}
