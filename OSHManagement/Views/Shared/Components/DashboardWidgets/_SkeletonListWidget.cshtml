@*
    Skeleton Loading State for List Widget
    Shows while data is being loaded
*@

<div class="card custom-card">
    <div class="card-header justify-content-between">
        <div class="shimmer bg-light rounded" style="height: 18px; width: 120px;"></div>
        <div class="shimmer bg-light rounded" style="height: 14px; width: 60px;"></div>
    </div>
    <div class="card-body p-0">
        @for (int i = 0; i < 5; i++)
        {
            <div class="d-flex align-items-start gap-3 p-3 border-bottom">
                <div class="shimmer bg-light rounded-circle" style="width: 36px; height: 36px;"></div>
                <div class="flex-fill">
                    <div class="shimmer bg-light rounded mb-2" style="height: 14px; width: 70%;"></div>
                    <div class="shimmer bg-light rounded" style="height: 12px; width: 50%;"></div>
                </div>
                <div class="text-end">
                    <div class="shimmer bg-light rounded mb-2" style="height: 12px; width: 50px;"></div>
                    <div class="shimmer bg-light rounded" style="height: 18px; width: 60px;"></div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    @@keyframes shimmer {
        0% {
            background-position: -1000px 0;
        }
        100% {
            background-position: 1000px 0;
        }
    }

    .shimmer {
        animation: shimmer 2s infinite linear;
        background: linear-gradient(to right, #f0f0f0 4%, #e0e0e0 25%, #f0f0f0 36%);
        background-size: 1000px 100%;
    }
</style>
