@*
    Skeleton Loading State for Progress Widget
    Shows while data is being loaded
*@

<div class="card custom-card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="shimmer bg-light rounded" style="height: 16px; width: 140px;"></div>
            <div class="shimmer bg-light rounded" style="height: 16px; width: 50px;"></div>
        </div>
        
        <div class="progress" style="height: 20px;">
            <div class="shimmer bg-light rounded" style="height: 20px; width: 100%;"></div>
        </div>
        
        <div class="mt-2">
            <div class="shimmer bg-light rounded" style="height: 12px; width: 100px;"></div>
        </div>
    </div>
</div>

<style>
    @@keyframes shimmer {
        0% {
            background-position: -1000px 0;
        }
        100% {
            background-position: 1000px 0;
        }
    }

    .shimmer {
        animation: shimmer 2s infinite linear;
        background: linear-gradient(to right, #f0f0f0 4%, #e0e0e0 25%, #f0f0f0 36%);
        background-size: 1000px 100%;
    }
</style>
