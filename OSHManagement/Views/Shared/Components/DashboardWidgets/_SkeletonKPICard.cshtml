@*
    Skeleton Loading State for KPI Card
    Shows while data is being loaded
*@

<div class="card custom-card">
    <div class="card-body">
        <div class="d-flex align-items-start gap-3 flex-wrap">
            <div class="lh-1">
                <div class="avatar avatar-md bg-light rounded shimmer" style="width: 48px; height: 48px;"></div>
            </div>
            <div class="flex-fill">
                <div class="shimmer bg-light rounded mb-2" style="height: 12px; width: 80px;"></div>
                <div class="shimmer bg-light rounded mb-2" style="height: 24px; width: 60px;"></div>
                <div class="shimmer bg-light rounded" style="height: 20px; width: 90px;"></div>
            </div>
            <div>
                <div class="shimmer bg-light rounded" style="height: 16px; width: 50px;"></div>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes shimmer {
        0% {
            background-position: -1000px 0;
        }
        100% {
            background-position: 1000px 0;
        }
    }

    .shimmer {
        animation: shimmer 2s infinite linear;
        background: linear-gradient(to right, #f0f0f0 4%, #e0e0e0 25%, #f0f0f0 36%);
        background-size: 1000px 100%;
    }
</style>
