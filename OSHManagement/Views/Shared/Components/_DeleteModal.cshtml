@*
    Reusable Delete Confirmation Modal
    Usage: Include this partial in your layout or page, then call showDeleteModal(id, itemName, deleteUrl) from JavaScript
*@

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger-transparent">
                <h6 class="modal-title text-danger" id="deleteModalLabel">
                    <i class="ri-error-warning-line me-2"></i>Confirm Delete
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <div class="avatar avatar-xl bg-danger-transparent mb-3">
                        <i class="ri-delete-bin-line fs-1 text-danger"></i>
                    </div>
                    <h5 class="mb-2">Are you sure?</h5>
                    <p class="text-muted mb-0" id="deleteModalMessage">
                        This action cannot be undone.
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="ri-close-line me-1"></i>Cancel
                </button>
                <form id="deleteForm" method="POST" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="ri-delete-bin-line me-1"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Global function to show delete modal
    function showDeleteModal(id, itemName, deleteUrl) {
        // Update modal message
        const message = itemName
            ? `Do you really want to delete <strong>${itemName}</strong>? This action cannot be undone.`
            : 'Do you really want to delete this item? This action cannot be undone.';

        document.getElementById('deleteModalMessage').innerHTML = message;

        // Update form action
        const form = document.getElementById('deleteForm');
        form.action = deleteUrl.replace('{id}', id);

        // Show modal
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }
</script>
