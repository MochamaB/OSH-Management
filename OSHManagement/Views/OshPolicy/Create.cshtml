@using OSHManagement.Extensions
@model OSHManagement.Models.ViewModels.OshPolicyViewModel

@{
    ViewData["Title"] = "Create OSH Policy";

    // Build station options
    var stationOptions = new List<OSHManagement.Models.ViewModels.FormSelectOption>
    {
        new OSHManagement.Models.ViewModels.FormSelectOption { Text = "-- Select Station --", Value = "", Selected = true }
    };

    if (ViewBag.Stations != null)
    {
        foreach (var station in (IEnumerable<dynamic>)ViewBag.Stations)
        {
            stationOptions.Add(new OSHManagement.Models.ViewModels.FormSelectOption
            {
                Text = station.StationName,
                Value = station.StationId.ToString()
            });
        }
    }

    // Build employee options for signer
    var employeeOptions = new List<OSHManagement.Models.ViewModels.FormSelectOption>
    {
        new OSHManagement.Models.ViewModels.FormSelectOption { Text = "-- Select Employee --", Value = "", Selected = true }
    };

    if (ViewBag.Employees != null)
    {
        foreach (var emp in (IEnumerable<dynamic>)ViewBag.Employees)
        {
            employeeOptions.Add(new OSHManagement.Models.ViewModels.FormSelectOption
            {
                Text = $"{emp.FullName} ({emp.PayrollNo})",
                Value = emp.PayrollNo
            });
        }
    }

    // Configure Form Wizard with 4 Steps
    var wizardConfig = new OSHManagement.Models.ViewModels.FormWizardConfig
    {
        WizardId = "createOshPolicyWizard",
        ActionUrl = "/OshPolicy/Create",
        Method = "POST",
        Type = OSHManagement.Models.ViewModels.WizardType.Vertical,
        WrapInCard = true,
        CardTitle = "Create OSH Policy",
        CardSubtitle = "Complete all steps to create a comprehensive OSH policy for the station",
        CancelUrl = "/OshPolicy/Index",
        CancelButtonText = "Cancel",
        PreviousButtonText = "Previous",
        NextButtonText = "Next",
        SubmitButtonText = "Create Policy",
        ValidateOnStepChange = true,
        Steps = new List<OSHManagement.Models.ViewModels.WizardStepConfig>
        {
            // ========== STEP 1: Policy Signature & Status ==========
            new OSHManagement.Models.ViewModels.WizardStepConfig
            {
                StepId = "policySignature",
                Title = "Policy Signature & Status",
                Icon = "ri-file-shield-line",
                Description = "Policy approval and signature details",
                FieldsPerRow = 2,
                FieldColumnClass = "col-md-6",
                Fields = new List<OSHManagement.Models.ViewModels.FormFieldConfig>
                {
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "StationId",
                        PropertyName = nameof(OshPolicyViewModel.StationId),
                        Label = "Station",
                        Type = OSHManagement.Models.ViewModels.FieldType.Select,
                        Required = true,
                        ValidationMessage = "Station is required",
                        HelpText = "Select the station for this OSH policy",
                        Options = stationOptions,
                        Value = Model?.StationId.ToString() ?? ""
                    },
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "PolicyStatus",
                        PropertyName = nameof(OshPolicyViewModel.PolicyStatus),
                        Label = "Policy Status",
                        Type = OSHManagement.Models.ViewModels.FieldType.Select,
                        Required = true,
                        ValidationMessage = "Policy status is required",
                        HelpText = "Current status of the policy",
                        Options = new List<OSHManagement.Models.ViewModels.FormSelectOption>
                        {
                            new OSHManagement.Models.ViewModels.FormSelectOption { Value = "Draft", Text = "Draft", Selected = true },
                            new OSHManagement.Models.ViewModels.FormSelectOption { Value = "Active", Text = "Active" },
                            new OSHManagement.Models.ViewModels.FormSelectOption { Value = "Under Review", Text = "Under Review" }
                        },
                        Value = Model?.PolicyStatus ?? "Draft"
                    },
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "HasTopManagementSignature",
                        PropertyName = nameof(OshPolicyViewModel.HasTopManagementSignature),
                        Label = "Policy Signed by Top Management",
                        Type = OSHManagement.Models.ViewModels.FieldType.Checkbox,
                        HelpText = "Check if the policy has been signed by top management",
                        CustomCssClass = "col-12"
                    },
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "DateSigned",
                        PropertyName = nameof(OshPolicyViewModel.DateSigned),
                        Label = "Date Signed",
                        Type = OSHManagement.Models.ViewModels.FieldType.Date,
                        HelpText = "Date when the policy was signed (required if signed)",
                        CustomAttributes = new Dictionary<string, string> { { "data-conditional-field", "HasTopManagementSignature" } },
                        Value = Model?.DateSigned?.ToString("yyyy-MM-dd") ?? ""
                    },
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "SignedByPayroll",
                        PropertyName = nameof(OshPolicyViewModel.SignedByPayroll),
                        Label = "Signed By (Employee)",
                        Type = OSHManagement.Models.ViewModels.FieldType.Select,
                        Options = employeeOptions,
                        HelpText = "Select the employee who signed the policy (required if signed)",
                        CustomAttributes = new Dictionary<string, string> { { "data-conditional-field", "HasTopManagementSignature" } },
                        Value = Model?.SignedByPayroll ?? ""
                    }
                }
            },

            // ========== STEP 2: Implementation & Review ==========
            new OSHManagement.Models.ViewModels.WizardStepConfig
            {
                StepId = "implementationReview",
                Title = "Implementation & Review",
                Icon = "ri-checkbox-circle-line",
                Description = "Policy implementation status and review tracking",
                FieldsPerRow = 2,
                FieldColumnClass = "col-md-6",
                Fields = new List<OSHManagement.Models.ViewModels.FormFieldConfig>
                {
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "IsPolicyImplemented",
                        PropertyName = nameof(OshPolicyViewModel.IsPolicyImplemented),
                        Label = "Policy is Being Implemented",
                        Type = OSHManagement.Models.ViewModels.FieldType.Checkbox,
                        HelpText = "Check if the policy is actively being implemented at the station",
                        CustomCssClass = "col-12"
                    },
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "LastReviewedDate",
                        PropertyName = nameof(OshPolicyViewModel.LastReviewedDate),
                        Label = "Last Reviewed Date",
                        Type = OSHManagement.Models.ViewModels.FieldType.Date,
                        HelpText = "Date when the policy was last reviewed (optional)",
                        Value = Model?.LastReviewedDate?.ToString("yyyy-MM-dd") ?? ""
                    },
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "CommunicationMethods",
                        PropertyName = nameof(OshPolicyViewModel.CommunicationMethods),
                        Label = "Communication Methods",
                        Type = OSHManagement.Models.ViewModels.FieldType.Textarea,
                        Placeholder = "Describe how the policy is communicated to staff (e.g., notice boards, staff meetings, email, training sessions)",
                        Rows = 4,
                        MaxLength = 2000,
                        HelpText = "Explain how the OSH policy is communicated to all employees",
                        CustomCssClass = "col-12",
                        Value = Model?.CommunicationMethods ?? ""
                    }
                }
            },

            // ========== STEP 3: Responsibilities ==========
            new OSHManagement.Models.ViewModels.WizardStepConfig
            {
                StepId = "responsibilities",
                Title = "OSH Responsibilities",
                Icon = "ri-team-line",
                Description = "Define responsibilities for different organizational levels",
                FieldsPerRow = 1,
                FieldColumnClass = "col-12",
                Fields = new List<OSHManagement.Models.ViewModels.FormFieldConfig>
                {
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "ManagementResponsibilities",
                        PropertyName = nameof(OshPolicyViewModel.ManagementResponsibilities),
                        Label = "Management Responsibilities",
                        Type = OSHManagement.Models.ViewModels.FieldType.Textarea,
                        Placeholder = "Define OSH responsibilities for management (e.g., provide resources, establish OSH objectives, ensure compliance)",
                        Rows = 4,
                        HelpText = "Required: Management's OSH responsibilities and commitments",
                        Value = Model?.ManagementResponsibilities ?? "Provides leadership, approves the policy, ensures adequate resources and compliance with the policy"
                    },
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "SupervisorResponsibilities",
                        PropertyName = nameof(OshPolicyViewModel.SupervisorResponsibilities),
                        Label = "Factory Supervisor Responsibilities",
                        Type = OSHManagement.Models.ViewModels.FieldType.Textarea,
                        Placeholder = "Define OSH responsibilities for factory supervisors (e.g., enforce safety rules, conduct inspections, report hazards)",
                        Rows = 4,
                        HelpText = "Required: Supervisor's OSH responsibilities",
                        Value = Model?.SupervisorResponsibilities ?? "Enforces safety rules, conducts regular inspections, reports hazards, and ensures compliance with the policy"
                    },
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "OutsourcedResponsibilities",
                        PropertyName = nameof(OshPolicyViewModel.OutsourcedResponsibilities),
                        Label = "Outsourced Labour Responsibilities",
                        Type = OSHManagement.Models.ViewModels.FieldType.Textarea,
                        Placeholder = "Define OSH responsibilities for outsourced labour (optional)",
                        Rows = 3,
                        HelpText = "Optional: Responsibilities for outsourced workers",
                        Value = Model?.OutsourcedResponsibilities ?? "Adheres to safety standards, reports hazards, and ensures compliance with the policy"
                    },
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "ContractorResponsibilities",
                        PropertyName = nameof(OshPolicyViewModel.ContractorResponsibilities),
                        Label = "Contractor Responsibilities",
                        Type = OSHManagement.Models.ViewModels.FieldType.Textarea,
                        Placeholder = "Define OSH responsibilities for contractors (optional)",
                        Rows = 3,
                        HelpText = "Optional: Responsibilities for contractors working at the station",
                        Value = Model?.ContractorResponsibilities ?? "Complies with safety standards, reports hazards, and ensures compliance with the policy"
                    }
                }
            },

            // ========== STEP 4: Documents & Charter ==========
            new OSHManagement.Models.ViewModels.WizardStepConfig
            {
                StepId = "documentsCharter",
                Title = "Documents & Charter",
                Icon = "ri-file-text-line",
                Description = "Upload policy documents and contractor charter",
                FieldsPerRow = 1,
                FieldColumnClass = "col-12",
                Fields = new List<OSHManagement.Models.ViewModels.FormFieldConfig>
                {
                    new OSHManagement.Models.ViewModels.FormFieldConfig
                    {
                        Name = "ContractorCharterExists",
                        PropertyName = nameof(OshPolicyViewModel.ContractorCharterExists),
                        Label = "Contractor Safety Charter Exists",
                        Type = OSHManagement.Models.ViewModels.FieldType.Checkbox,
                        HelpText = "Check if a contractor safety charter has been established",
                        CustomCssClass = "col-12"
                    }
                }
            }
        }
    };

    // Build the wizard
    var wizard = wizardConfig.BuildWizard();
}

<!-- Render Wizard -->
<div class="row">
    <div class="col-xl-12">
        <partial name="~/Views/Shared/Components/Wizards/VerticalFormWizard.cshtml" model="wizard" />
    </div>
</div>

<!-- Hidden container for documents step content -->
<div id="documentsStepContent" style="display: none;">
    <div id="documentsUploadContainer">
        <!-- Policy Document Upload Section -->
        <div class="card mb-3">
            <div class="card-header">
                <h6 class="card-title mb-0">
                    <i class="ri-file-shield-line me-2"></i>OSH Policy Document
                </h6>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">Upload the official OSH policy document (PDF, Word, or Excel format)</p>

                <!-- Dropzone UI Component (Visual Only) -->
                <div id="policyDocumentDropzone"
                     class="dropzone-ui"
                     style="min-height: 200px; border: 2px dashed #dee2e6; border-radius: 8px; background: #f8f9fa; cursor: pointer;">
                    <div class="dz-message text-center py-4">
                        <i class="ri-upload-cloud-2-line fs-1 text-primary mb-3"></i>
                        <h5>Drop policy document here or click to browse</h5>
                        <p class="text-muted mb-0">Maximum file size: <strong>10 MB</strong></p>
                        <p class="text-muted small mb-0">Allowed types: PDF, DOC, DOCX, XLS, XLSX</p>
                    </div>
                </div>

                <!-- Hidden File Input (Actual Form Input) -->
                <input type="file"
                       id="policyDocumentFileInput"
                       name="PolicyDocumentFile"
                       accept=".pdf,.doc,.docx,.xls,.xlsx"
                       style="display: none;">

                <!-- File Preview -->
                <div id="policyDocumentPreview" class="mt-3" style="display: none;">
                    <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded">
                        <div class="d-flex align-items-center">
                            <i class="ri-file-text-line fs-3 text-primary me-3"></i>
                            <div>
                                <div class="fw-medium" id="policyDocumentName"></div>
                                <small class="text-muted" id="policyDocumentSize"></small>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-danger" onclick="removePolicyDocument()">
                            <i class="ri-delete-bin-line"></i> Remove
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contractor Charter Upload Section (Conditional) -->
        <div class="card" id="charterUploadCard" style="display: none;">
            <div class="card-header bg-warning-transparent">
                <h6 class="card-title mb-0">
                    <i class="ri-file-shield-2-line me-2"></i>Contractor Safety Charter
                    <span class="badge bg-warning ms-2">Required</span>
                </h6>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">Upload the contractor safety charter document</p>

                <!-- Dropzone UI Component (Visual Only) -->
                <div id="charterDocumentDropzone"
                     class="dropzone-ui"
                     style="min-height: 200px; border: 2px dashed #dee2e6; border-radius: 8px; background: #f8f9fa; cursor: pointer;">
                    <div class="dz-message text-center py-4">
                        <i class="ri-upload-cloud-2-line fs-1 text-warning mb-3"></i>
                        <h5>Drop charter document here or click to browse</h5>
                        <p class="text-muted mb-0">Maximum file size: <strong>5 MB</strong></p>
                        <p class="text-muted small mb-0">Allowed types: PDF, DOC, DOCX</p>
                    </div>
                </div>

                <!-- Hidden File Input (Actual Form Input) -->
                <input type="file"
                       id="charterDocumentFileInput"
                       name="CharterDocumentFile"
                       accept=".pdf,.doc,.docx"
                       style="display: none;">

                <!-- File Preview -->
                <div id="charterDocumentPreview" class="mt-3" style="display: none;">
                    <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded">
                        <div class="d-flex align-items-center">
                            <i class="ri-file-text-line fs-3 text-warning me-3"></i>
                            <div>
                                <div class="fw-medium" id="charterDocumentName"></div>
                                <small class="text-muted" id="charterDocumentSize"></small>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-danger" onclick="removeCharterDocument()">
                            <i class="ri-delete-bin-line"></i> Remove
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Upload Instructions -->
        <div class="alert alert-info border-0 mt-3">
            <h6 class="alert-heading">
                <i class="ri-information-line me-2"></i>Document Upload Guidelines
            </h6>
            <ul class="mb-0 ps-3">
                <li>Policy documents should be signed by top management</li>
                <li>Ensure documents are up-to-date and reflect current practices</li>
                <li>Contractor charter is required if "Contractor Charter Exists" is checked</li>
                <li>Documents will be associated with the policy after creation</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form-wizard.js"></script>

    <script>
        $(document).ready(function() {
            console.log('OSH Policy Create Wizard Initialized');

            // Add enctype to form for file uploads
            $('#createOshPolicyWizard').attr('enctype', 'multipart/form-data');

            // Inject documents step content first
            injectDocumentsStepContent();

            // Setup drag-and-drop UI after injection (with delay to ensure DOM is ready)
            setTimeout(function() {
                setupDropzoneUI('#policyDocumentDropzone', '#policyDocumentFileInput', '#policyDocumentPreview', '#policyDocumentName', '#policyDocumentSize', 10);
                setupDropzoneUI('#charterDocumentDropzone', '#charterDocumentFileInput', '#charterDocumentPreview', '#charterDocumentName', '#charterDocumentSize', 5);
                console.log('Dropzone UI setup complete');
            }, 500);

            // Listen for HasTopManagementSignature checkbox changes
            $(document).on('change', '#createOshPolicyWizard_policySignature_HasTopManagementSignature', function() {
                toggleSignatureFields();
            });

            // Listen for ContractorCharterExists checkbox changes
            $(document).on('change', '#createOshPolicyWizard_documentsCharter_ContractorCharterExists', function() {
                toggleCharterUpload();
            });

            // Listen for StationId changes to filter employees
            $(document).on('change', '#createOshPolicyWizard_policySignature_StationId', function() {
                const stationId = $(this).val();
                if (stationId) {
                    loadEmployeesForStation(stationId);
                }
            });

            // Handle wizard navigation to setup conditional fields
            $(document).on('click', '.wizard-nav-link-vertical, .wizard-next, .wizard-prev', function(e) {
                setTimeout(function() {
                    var activeStep = $('.wizard-step.active');
                    if (activeStep.length > 0) {
                        var stepId = activeStep.attr('data-step-id');

                        if (stepId === 'policySignature') {
                            toggleSignatureFields();
                        } else if (stepId === 'documentsCharter') {
                            toggleCharterUpload();
                        }
                    }
                }, 100);
            });

            // Form submission handler - simple validation only
            // Only validate on final submit, not during wizard navigation
            $(document).on('submit', 'form', function(e) {
                // Check if this is the final submit (not wizard navigation)
                const $submitButton = $(document.activeElement);
                const isFinalSubmit = $submitButton.hasClass('wizard-submit') || $submitButton.attr('type') === 'submit';

                if (isFinalSubmit) {
                    console.log('Final form submission - validating...');
                    if (!validateForm()) {
                        e.preventDefault();
                        return false;
                    }
                    // Let form submit normally with files
                    console.log('Form validation passed, submitting with files...');
                }
            });

            // Initial field state
            toggleSignatureFields();
        });

        // ========== CONDITIONAL FIELD TOGGLING ==========
        function toggleSignatureFields() {
            const isSignedCheckbox = $('#createOshPolicyWizard_policySignature_HasTopManagementSignature');
            const isSigned = isSignedCheckbox.is(':checked');

            const dateSignedField = $('#createOshPolicyWizard_policySignature_DateSigned').closest('.mb-3');
            const signedByField = $('#createOshPolicyWizard_policySignature_SignedByPayroll').closest('.mb-3');

            if (isSigned) {
                dateSignedField.show();
                signedByField.show();
                // Make fields required
                $('#createOshPolicyWizard_policySignature_DateSigned').attr('required', 'required');
                $('#createOshPolicyWizard_policySignature_SignedByPayroll').attr('required', 'required');
            } else {
                dateSignedField.hide();
                signedByField.hide();
                // Remove required attribute
                $('#createOshPolicyWizard_policySignature_DateSigned').removeAttr('required').val('');
                $('#createOshPolicyWizard_policySignature_SignedByPayroll').removeAttr('required').val('');
            }
        }

        function toggleCharterUpload() {
            const charterExistsCheckbox = $('#createOshPolicyWizard_documentsCharter_ContractorCharterExists');
            const charterExists = charterExistsCheckbox.is(':checked');

            const charterCard = $('#charterUploadCard');

            if (charterExists) {
                charterCard.slideDown();
            } else {
                charterCard.slideUp();
                // Clear charter document if it was uploaded
                charterDocumentFile = null;
                $('#charterDocumentPreview').hide();
                $('#charterDocumentUpload').val('');
            }
        }

        // ========== DROPZONE UI SETUP (Visual Only) ==========
        function setupDropzoneUI(dropzoneSelector, fileInputSelector, previewSelector, nameSelector, sizeSelector, maxSizeMB) {
            const $dropzone = $(dropzoneSelector);
            const $fileInput = $(fileInputSelector);
            const $preview = $(previewSelector);
            const $fileName = $(nameSelector);
            const $fileSize = $(sizeSelector);

            // Check if elements exist
            if ($dropzone.length === 0) {
                console.warn('Dropzone element not found:', dropzoneSelector);
                return;
            }

            // Click on dropzone to trigger file input
            $dropzone.on('click', function(e) {
                // Only prevent default and stop propagation if clicking directly on dropzone
                // Don't interfere with button clicks
                if ($(e.target).closest('button').length === 0) {
                    e.stopPropagation();
                    $fileInput.click();
                }
            });

            // Drag and drop handlers
            $dropzone.on('dragover', function(e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).css('border-color', 'var(--primary-color)');
                $(this).css('background', '#f0f4ff');
            });

            $dropzone.on('dragleave', function(e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).css('border-color', '#dee2e6');
                $(this).css('background', '#f8f9fa');
            });

            $dropzone.on('drop', function(e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).css('border-color', '#dee2e6');
                $(this).css('background', '#f8f9fa');

                const files = e.originalEvent.dataTransfer.files;
                if (files.length > 0) {
                    // Set the file to the input
                    $fileInput[0].files = files;
                    // Trigger change event
                    $fileInput.trigger('change');
                }
            });

            // File input change handler
            $fileInput.on('change', function() {
                const file = this.files[0];
                if (file) {
                    // Validate file size
                    const fileSizeMB = file.size / (1024 * 1024);
                    if (fileSizeMB > maxSizeMB) {
                        alert(`File size (${fileSizeMB.toFixed(2)} MB) exceeds maximum allowed (${maxSizeMB} MB)`);
                        $(this).val('');
                        return;
                    }

                    // Show preview
                    $fileName.text(file.name);
                    $fileSize.text(formatFileSize(file.size));
                    $preview.slideDown();
                    $dropzone.slideUp();
                }
            });
        }

        // ========== FILE REMOVAL ==========
        window.removePolicyDocument = function() {
            $('#policyDocumentFileInput').val('');
            $('#policyDocumentPreview').slideUp();
            $('#policyDocumentDropzone').slideDown();
        };

        window.removeCharterDocument = function() {
            $('#charterDocumentFileInput').val('');
            $('#charterDocumentPreview').slideUp();
            $('#charterDocumentDropzone').slideDown();
        };

        // ========== HELPER FUNCTIONS ==========
        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
        }

        // ========== EMPLOYEE LOADING ==========
        function loadEmployeesForStation(stationId) {
            $.ajax({
                url: '/OshPolicy/GetEmployeesByStation',
                type: 'GET',
                data: { stationId: stationId },
                success: function(data) {
                    const select = $('#createOshPolicyWizard_policySignature_SignedByPayroll');
                    select.find('option:not(:first)').remove();

                    if (data && data.length > 0) {
                        data.forEach(function(emp) {
                            select.append(
                                $('<option></option>')
                                    .val(emp.payrollNo)
                                    .text(emp.fullName + ' (' + emp.payrollNo + ')')
                            );
                        });
                    } else {
                        select.append('<option value="" disabled>-- No employees found for this station --</option>');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Failed to load employees:', error);
                }
            });
        }

        // ========== FORM VALIDATION ==========
        function validateForm() {
            let isValid = true;
            const errors = [];

            // Validate signature fields if HasTopManagementSignature is checked
            const isSigned = $('#createOshPolicyWizard_policySignature_HasTopManagementSignature').is(':checked');
            if (isSigned) {
                const dateSigned = $('#createOshPolicyWizard_policySignature_DateSigned').val();
                const signedBy = $('#createOshPolicyWizard_policySignature_SignedByPayroll').val();

                if (!dateSigned) {
                    errors.push('Date Signed is required when policy is signed by management');
                    isValid = false;
                }
                if (!signedBy) {
                    errors.push('Signed By employee is required when policy is signed by management');
                    isValid = false;
                }
            }

            // Display errors
            if (!isValid) {
                alert('Validation Errors:\n\n' + errors.join('\n'));
            }

            return isValid;
        }

        // ========== INJECT CUSTOM CONTENT ==========
        function injectDocumentsStepContent() {
            const documentsStep = $('[data-step-id="documentsCharter"]');
            if (documentsStep.length > 0) {
                const stepBody = documentsStep.find('.wizard-step-body .row');

                if (stepBody.find('#documentsUploadContainer').length === 0) {
                    const content = $('#documentsStepContent').html();
                    stepBody.append('<div class="col-12">' + content + '</div>');
                    console.log('Documents step content injected successfully');
                }
            }
        }
    </script>
}
