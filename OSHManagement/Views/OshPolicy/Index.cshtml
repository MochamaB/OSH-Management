@using OSHManagement.Extensions
@model List<OSHManagement.Models.ViewModels.OshPolicyViewModel>
@{
    ViewData["Title"] = "OSH Policy Management";

    // Build stat cards
    var statConfig = new OSHManagement.Models.ViewModels.StatsRowConfig
    {
        Titles = new List<string> { "Total Policies", "Active", "Compliant", "Needs Attention" },
        Values = new List<string> {
            ViewBag.TotalPolicies.ToString(),
            ViewBag.ActivePolicies.ToString(),
            ViewBag.CompliantPolicies.ToString(),
            ViewBag.NeedsAttention.ToString()
        },
        Icons = new List<string> {
            "ri-file-shield-line",
            "ri-checkbox-circle-line",
            "ri-shield-check-line",
            "ri-alert-line"
        },
        ColorThemes = new List<string> { "primary", "success", "info", "warning" },
        CardType = OSHManagement.Models.ViewModels.CardType.LeftBorderCard
    };
    var statCards = statConfig.BuildStatsRow();

    // Build DataTable configuration
    var tableConfig = new OSHManagement.Models.ViewModels.TableConfig
    {
        TableId = "oshPoliciesTable",
        ActionUrl = "/OshPolicy/Index",
        Columns = new List<string> {
            "#",
            "Station",
            "Status",
            "Signed",
            "Implemented",
            "Last Reviewed",
            "Next Review",
            "Documents",
            "Actions"
        },
        SearchPlaceholder = "Search policies by station...",
        SearchValue = ViewBag.CurrentSearch,
        CreateButtonText = "Create Policy",
        CreateButtonUrl = "/OshPolicy/Create",
        Filters = new List<OSHManagement.Models.ViewModels.FilterConfig>
        {
            new OSHManagement.Models.ViewModels.FilterConfig
            {
                Label = "Organization Category",
                ParameterName = "categoryId",
                CurrentValue = ViewBag.CurrentCategoryId?.ToString(),
                Type = OSHManagement.Models.ViewModels.FilterType.Select,
                Options = new List<OSHManagement.Models.ViewModels.FilterOptionConfig>
                {
                    new OSHManagement.Models.ViewModels.FilterOptionConfig { Text = "All Categories", Value = "" }
                }.Concat(
                    ((IEnumerable<dynamic>)ViewBag.Categories).Select(c =>
                        new OSHManagement.Models.ViewModels.FilterOptionConfig
                        {
                            Text = c.CategoryName,
                            Value = c.OrgCategoryId.ToString()
                        }
                    )
                ).ToList()
            },
            new OSHManagement.Models.ViewModels.FilterConfig
            {
                Label = "Station",
                ParameterName = "stationId",
                CurrentValue = ViewBag.CurrentStationId?.ToString(),
                Type = OSHManagement.Models.ViewModels.FilterType.Select,
                Options = new List<OSHManagement.Models.ViewModels.FilterOptionConfig>
                {
                    new OSHManagement.Models.ViewModels.FilterOptionConfig { Text = "All Stations", Value = "" }
                }.Concat(
                    ((IEnumerable<dynamic>)ViewBag.Stations).Select(s =>
                        new OSHManagement.Models.ViewModels.FilterOptionConfig
                        {
                            Text = s.StationName,
                            Value = s.StationId.ToString()
                        }
                    )
                ).ToList()
            },
            new OSHManagement.Models.ViewModels.FilterConfig
            {
                Label = "Policy Status",
                ParameterName = "status",
                CurrentValue = ViewBag.CurrentStatus,
                Type = OSHManagement.Models.ViewModels.FilterType.Select,
                Options = new List<OSHManagement.Models.ViewModels.FilterOptionConfig>
                {
                    new OSHManagement.Models.ViewModels.FilterOptionConfig { Text = "All Statuses", Value = "" },
                    new OSHManagement.Models.ViewModels.FilterOptionConfig { Text = "Draft", Value = "Draft" },
                    new OSHManagement.Models.ViewModels.FilterOptionConfig { Text = "Active", Value = "Active" },
                    new OSHManagement.Models.ViewModels.FilterOptionConfig { Text = "Under Review", Value = "Under Review" },
                    new OSHManagement.Models.ViewModels.FilterOptionConfig { Text = "Expired", Value = "Expired" }
                }
            }
        }
    };

    // Calculate row number starting point
    int startingNumber = ((ViewBag.CurrentPage - 1) * ViewBag.PageSize) + 1;

    // Build table with row data
    var table = tableConfig.BuildTable(
        tableContent: @<text>
            @for (int i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                var rowNumber = startingNumber + i;
                <tr>
                    <td class="text-center">
                        <span class="text-muted fw-medium">@rowNumber</span>
                    </td>
                    <td>
                        <div class="fw-medium">@item.StationName</div>
                    </td>
                    <td>
                        <span class="badge @item.ComplianceStatusBadge">
                            @item.ComplianceStatusText
                        </span>
                    </td>
                    <td>
                        @if (item.HasTopManagementSignature)
                        {
                            <div class="d-flex flex-column">
                                <div class="mb-1">
                                    <i class="ri-user-line text-primary me-1"></i>
                                    <span class="fw-medium">@item.SignedByName</span>
                                </div>
                                <div>
                                    <i class="ri-calendar-line text-muted me-1"></i>
                                    <small class="text-muted">@item.FormattedDateSigned</small>
                                </div>
                            </div>
                        }
                        else
                        {
                            <span class="badge bg-warning-transparent">
                                <i class="ri-close-circle-line me-1"></i>Not Signed
                            </span>
                        }
                    </td>
                    <td>
                        @if (item.IsPolicyImplemented)
                        {
                            <span class="badge bg-success-transparent">
                                <i class="ri-check-line me-1"></i>Yes
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-transparent">
                                <i class="ri-close-line me-1"></i>No
                            </span>
                        }
                    </td>
                    <td>
                        @if (item.LastReviewedDate.HasValue)
                        {
                            <span class="text-muted">@item.LastReviewedDate.Value.ToString("MMM dd, yyyy")</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        @if (item.NextReviewDue.HasValue)
                        {
                            var isOverdue = item.NextReviewDue.Value < DateTime.UtcNow;
                            var isDueSoon = !isOverdue && (item.NextReviewDue.Value - DateTime.UtcNow).TotalDays <= 30;

                            if (isOverdue)
                            {
                                <span class="badge bg-danger-transparent">
                                    <i class="ri-alert-line me-1"></i>@item.NextReviewDue.Value.ToString("MMM dd, yyyy")
                                </span>
                            }
                            else if (isDueSoon)
                            {
                                <span class="badge bg-warning-transparent">
                                    <i class="ri-time-line me-1"></i>@item.NextReviewDue.Value.ToString("MMM dd, yyyy")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">@item.NextReviewDue.Value.ToString("MMM dd, yyyy")</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        <div class="documents-preview" data-policy-id="@item.PolicyId">
                            @if (item.PolicyDocumentCount > 0)
                            {
                                <div class="mb-1">
                                    <span class="badge bg-primary-transparent">
                                        <i class="ri-file-pdf-line me-1"></i>Policy (@item.PolicyDocumentCount)
                                    </span>
                                </div>
                            }
                            @if (item.CharterDocumentCount > 0)
                            {
                                <div class="mb-1">
                                    <span class="badge bg-info-transparent">
                                        <i class="ri-file-text-line me-1"></i>Charter (@item.CharterDocumentCount)
                                    </span>
                                </div>
                            }
                            @if (item.HasDocuments)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-primary-light view-documents-btn mt-1"
                                        data-policy-id="@item.PolicyId"
                                        data-station-name="@item.StationName"
                                        title="View All Documents">
                                    <i class="ri-eye-line me-1"></i>View All
                                </button>
                            }
                            else
                            {
                                <span class="text-muted small">
                                    <i class="ri-file-forbid-line me-1"></i>No documents
                                </span>
                            }
                        </div>
                    </td>
                    <td>
                        @{
                            var rowActions = new OSHManagement.Models.ViewModels.RowActionConfig
                            {
                                EditUrl = $"/OshPolicy/Edit/{{id}}",
                                ViewUrl = $"/OshPolicy/Details/{{id}}",
                                DeleteUrl = $"/OshPolicy/Delete/{{id}}",
                                DeleteItemName = $"Policy for {item.StationName}",
                                ShowView = true,
                                ShowEdit = true,
                                ShowDelete = false
                            };
                            var actions = OSHManagement.Extensions.DataTableExtensions.BuildRowActions(item.PolicyId, "/OshPolicy", rowActions);
                        }
                        <partial name="~/Views/Shared/Components/_ActionButtons.cshtml" model="actions" />
                    </td>
                </tr>
            }
        </text>,
        currentUrl: Context.Request.Path + Context.Request.QueryString
    );

    // Enable pagination
    table.ShowPagination = true;
    table.CurrentPage = ViewBag.CurrentPage;
    table.TotalPages = ViewBag.TotalPages;
    table.TotalRecords = ViewBag.TotalItems;
    table.PageSize = ViewBag.PageSize;
}

<!-- Stat Cards Row -->
<div class="row">
    @foreach (var card in statCards)
    {
        <partial name="~/Views/Shared/Components/StatisticCards/_LeftBorderCard.cshtml" model="card" />
    }
</div>

<!-- Main Content -->
<div class="row mt-3">
    <div class="col-xl-12">
        <partial name="~/Views/Shared/Components/_DataTable.cshtml" model="table" />
    </div>
</div>

<!-- Document List Modal -->
<div class="modal fade" id="documentViewerModal" tabindex="-1" aria-labelledby="documentViewerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="documentViewerModalLabel">
                    <i class="ri-file-list-2-line me-2"></i>Policy Documents
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="documentViewerContent">
                    <!-- Loading spinner -->
                    <div class="text-center py-5" id="documentLoader">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="text-muted mt-3">Loading documents...</p>
                    </div>

                    <!-- Documents list will be loaded here -->
                    <div id="documentsList" style="display: none;">
                        <div class="row" id="documentsGrid"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="ri-close-line me-1"></i>Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- PDF/Document Viewer Modal -->
<div class="modal fade" id="pdfViewerModal" tabindex="-1" aria-labelledby="pdfViewerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="pdfViewerModalLabel">
                    <i class="ri-file-pdf-line me-2"></i>Document Viewer
                </h6>
                <div class="btn-group btn-group-sm me-3">
                    <a id="pdfDownloadBtn" href="#" class="btn btn-primary" download>
                        <i class="ri-download-2-line me-1"></i>Download
                    </a>
                    <a id="pdfOpenNewTabBtn" href="#" target="_blank" class="btn btn-info">
                        <i class="ri-external-link-line me-1"></i>Open in New Tab
                    </a>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" style="height: calc(100vh - 120px);">
                <div id="pdfViewerContent" class="w-100 h-100">
                    <!-- Loading spinner -->
                    <div class="text-center py-5" id="pdfLoader" style="display: none;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="text-muted mt-3">Loading document...</p>
                    </div>
                    
                    <!-- PDF/Document iframe -->
                    <iframe id="pdfIframe" 
                            style="width: 100%; height: 100%; border: none;"
                            title="Document Viewer">
                    </iframe>
                    
                    <!-- Unsupported file type message -->
                    <div id="unsupportedFileMessage" class="alert alert-warning m-4" style="display: none;">
                        <div class="d-flex align-items-center">
                            <i class="ri-information-line fs-4 me-3"></i>
                            <div>
                                <h6 class="alert-heading mb-2">Preview Not Available</h6>
                                <p class="mb-2">This file type cannot be previewed in the browser.</p>
                                <p class="mb-0">
                                    <a id="unsupportedDownloadBtn" href="#" class="btn btn-sm btn-primary">
                                        <i class="ri-download-line me-1"></i>Download File
                                    </a>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Store all stations with their categories
            var allStations = @Html.Raw(Json.Serialize(ViewBag.Stations));
            var categorySelect = $('select[name="categoryId"]');
            var stationSelect = $('select[name="stationId"]');
            var currentStationId = '@(ViewBag.CurrentStationId?.ToString() ?? "")';

            // Function to filter stations based on selected category
            function filterStations() {
                var selectedCategoryId = categorySelect.val();

                // Store current selection
                var currentSelection = stationSelect.val();

                // Clear all options except the first (placeholder)
                stationSelect.find('option:not(:first)').remove();

                // Filter stations
                var filteredStations = selectedCategoryId
                    ? allStations.filter(s => s.orgCategoryId == selectedCategoryId)
                    : allStations;

                // Repopulate station dropdown
                filteredStations.forEach(function(station) {
                    var option = $('<option></option>')
                        .val(station.stationId)
                        .text(station.stationName);

                    // Restore selection if it's still valid
                    if (station.stationId == currentSelection || station.stationId == currentStationId) {
                        option.prop('selected', true);
                    }

                    stationSelect.append(option);
                });

                // If current selection is not in filtered list, clear it
                if (selectedCategoryId && stationSelect.val() != currentSelection) {
                    stationSelect.val('');
                }
            }

            // Initialize on page load
            if (categorySelect.val()) {
                filterStations();
            }

            // Handle category change
            categorySelect.on('change', function() {
                filterStations();
                // Auto-submit the form to apply filter
                $(this).closest('form').submit();
            });

            // ========================================
            // Document Viewer Modal
            // ========================================

            // Handle view documents button click
            $(document).on('click', '.view-documents-btn', function() {
                var policyId = $(this).data('policy-id');
                var stationName = $(this).data('station-name');

                // Update modal title
                $('#documentViewerModalLabel').html(
                    '<i class="ri-file-list-2-line me-2"></i>Policy Documents - ' + stationName
                );

                // Show loading state
                $('#documentLoader').show();
                $('#documentsList').hide();
                $('#documentsGrid').empty();

                // Open modal
                var modal = new bootstrap.Modal(document.getElementById('documentViewerModal'));
                modal.show();

                // Fetch documents via AJAX
                $.ajax({
                    url: '/OshPolicy/GetPolicyDocuments',
                    type: 'GET',
                    data: { policyId: policyId },
                    success: function(response) {
                        if (response.success && response.documents && response.documents.length > 0) {
                            renderDocuments(response.documents);
                        } else {
                            showNoDocuments();
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error fetching documents:', error);
                        showErrorMessage();
                    }
                });
            });

            // Render documents in the modal
            function renderDocuments(documents) {
                var grid = $('#documentsGrid');
                grid.empty();

                documents.forEach(function(doc) {
                    var fileIcon = getFileIcon(doc.fileExtension);
                    var fileTypeClass = getFileTypeClass(doc.fileExtension);
                    var associationTypeLabel = doc.associationType === 'policy_document'
                        ? '<span class="badge bg-primary-transparent">Policy Document</span>'
                        : '<span class="badge bg-info-transparent">Safety Charter</span>';

                    var cardHtml = `
                        <div class="col-md-6 col-lg-4 mb-3">
                            <div class="card custom-card border">
                                <div class="card-body">
                                    <div class="d-flex align-items-start mb-3">
                                        <div class="avatar avatar-lg bg-${fileTypeClass}-transparent me-3">
                                            <i class="${fileIcon} fs-24"></i>
                                        </div>
                                        <div class="flex-fill">
                                            <h6 class="fw-semibold mb-1 text-truncate" title="${doc.originalFileName}">
                                                ${doc.originalFileName}
                                            </h6>
                                            <div class="mb-2">
                                                ${associationTypeLabel}
                                            </div>
                                            <small class="text-muted">
                                                <i class="ri-file-line me-1"></i>${formatFileSize(doc.fileSize)}
                                            </small>
                                        </div>
                                    </div>

                                    ${doc.title ? `<p class="text-muted mb-2"><strong>Title:</strong> ${doc.title}</p>` : ''}
                                    ${doc.description ? `<p class="text-muted mb-2 small">${doc.description}</p>` : ''}

                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                        <small class="text-muted">
                                            <i class="ri-calendar-line me-1"></i>${formatDate(doc.uploadedAt)}
                                        </small>
                                        <div class="btn-group btn-group-sm">
                                            <button type="button"
                                                    class="btn btn-info-light btn-sm view-pdf-btn"
                                                    data-media-id="${doc.mediaId}"
                                                    data-file-name="${doc.originalFileName}"
                                                    data-file-ext="${doc.fileExtension}"
                                                    title="Preview">
                                                <i class="ri-eye-line"></i>
                                            </button>
                                            <a href="/Media/Download/${doc.mediaId}"
                                               class="btn btn-primary-light btn-sm"
                                               title="Download">
                                                <i class="ri-download-2-line"></i>
                                            </a>
                                            <a href="/Media/View/${doc.mediaId}"
                                               target="_blank"
                                               class="btn btn-secondary-light btn-sm"
                                               title="Open in New Tab">
                                                <i class="ri-external-link-line"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;

                    grid.append(cardHtml);
                });

                // Show documents list
                $('#documentLoader').hide();
                $('#documentsList').show();
            }

            // Show no documents message
            function showNoDocuments() {
                $('#documentsGrid').html(`
                    <div class="col-12">
                        <div class="alert alert-warning text-center">
                            <i class="ri-file-forbid-line fs-24 mb-2"></i>
                            <p class="mb-0">No documents found for this policy.</p>
                        </div>
                    </div>
                `);
                $('#documentLoader').hide();
                $('#documentsList').show();
            }

            // Show error message
            function showErrorMessage() {
                $('#documentsGrid').html(`
                    <div class="col-12">
                        <div class="alert alert-danger text-center">
                            <i class="ri-error-warning-line fs-24 mb-2"></i>
                            <p class="mb-0">Error loading documents. Please try again.</p>
                        </div>
                    </div>
                `);
                $('#documentLoader').hide();
                $('#documentsList').show();
            }

            // Helper: Get file icon based on extension
            function getFileIcon(extension) {
                const icons = {
                    '.pdf': 'ri-file-pdf-line',
                    '.doc': 'ri-file-word-line',
                    '.docx': 'ri-file-word-line',
                    '.xls': 'ri-file-excel-line',
                    '.xlsx': 'ri-file-excel-line',
                    '.ppt': 'ri-file-ppt-line',
                    '.pptx': 'ri-file-ppt-line',
                    '.jpg': 'ri-image-line',
                    '.jpeg': 'ri-image-line',
                    '.png': 'ri-image-line',
                    '.gif': 'ri-image-line'
                };
                return icons[extension.toLowerCase()] || 'ri-file-line';
            }

            // Helper: Get file type class for coloring
            function getFileTypeClass(extension) {
                const classes = {
                    '.pdf': 'danger',
                    '.doc': 'primary',
                    '.docx': 'primary',
                    '.xls': 'success',
                    '.xlsx': 'success',
                    '.ppt': 'warning',
                    '.pptx': 'warning',
                    '.jpg': 'info',
                    '.jpeg': 'info',
                    '.png': 'info',
                    '.gif': 'info'
                };
                return classes[extension.toLowerCase()] || 'secondary';
            }

            // Helper: Format file size
            function formatFileSize(bytes) {
                if (bytes === 0) return '0 Bytes';
                const k = 1024;
                const sizes = ['Bytes', 'KB', 'MB', 'GB'];
                const i = Math.floor(Math.log(bytes) / Math.log(k));
                return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
            }

            // Helper: Format date
            function formatDate(dateString) {
                if (!dateString) return 'N/A';
                const date = new Date(dateString);
                const options = { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' };
                return date.toLocaleDateString('en-US', options);
            }

            // ========================================
            // PDF/Document Viewer
            // ========================================

            // Handle view PDF button click
            $(document).on('click', '.view-pdf-btn', function() {
                const mediaId = $(this).data('media-id');
                const fileName = $(this).data('file-name');
                const fileExt = $(this).data('file-ext');

                openDocumentViewer(mediaId, fileName, fileExt);
            });

            // Open document in fullscreen viewer modal
            function openDocumentViewer(mediaId, fileName, fileExtension) {
                // Update modal title
                $('#pdfViewerModalLabel').html(
                    `<i class="ri-file-pdf-line me-2"></i>${fileName}`
                );

                // Set download and open buttons
                const viewUrl = `/Media/View/${mediaId}`;
                const downloadUrl = `/Media/Download/${mediaId}`;

                $('#pdfDownloadBtn').attr('href', downloadUrl);
                $('#pdfOpenNewTabBtn').attr('href', viewUrl);

                // Check if file type can be previewed
                const previewableExtensions = ['.pdf', '.txt', '.jpg', '.jpeg', '.png', '.gif', '.svg'];
                const canPreview = previewableExtensions.includes(fileExtension.toLowerCase());

                if (canPreview) {
                    // Show iframe, hide unsupported message
                    $('#pdfIframe').show();
                    $('#unsupportedFileMessage').hide();

                    // Show loading
                    $('#pdfLoader').show();

                    // Load document in iframe
                    const iframe = document.getElementById('pdfIframe');
                    iframe.src = viewUrl;

                    // Hide loading when iframe loads
                    iframe.onload = function() {
                        $('#pdfLoader').hide();
                    };
                } else {
                    // Show unsupported message, hide iframe
                    $('#pdfIframe').hide();
                    $('#unsupportedFileMessage').show();
                    $('#unsupportedDownloadBtn').attr('href', downloadUrl);
                }

                // Open modal
                const pdfModal = new bootstrap.Modal(document.getElementById('pdfViewerModal'));
                pdfModal.show();
            }

            // Reset PDF viewer when modal is closed
            $('#pdfViewerModal').on('hidden.bs.modal', function() {
                document.getElementById('pdfIframe').src = '';
                $('#pdfLoader').hide();
            });
        });
    </script>
}
