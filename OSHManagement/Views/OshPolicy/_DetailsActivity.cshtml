@model OSHManagement.Models.ViewModels.OshPolicyViewModel

<div class="p-3">
    <!-- Basic Activity Timeline -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card custom-card border">
                <div class="card-header">
                    <h6 class="card-title mb-0">
                        <i class="ri-history-line me-2"></i>Policy Timeline
                    </h6>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <!-- Current Status -->
                        <div class="timeline-item">
                            <div class="timeline-badge bg-primary">
                                <i class="ri-information-line"></i>
                            </div>
                            <div class="timeline-content">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="mb-1">Current Status</h6>
                                        <p class="text-muted mb-1">Policy is currently <strong>@(Model.PolicyStatus ?? "Draft")</strong></p>
                                        @if (Model.UpdatedAt.HasValue)
                                        {
                                            <small class="text-muted">
                                                <i class="ri-time-line me-1"></i>Last updated: @Model.UpdatedAt.Value.ToString("MMM dd, yyyy, hh:mm tt")
                                            </small>
                                        }
                                    </div>
                                    <span class="badge bg-primary-transparent">Recent</span>
                                </div>
                            </div>
                        </div>

                        <!-- Last Review -->
                        @if (Model.LastReviewedDate.HasValue)
                        {
                            <div class="timeline-item">
                                <div class="timeline-badge bg-success">
                                    <i class="ri-eye-line"></i>
                                </div>
                                <div class="timeline-content">
                                    <h6 class="mb-1">Policy Reviewed</h6>
                                    <p class="text-muted mb-1">Annual review completed</p>
                                    <small class="text-muted">
                                        <i class="ri-calendar-line me-1"></i>@Model.LastReviewedDate.Value.ToString("MMM dd, yyyy")
                                    </small>
                                </div>
                            </div>
                        }

                        <!-- Signature Event -->
                        @if (Model.HasTopManagementSignature && Model.DateSigned.HasValue)
                        {
                            <div class="timeline-item">
                                <div class="timeline-badge bg-info">
                                    <i class="ri-quill-pen-line"></i>
                                </div>
                                <div class="timeline-content">
                                    <h6 class="mb-1">Policy Signed</h6>
                                    <p class="text-muted mb-1">Signed by <strong>@Model.SignedByName</strong></p>
                                    <small class="text-muted">
                                        <i class="ri-calendar-line me-1"></i>@Model.DateSigned.Value.ToString("MMM dd, yyyy")
                                    </small>
                                </div>
                            </div>
                        }

                        <!-- Implementation -->
                        @if (Model.IsPolicyImplemented)
                        {
                            <div class="timeline-item">
                                <div class="timeline-badge bg-warning">
                                    <i class="ri-checkbox-circle-line"></i>
                                </div>
                                <div class="timeline-content">
                                    <h6 class="mb-1">Implementation Started</h6>
                                    <p class="text-muted mb-1">Policy actively being implemented at station</p>
                                </div>
                            </div>
                        }

                        <!-- Policy Created -->
                        <div class="timeline-item">
                            <div class="timeline-badge bg-secondary">
                                <i class="ri-file-add-line"></i>
                            </div>
                            <div class="timeline-content">
                                <h6 class="mb-1">Policy Created</h6>
                                <p class="text-muted mb-1">OSH Policy created for @Model.StationName</p>
                                <small class="text-muted">
                                    <i class="ri-calendar-line me-1"></i>@Model.CreatedAt.ToString("MMM dd, yyyy, hh:mm tt")
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card custom-card border">
                <div class="card-body text-center">
                    <div class="avatar avatar-lg bg-primary-transparent mx-auto mb-3">
                        <i class="ri-calendar-line fs-24"></i>
                    </div>
                    <h6 class="mb-1">Age</h6>
                    <h4 class="mb-0 text-primary">@((DateTime.UtcNow - Model.CreatedAt).Days) days</h4>
                    <small class="text-muted">Since creation</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card custom-card border">
                <div class="card-body text-center">
                    <div class="avatar avatar-lg bg-success-transparent mx-auto mb-3">
                        <i class="ri-refresh-line fs-24"></i>
                    </div>
                    <h6 class="mb-1">Last Modified</h6>
                    <h4 class="mb-0 text-success">
                        @if (Model.UpdatedAt.HasValue)
                        {
                            @((DateTime.UtcNow - Model.UpdatedAt.Value).Days) 
                        }
                        else
                        {
                            @((DateTime.UtcNow - Model.CreatedAt).Days)
                        }
                        days
                    </h4>
                    <small class="text-muted">Days ago</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card custom-card border">
                <div class="card-body text-center">
                    <div class="avatar avatar-lg bg-warning-transparent mx-auto mb-3">
                        <i class="ri-eye-line fs-24"></i>
                    </div>
                    <h6 class="mb-1">Last Review</h6>
                    <h4 class="mb-0 text-warning">
                        @if (Model.LastReviewedDate.HasValue)
                        {
                            @((DateTime.UtcNow - Model.LastReviewedDate.Value).Days)
                        }
                        else
                        {
                            <span class="fs-18">—</span>
                        }
                    </h4>
                    <small class="text-muted">@(Model.LastReviewedDate.HasValue ? "Days ago" : "Never reviewed")</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Enhanced Activity Logging (Phase 3 Preview) -->
    <div class="row">
        <div class="col-12">
            <div class="card custom-card border-dashed">
                <div class="card-body text-center py-5">
                    <img src="~/assets/images/vectors/audit.png" 
                         alt="Activity Log" 
                         class="img-fluid mb-4" 
                         style="max-width: 300px; opacity: 0.7;" />
                    <h5 class="mb-3">Detailed Activity Logging</h5>
                    <p class="text-muted mb-4" style="max-width: 700px; margin: 0 auto;">
                        <strong>Enhanced in Future Updates:</strong> Complete audit trail with detailed change history,
                        user actions, field-level modifications, and document upload/download tracking.
                    </p>
                    
                    <div class="row g-3 justify-content-center">
                        <div class="col-md-3">
                            <div class="text-center">
                                <div class="avatar avatar-md bg-primary-transparent mx-auto mb-2">
                                    <i class="ri-pencil-line fs-20"></i>
                                </div>
                                <h6 class="mb-1 fs-14">Change History</h6>
                                <small class="text-muted">Track all field modifications</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center">
                                <div class="avatar avatar-md bg-info-transparent mx-auto mb-2">
                                    <i class="ri-user-line fs-20"></i>
                                </div>
                                <h6 class="mb-1 fs-14">User Actions</h6>
                                <small class="text-muted">Who did what and when</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center">
                                <div class="avatar avatar-md bg-success-transparent mx-auto mb-2">
                                    <i class="ri-file-line fs-20"></i>
                                </div>
                                <h6 class="mb-1 fs-14">Document Activity</h6>
                                <small class="text-muted">Uploads and downloads log</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center">
                                <div class="avatar avatar-md bg-warning-transparent mx-auto mb-2">
                                    <i class="ri-notification-line fs-20"></i>
                                </div>
                                <h6 class="mb-1 fs-14">Notifications Sent</h6>
                                <small class="text-muted">Reminder and alert history</small>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info mt-4 d-inline-block">
                        <i class="ri-information-line me-2"></i>
                        This timeline shows major policy events. Detailed activity logging with full audit trail is planned for future updates.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .timeline {
            position: relative;
            padding: 0;
            list-style: none;
        }
        .timeline:before {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            width: 2px;
            background: #e9ecef;
            left: 15px;
        }
        .timeline-item {
            position: relative;
            padding-left: 50px;
            margin-bottom: 25px;
        }
        .timeline-item:last-child {
            margin-bottom: 0;
        }
        .timeline-badge {
            position: absolute;
            left: 0;
            top: 0;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            z-index: 1;
            box-shadow: 0 0 0 3px #fff;
        }
        .timeline-content {
            padding: 15px;
            background: #f8f9fa;
            border-radius: 6px;
            border-left: 3px solid #e9ecef;
        }
    </style>
}
